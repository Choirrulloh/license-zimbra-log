<!DOCTYPE html>
<html>
<head>
  <title>Create Email Template - License Manager</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-100">
  <div class="flex h-screen overflow-hidden">
    <%- include('../../partials/sidebar', { currentPage: 'settings', user: user }) %>

    <div class="flex-1 flex flex-col overflow-hidden">
      <header class="bg-white shadow-sm">
        <div class="flex items-center justify-between p-4">
          <div>
            <h2 class="text-xl font-semibold text-gray-800">Create Email Template</h2>
            <nav class="text-sm text-gray-600 mt-1">
              <a href="/settings" class="hover:text-gray-800">Settings</a> /
              <a href="/settings/email-templates" class="hover:text-gray-800">Email Templates</a> /
              Create
            </nav>
          </div>
          <a href="/settings/email-templates" class="text-gray-600 hover:text-gray-800"><i class="fas fa-arrow-left"></i> Back</a>
        </div>
      </header>

      <main class="flex-1 overflow-y-auto p-6">
        <div class="max-w-5xl mx-auto">
          <!-- Header Card with Gradient -->
          <div class="bg-gradient-to-r from-blue-500 to-blue-600 text-white rounded-lg shadow-lg p-6 mb-6">
            <div class="flex items-center space-x-4">
              <div class="w-16 h-16 bg-white bg-opacity-20 rounded-lg flex items-center justify-center">
                <i class="fas fa-plus-circle text-4xl"></i>
              </div>
              <div>
                <h2 class="text-2xl font-bold">Create New Email Template</h2>
                <p class="text-blue-100 text-sm mt-1">
                  Add a new email template variant with custom language and design
                </p>
              </div>
            </div>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Left: Form -->
            <div class="lg:col-span-2">
              <div class="bg-white rounded-lg shadow">
                <% if (error) { %>
                  <div class="bg-red-100 border-l-4 border-red-500 text-red-700 px-4 py-3 m-4 rounded">
                    <div class="flex items-center">
                      <i class="fas fa-exclamation-triangle mr-2"></i>
                      <span><%= error %></span>
                    </div>
                  </div>
                <% } %>

                <form method="POST" action="/settings/email-templates/create" class="p-6">
                  <!-- Template Identity -->
                  <div class="mb-6">
                    <h3 class="text-lg font-semibold text-gray-800 mb-4 flex items-center">
                      <i class="fas fa-tag text-blue-500 mr-2"></i>
                      Template Identity
                    </h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                      <div>
                        <label class="block text-gray-700 text-sm font-medium mb-2">
                          Template Name *
                        </label>
                        <input
                          type="text"
                          name="name"
                          list="template-names"
                          required
                          placeholder="Select existing or type new name"
                          class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                        >
                        <datalist id="template-names">
                          <% if (existingTemplates && existingTemplates.length > 0) { %>
                            <% existingTemplates.forEach(tmpl => { %>
                              <option value="<%= tmpl.name %>"><%= tmpl.name.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase()) %> (<%= tmpl.type %>)</option>
                            <% }); %>
                          <% } %>
                          <option value="welcome_email">Welcome Email</option>
                          <option value="password_reset">Password Reset</option>
                          <option value="license_created">License Created</option>
                          <option value="license_expiring">License Expiring</option>
                          <option value="license_expired">License Expired</option>
                          <option value="license_renewed">License Renewed</option>
                          <option value="role_changed">Role Changed</option>
                          <option value="monthly_report">Monthly Report</option>
                        </datalist>
                        <p class="text-xs text-gray-500 mt-1">
                          <i class="fas fa-info-circle"></i> Select from existing or create new (lowercase with underscores)
                        </p>
                      </div>

                      <div>
                        <label class="block text-gray-700 text-sm font-medium mb-2">
                          Type *
                        </label>
                        <select
                          name="type"
                          required
                          class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                        >
                          <option value="">Select type...</option>
                          <option value="user">👤 User</option>
                          <option value="license">🔑 License</option>
                          <option value="system">⚙️ System</option>
                        </select>
                      </div>

                      <div>
                        <label class="block text-gray-700 text-sm font-medium mb-2">
                          Language *
                        </label>
                        <select
                          name="language"
                          required
                          class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                        >
                          <option value="">Select language...</option>
                          <option value="en">🇬🇧 English (EN)</option>
                          <option value="id">🇮🇩 Indonesian (ID)</option>
                        </select>
                      </div>

                      <div>
                        <label class="block text-gray-700 text-sm font-medium mb-2">
                          Design Variation *
                        </label>
                        <select
                          name="design_variation"
                          required
                          class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                        >
                          <option value="">Select variation...</option>
                          <option value="1">Design 1 (Formal)</option>
                          <option value="2">Design 2 (Modern)</option>
                        </select>
                      </div>
                    </div>
                  </div>

                  <div class="border-t pt-6 mb-6">
                    <h3 class="text-lg font-semibold text-gray-800 mb-4 flex items-center">
                      <i class="fas fa-envelope text-blue-500 mr-2"></i>
                      Email Content
                    </h3>

                    <div class="mb-4">
                      <label class="block text-gray-700 text-sm font-medium mb-2">
                        Subject Line *
                      </label>
                      <input
                        type="text"
                        name="subject"
                        required
                        placeholder="Welcome to {{company.name}}"
                        class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                      >
                      <p class="text-xs text-gray-500 mt-1">
                        <i class="fas fa-magic"></i> Use {{variable}} for dynamic content
                      </p>
                    </div>

                    <div class="mb-4">
                      <label class="block text-gray-700 text-sm font-medium mb-2">
                        Available Variables
                      </label>
                      <input
                        type="text"
                        name="variables"
                        placeholder="user.name, user.email, company.name, license.key"
                        class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                      >
                      <p class="text-xs text-gray-500 mt-1">
                        <i class="fas fa-list"></i> Comma-separated list of variables used in template
                      </p>
                    </div>

                    <div class="mb-4">
                      <label class="block text-gray-700 text-sm font-medium mb-2 flex items-center justify-between">
                        <span>HTML Body *</span>
                        <span class="text-xs text-gray-500 font-normal">
                          <i class="fas fa-code"></i> Full HTML template
                        </span>
                      </label>
                      <textarea
                        name="body_html"
                        required
                        rows="14"
                        placeholder="<!DOCTYPE html><html>..."
                        class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 font-mono text-sm"
                      ></textarea>
                    </div>

                    <div class="mb-4">
                      <label class="block text-gray-700 text-sm font-medium mb-2 flex items-center justify-between">
                        <span>Plain Text Body</span>
                        <span class="text-xs text-gray-500 font-normal">
                          <i class="fas fa-font"></i> Fallback for non-HTML clients
                        </span>
                      </label>
                      <textarea
                        name="body_text"
                        rows="6"
                        placeholder="Welcome! Your account: {{user.email}}"
                        class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                      ></textarea>
                    </div>
                  </div>

                  <div class="border-t pt-6">
                    <div class="flex space-x-3">
                      <button
                        type="submit"
                        class="flex-1 bg-blue-500 hover:bg-blue-600 text-white px-6 py-3 rounded-lg font-medium transition-all"
                      >
                        <i class="fas fa-save mr-2"></i> Create Template
                      </button>
                      <a
                        href="/settings/email-templates"
                        class="flex-1 bg-gray-200 hover:bg-gray-300 text-gray-800 px-6 py-3 rounded-lg text-center font-medium transition-all"
                      >
                        <i class="fas fa-times mr-2"></i> Cancel
                      </a>
                    </div>
                  </div>
                </form>
              </div>
            </div>

            <!-- Right: Helper Sidebar -->
            <div class="lg:col-span-1 space-y-4">
              <!-- Existing Templates -->
              <% if (existingTemplates && existingTemplates.length > 0) { %>
                <div class="bg-yellow-50 border border-yellow-300 rounded-lg p-4">
                  <h4 class="font-semibold text-yellow-900 mb-3 flex items-center">
                    <i class="fas fa-list mr-2"></i>
                    Existing Templates
                  </h4>
                  <p class="text-xs text-yellow-800 mb-3">
                    Select one to add a new variant (language/design):
                  </p>
                  <div class="space-y-1 max-h-48 overflow-y-auto">
                    <% existingTemplates.forEach(tmpl => { %>
                      <div class="bg-white bg-opacity-60 rounded px-2 py-1.5 text-xs flex items-center justify-between hover:bg-opacity-100 transition-all cursor-pointer" onclick="document.querySelector('input[name=name]').value='<%= tmpl.name %>'; document.querySelector('select[name=type]').value='<%= tmpl.type %>';">
                        <span class="font-mono text-yellow-900">
                          <%= tmpl.name %>
                        </span>
                        <span class="text-xs px-1.5 py-0.5 rounded <%= tmpl.type === 'user' ? 'bg-blue-100 text-blue-700' : tmpl.type === 'license' ? 'bg-purple-100 text-purple-700' : 'bg-gray-100 text-gray-700' %>">
                          <%= tmpl.type %>
                        </span>
                      </div>
                    <% }); %>
                  </div>
                  <p class="text-xs text-yellow-700 mt-2">
                    <i class="fas fa-hand-pointer"></i> Click to auto-fill
                  </p>
                </div>
              <% } %>

              <!-- Quick Tips -->
              <div class="bg-blue-50 border border-blue-200 rounded-lg p-4">
                <h4 class="font-semibold text-blue-900 mb-3 flex items-center">
                  <i class="fas fa-lightbulb mr-2"></i>
                  Quick Tips
                </h4>
                <ul class="text-sm text-blue-800 space-y-2">
                  <li class="flex items-start">
                    <i class="fas fa-check text-blue-600 mr-2 mt-0.5"></i>
                    <span>Each template needs unique combination of name, language, and design</span>
                  </li>
                  <li class="flex items-start">
                    <i class="fas fa-check text-blue-600 mr-2 mt-0.5"></i>
                    <span>To add variant: Select existing template, choose different language/design</span>
                  </li>
                  <li class="flex items-start">
                    <i class="fas fa-check text-blue-600 mr-2 mt-0.5"></i>
                    <span>Set one variant as default after creation</span>
                  </li>
                </ul>
              </div>

              <!-- Common Variables -->
              <div class="bg-purple-50 border border-purple-200 rounded-lg p-4">
                <h4 class="font-semibold text-purple-900 mb-3 flex items-center">
                  <i class="fas fa-code mr-2"></i>
                  Common Variables
                </h4>
                <div class="text-sm text-purple-800 space-y-2">
                  <div class="bg-white bg-opacity-60 rounded px-2 py-1 font-mono text-xs">
                    {{user.name}}
                  </div>
                  <div class="bg-white bg-opacity-60 rounded px-2 py-1 font-mono text-xs">
                    {{user.email}}
                  </div>
                  <div class="bg-white bg-opacity-60 rounded px-2 py-1 font-mono text-xs">
                    {{company.name}}
                  </div>
                  <div class="bg-white bg-opacity-60 rounded px-2 py-1 font-mono text-xs">
                    {{license.key}}
                  </div>
                  <div class="bg-white bg-opacity-60 rounded px-2 py-1 font-mono text-xs">
                    {{license.expiry}}
                  </div>
                </div>
              </div>

              <!-- Template Types -->
              <div class="bg-green-50 border border-green-200 rounded-lg p-4">
                <h4 class="font-semibold text-green-900 mb-3 flex items-center">
                  <i class="fas fa-info-circle mr-2"></i>
                  Template Types
                </h4>
                <ul class="text-sm text-green-800 space-y-2">
                  <li>
                    <strong>User:</strong> Registration, login, password reset
                  </li>
                  <li>
                    <strong>License:</strong> Creation, renewal, expiration
                  </li>
                  <li>
                    <strong>System:</strong> Reports, notifications
                  </li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </main>
    </div>
  </div>
</body>
</html>
