<!DOCTYPE html>
<html>
<head>
  <title>Create Email Template - License Manager</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-100">
  <div class="flex h-screen overflow-hidden">
    <aside class="w-64 bg-gray-800 text-white flex-shrink-0">
      <div class="p-4">
        <h1 class="text-2xl font-bold mb-8"><i class="fas fa-key"></i> License Manager</h1>
        <nav class="space-y-2">
          <a href="/dashboard" class="flex items-center space-x-3 p-3 rounded hover:bg-gray-700"><i class="fas fa-chart-line w-5"></i><span>Dashboard</span></a>
          <a href="/products" class="flex items-center space-x-3 p-3 rounded hover:bg-gray-700"><i class="fas fa-box w-5"></i><span>Products</span></a>
          <a href="/customers" class="flex items-center space-x-3 p-3 rounded hover:bg-gray-700"><i class="fas fa-users w-5"></i><span>Customers</span></a>
          <a href="/licenses" class="flex items-center space-x-3 p-3 rounded hover:bg-gray-700"><i class="fas fa-certificate w-5"></i><span>Licenses</span></a>
          <a href="/features" class="flex items-center space-x-3 p-3 rounded hover:bg-gray-700"><i class="fas fa-puzzle-piece w-5"></i><span>Features</span></a>
          <a href="/users" class="flex items-center space-x-3 p-3 rounded hover:bg-gray-700"><i class="fas fa-user-shield w-5"></i><span>Users</span></a>
          <a href="/roles" class="flex items-center space-x-3 p-3 rounded hover:bg-gray-700"><i class="fas fa-user-tag w-5"></i><span>Roles & Permissions</span></a>
          <a href="/reports" class="flex items-center space-x-3 p-3 rounded hover:bg-gray-700"><i class="fas fa-file-alt w-5"></i><span>Reports</span></a>
          <a href="/docs" class="flex items-center space-x-3 p-3 rounded hover:bg-gray-700"><i class="fas fa-book w-5"></i><span>API Docs</span></a>
          <a href="/settings" class="flex items-center space-x-3 p-3 rounded bg-gray-700"><i class="fas fa-cog w-5"></i><span>Settings</span></a>
        </nav>
      </div>
      <div class="absolute bottom-0 w-64 p-4 bg-gray-900">
        <div class="flex items-center space-x-3">
          <div class="w-10 h-10 rounded-full bg-gray-700 flex items-center justify-center"><i class="fas fa-user"></i></div>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-medium truncate"><%= user.userName || 'Admin' %></p>
            <p class="text-xs text-gray-400 truncate"><%= user.userEmail || '' %></p>
          </div>
          <a href="/logout" class="text-gray-400 hover:text-white"><i class="fas fa-sign-out-alt"></i></a>
        </div>
      </div>
    </aside>

    <div class="flex-1 flex flex-col overflow-hidden">
      <header class="bg-white shadow-sm">
        <div class="flex items-center justify-between p-4">
          <div>
            <h2 class="text-xl font-semibold text-gray-800">Create Email Template</h2>
            <nav class="text-sm text-gray-600 mt-1">
              <a href="/settings" class="hover:text-gray-800">Settings</a> /
              <a href="/settings/email-templates" class="hover:text-gray-800">Email Templates</a> /
              Create
            </nav>
          </div>
          <a href="/settings/email-templates" class="text-gray-600 hover:text-gray-800"><i class="fas fa-arrow-left"></i> Back</a>
        </div>
      </header>

      <main class="flex-1 overflow-y-auto p-6">
        <div class="max-w-4xl mx-auto">
          <div class="bg-white rounded-lg shadow p-6">
            <% if (error) { %>
              <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
                <%= error %>
              </div>
            <% } %>

            <form method="POST" action="/settings/email-templates/create">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                <div>
                  <label class="block text-gray-700 text-sm font-medium mb-2">Template Name *</label>
                  <input type="text" name="name" required placeholder="e.g., welcome_email" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-blue-500">
                  <p class="text-xs text-gray-500 mt-1">Use underscores, lowercase only</p>
                </div>

                <div>
                  <label class="block text-gray-700 text-sm font-medium mb-2">Type *</label>
                  <select name="type" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-blue-500">
                    <option value="">Select type...</option>
                    <option value="user">User</option>
                    <option value="license">License</option>
                    <option value="system">System</option>
                  </select>
                </div>

                <div>
                  <label class="block text-gray-700 text-sm font-medium mb-2">Language *</label>
                  <select name="language" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-blue-500">
                    <option value="">Select language...</option>
                    <option value="en">English (EN)</option>
                    <option value="id">Indonesian (ID)</option>
                  </select>
                </div>

                <div>
                  <label class="block text-gray-700 text-sm font-medium mb-2">Design Variation *</label>
                  <select name="design_variation" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-blue-500">
                    <option value="">Select variation...</option>
                    <option value="1">Version 1</option>
                    <option value="2">Version 2</option>
                  </select>
                </div>
              </div>

              <div class="mb-4">
                <label class="block text-gray-700 text-sm font-medium mb-2">Subject *</label>
                <input type="text" name="subject" required placeholder="Welcome to {{company.name}}" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-blue-500">
                <p class="text-xs text-gray-500 mt-1">Use {{variable}} for dynamic content</p>
              </div>

              <div class="mb-4">
                <label class="block text-gray-700 text-sm font-medium mb-2">Variables (comma-separated)</label>
                <input type="text" name="variables" placeholder="user.name, user.email, company.name" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-blue-500">
                <p class="text-xs text-gray-500 mt-1">List all variables used in this template</p>
              </div>

              <div class="mb-4">
                <label class="block text-gray-700 text-sm font-medium mb-2">HTML Body *</label>
                <textarea name="body_html" required rows="12" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-blue-500 font-mono text-sm"></textarea>
                <p class="text-xs text-gray-500 mt-1">Full HTML email template</p>
              </div>

              <div class="mb-6">
                <label class="block text-gray-700 text-sm font-medium mb-2">Plain Text Body</label>
                <textarea name="body_text" rows="6" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-blue-500"></textarea>
                <p class="text-xs text-gray-500 mt-1">Fallback for email clients that don't support HTML</p>
              </div>

              <div class="flex space-x-2">
                <button type="submit" class="flex-1 bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded-lg">
                  <i class="fas fa-save"></i> Create Template
                </button>
                <a href="/settings/email-templates" class="flex-1 bg-gray-300 hover:bg-gray-400 text-gray-800 px-4 py-2 rounded-lg text-center">
                  Cancel
                </a>
              </div>
            </form>
          </div>
        </div>
      </main>
    </div>
  </div>
</body>
</html>
