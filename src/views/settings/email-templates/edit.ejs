<!DOCTYPE html>
<html>
<head>
  <title>Edit Email Template - License Manager</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-100">
  <div class="flex h-screen overflow-hidden">
    <%- include('../../partials/sidebar', { currentPage: 'settings', user: user }) %>

    <div class="flex-1 flex flex-col overflow-hidden">
      <header class="bg-white shadow-sm">
        <div class="flex items-center justify-between p-4">
          <div>
            <h2 class="text-xl font-semibold text-gray-800">Edit Email Template</h2>
            <nav class="text-sm text-gray-600 mt-1">
              <a href="/settings" class="hover:text-gray-800">Settings</a> /
              <a href="/settings/email-templates" class="hover:text-gray-800">Email Templates</a> /
              Edit
            </nav>
          </div>
          <a href="/settings/email-templates" class="text-gray-600 hover:text-gray-800"><i class="fas fa-arrow-left"></i> Back</a>
        </div>
      </header>

      <main class="flex-1 overflow-y-auto p-6">
        <div class="max-w-4xl mx-auto">
          <div class="bg-white rounded-lg shadow p-6">
            <% if (error) { %>
              <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
                <%= error %>
              </div>
            <% } %>

            <form method="POST" action="/settings/email-templates/<%= template.id %>/edit">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                <div>
                  <label class="block text-gray-700 text-sm font-medium mb-2">Template Name *</label>
                  <input type="text" name="name" value="<%= template.name %>" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-blue-500">
                </div>

                <div>
                  <label class="block text-gray-700 text-sm font-medium mb-2">Type *</label>
                  <select name="type" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-blue-500">
                    <option value="user" <%= template.type === 'user' ? 'selected' : '' %>>User</option>
                    <option value="license" <%= template.type === 'license' ? 'selected' : '' %>>License</option>
                    <option value="system" <%= template.type === 'system' ? 'selected' : '' %>>System</option>
                  </select>
                </div>

                <div>
                  <label class="block text-gray-700 text-sm font-medium mb-2">Language *</label>
                  <select name="language" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-blue-500">
                    <option value="en" <%= template.language === 'en' ? 'selected' : '' %>>English (EN)</option>
                    <option value="id" <%= template.language === 'id' ? 'selected' : '' %>>Indonesian (ID)</option>
                  </select>
                </div>

                <div>
                  <label class="block text-gray-700 text-sm font-medium mb-2">Design Variation *</label>
                  <select name="design_variation" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-blue-500">
                    <option value="1" <%= template.design_variation === 1 ? 'selected' : '' %>>Version 1</option>
                    <option value="2" <%= template.design_variation === 2 ? 'selected' : '' %>>Version 2</option>
                  </select>
                </div>
              </div>

              <div class="mb-4">
                <label class="block text-gray-700 text-sm font-medium mb-2">Subject *</label>
                <input type="text" name="subject" value="<%= template.subject %>" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-blue-500">
              </div>

              <div class="mb-4">
                <label class="block text-gray-700 text-sm font-medium mb-2">Variables</label>
                <input type="text" name="variables" value="<%= template.variables || '' %>" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-blue-500">
              </div>

              <div class="mb-4">
                <label class="block text-gray-700 text-sm font-medium mb-2">HTML Body *</label>
                <textarea name="body_html" required rows="12" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-blue-500 font-mono text-sm"><%= template.body_html %></textarea>
              </div>

              <div class="mb-4">
                <label class="block text-gray-700 text-sm font-medium mb-2">Plain Text Body</label>
                <textarea name="body_text" rows="6" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-blue-500"><%= template.body_text || '' %></textarea>
              </div>

              <div class="mb-6">
                <label class="flex items-center">
                  <input type="checkbox" name="is_active" <%= template.is_active ? 'checked' : '' %> class="form-checkbox h-5 w-5 text-blue-600">
                  <span class="ml-2 text-gray-700">Active</span>
                </label>
              </div>

              <div class="flex space-x-2">
                <button type="submit" class="flex-1 bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded-lg">
                  <i class="fas fa-save"></i> Update Template
                </button>
                <a href="/settings/email-templates" class="flex-1 bg-gray-300 hover:bg-gray-400 text-gray-800 px-4 py-2 rounded-lg text-center">
                  Cancel
                </a>
              </div>
            </form>
          </div>
        </div>
      </main>
    </div>
  </div>
</body>
</html>
