<!DOCTYPE html>
<html>
<head>
  <title>Email Templates - License Manager</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-100">
  <div class="flex h-screen overflow-hidden">
    <aside class="w-64 bg-gray-800 text-white flex-shrink-0">
      <div class="p-4">
        <h1 class="text-2xl font-bold mb-8"><i class="fas fa-key"></i> License Manager</h1>
        <nav class="space-y-2">
          <a href="/dashboard" class="flex items-center space-x-3 p-3 rounded hover:bg-gray-700"><i class="fas fa-chart-line w-5"></i><span>Dashboard</span></a>
          <a href="/products" class="flex items-center space-x-3 p-3 rounded hover:bg-gray-700"><i class="fas fa-box w-5"></i><span>Products</span></a>
          <a href="/customers" class="flex items-center space-x-3 p-3 rounded hover:bg-gray-700"><i class="fas fa-users w-5"></i><span>Customers</span></a>
          <a href="/licenses" class="flex items-center space-x-3 p-3 rounded hover:bg-gray-700"><i class="fas fa-certificate w-5"></i><span>Licenses</span></a>
          <a href="/features" class="flex items-center space-x-3 p-3 rounded hover:bg-gray-700"><i class="fas fa-puzzle-piece w-5"></i><span>Features</span></a>
          <a href="/users" class="flex items-center space-x-3 p-3 rounded hover:bg-gray-700"><i class="fas fa-user-shield w-5"></i><span>Users</span></a>
          <a href="/roles" class="flex items-center space-x-3 p-3 rounded hover:bg-gray-700"><i class="fas fa-user-tag w-5"></i><span>Roles & Permissions</span></a>
          <a href="/reports" class="flex items-center space-x-3 p-3 rounded hover:bg-gray-700"><i class="fas fa-file-alt w-5"></i><span>Reports</span></a>
          <a href="/docs" class="flex items-center space-x-3 p-3 rounded hover:bg-gray-700"><i class="fas fa-book w-5"></i><span>API Docs</span></a>
          <a href="/settings" class="flex items-center space-x-3 p-3 rounded bg-gray-700"><i class="fas fa-cog w-5"></i><span>Settings</span></a>
        </nav>
      </div>
      <div class="absolute bottom-0 w-64 p-4 bg-gray-900">
        <div class="flex items-center space-x-3">
          <div class="w-10 h-10 rounded-full bg-gray-700 flex items-center justify-center"><i class="fas fa-user"></i></div>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-medium truncate"><%= user.userName || 'Admin' %></p>
            <p class="text-xs text-gray-400 truncate"><%= user.userEmail || '' %></p>
          </div>
          <a href="/logout" class="text-gray-400 hover:text-white"><i class="fas fa-sign-out-alt"></i></a>
        </div>
      </div>
    </aside>

    <div class="flex-1 flex flex-col overflow-hidden">
      <header class="bg-white shadow-sm">
        <div class="flex items-center justify-between p-4">
          <div>
            <h2 class="text-xl font-semibold text-gray-800">Email Templates</h2>
            <nav class="text-sm text-gray-600 mt-1">
              <a href="/settings" class="hover:text-gray-800">Settings</a> / Email Templates
            </nav>
          </div>
          <div class="space-x-2">
            <a href="/settings/email-templates/logs" class="bg-gray-500 hover:bg-gray-600 text-white px-4 py-2 rounded-lg text-sm">
              <i class="fas fa-history"></i> Email Logs
            </a>
            <a href="/settings/email-templates/create" class="bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded-lg text-sm">
              <i class="fas fa-plus"></i> Add Template
            </a>
          </div>
        </div>
      </header>

      <main class="flex-1 overflow-y-auto p-6">
        <!-- Filter/Group by Type -->
        <div class="mb-6">
          <div class="flex space-x-2 overflow-x-auto pb-2">
            <button onclick="filterByType('all')" class="filter-btn px-4 py-2 rounded-lg bg-blue-500 text-white text-sm whitespace-nowrap">All Templates</button>
            <button onclick="filterByType('user')" class="filter-btn px-4 py-2 rounded-lg bg-gray-200 text-gray-700 text-sm whitespace-nowrap">User</button>
            <button onclick="filterByType('license')" class="filter-btn px-4 py-2 rounded-lg bg-gray-200 text-gray-700 text-sm whitespace-nowrap">License</button>
          </div>
        </div>

        <!-- Templates Grouped List -->
        <div class="space-y-6">
          <% if (templateGroups && templateGroups.length > 0) { %>
            <% templateGroups.forEach(group => { %>
              <div class="template-group bg-white rounded-lg shadow overflow-hidden" data-type="<%= group.type %>">
                <!-- Group Header -->
                <div class="bg-gradient-to-r from-blue-500 to-purple-600 text-white px-6 py-4">
                  <div class="flex items-center justify-between">
                    <div class="flex items-center space-x-3">
                      <i class="fas <%= group.type === 'user' ? 'fa-user-circle' : 'fa-key' %> text-2xl"></i>
                      <div>
                        <h3 class="text-lg font-bold">
                          <%= group.name.replace(/_/g, ' ').replace(/\b\w/g, l => l.toUpperCase()) %>
                        </h3>
                        <p class="text-xs text-blue-100">
                          <%= group.type.toUpperCase() %> • <%= group.variants.length %> variant<%= group.variants.length !== 1 ? 's' : '' %>
                        </p>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Variants List -->
                <div class="divide-y divide-gray-200">
                  <% group.variants.forEach((template, index) => { %>
                    <div class="p-4 hover:bg-gray-50 transition-colors <%= template.is_default ? 'bg-yellow-50' : '' %>">
                      <div class="flex items-center justify-between gap-4">
                        <!-- Left: Badges & Info -->
                        <div class="flex-1 min-w-0">
                          <div class="flex items-center space-x-2 mb-2">
                            <span class="px-2 py-1 rounded text-xs font-semibold <%= template.language === 'en' ? 'bg-blue-100 text-blue-800' : 'bg-green-100 text-green-800' %>">
                              <%= template.language.toUpperCase() %>
                            </span>
                            <span class="px-2 py-1 rounded text-xs font-semibold bg-purple-100 text-purple-800">
                              Design <%= template.design_variation %>
                            </span>
                            <% if (template.is_default) { %>
                              <span class="px-2 py-1 rounded text-xs font-semibold bg-yellow-100 text-yellow-800">
                                <i class="fas fa-star"></i> DEFAULT
                              </span>
                            <% } %>
                            <% if (template.is_active) { %>
                              <span class="px-2 py-1 rounded text-xs font-semibold bg-green-100 text-green-800">
                                <i class="fas fa-check-circle"></i> Active
                              </span>
                            <% } else { %>
                              <span class="px-2 py-1 rounded text-xs font-semibold bg-gray-100 text-gray-800">
                                Inactive
                              </span>
                            <% } %>
                          </div>
                          <p class="text-sm text-gray-700 font-medium truncate mb-1">
                            <%= template.subject %>
                          </p>
                          <p class="text-xs text-gray-500">
                            <i class="fas fa-clock"></i> Updated <%= moment(template.updated_at).fromNow() %>
                          </p>
                        </div>

                        <!-- Right: Actions -->
                        <div class="flex items-center space-x-2 flex-shrink-0">
                          <% if (!template.is_default) { %>
                            <button onclick="setAsDefault(<%= template.id %>, '<%= template.name %>')" class="bg-yellow-500 hover:bg-yellow-600 text-white px-3 py-2 rounded text-xs font-medium">
                              <i class="fas fa-star"></i> Set Default
                            </button>
                          <% } else { %>
                            <div class="bg-yellow-100 border border-yellow-300 text-yellow-800 px-3 py-2 rounded text-xs font-medium">
                              <i class="fas fa-star"></i> Default
                            </div>
                          <% } %>
                          <a href="/settings/email-templates/<%= template.id %>" class="bg-blue-500 hover:bg-blue-600 text-white px-3 py-2 rounded text-xs font-medium">
                            <i class="fas fa-eye"></i> View
                          </a>
                          <a href="/settings/email-templates/<%= template.id %>/edit" class="bg-gray-500 hover:bg-gray-600 text-white px-3 py-2 rounded text-xs font-medium">
                            <i class="fas fa-edit"></i> Edit
                          </a>
                          <button onclick="deleteTemplate(<%= template.id %>)" class="bg-red-500 hover:bg-red-600 text-white px-3 py-2 rounded text-xs font-medium">
                            <i class="fas fa-trash"></i>
                          </button>
                        </div>
                      </div>
                    </div>
                  <% }); %>
                </div>
              </div>
            <% }); %>
          <% } else { %>
            <div class="bg-white rounded-lg shadow p-8 text-center">
              <i class="fas fa-envelope text-6xl text-gray-300 mb-4"></i>
              <p class="text-gray-500 mb-4">No email templates found</p>
              <a href="/settings/email-templates/create" class="bg-blue-500 hover:bg-blue-600 text-white px-6 py-2 rounded-lg inline-block">
                <i class="fas fa-plus"></i> Create First Template
              </a>
            </div>
          <% } %>
        </div>
      </main>
    </div>
  </div>

  <!-- Toast Container -->
  <div id="toast-container" class="fixed top-4 right-4 z-50 space-y-2"></div>

  <%- include('../../partials/confirm-modal') %>

  <script>
    function filterByType(type) {
      const groups = document.querySelectorAll('.template-group');
      const buttons = document.querySelectorAll('.filter-btn');

      // Update button styles
      buttons.forEach(btn => {
        btn.classList.remove('bg-blue-500', 'text-white');
        btn.classList.add('bg-gray-200', 'text-gray-700');
      });
      event.target.classList.remove('bg-gray-200', 'text-gray-700');
      event.target.classList.add('bg-blue-500', 'text-white');

      // Filter groups
      groups.forEach(group => {
        if (type === 'all' || group.dataset.type === type) {
          group.style.display = 'block';
        } else {
          group.style.display = 'none';
        }
      });
    }

    function showToast(message, type = 'success') {
      const container = document.getElementById('toast-container');
      const toast = document.createElement('div');
      const colors = { success: 'bg-green-500', error: 'bg-red-500', warning: 'bg-yellow-500', info: 'bg-blue-500' };
      const icons = { success: 'fa-check-circle', error: 'fa-times-circle', warning: 'fa-exclamation-triangle', info: 'fa-info-circle' };
      toast.className = `${colors[type]} text-white px-6 py-4 rounded-lg shadow-lg flex items-center space-x-3 min-w-[300px] max-w-md transform transition-all duration-300 translate-x-0`;
      toast.innerHTML = `<i class="fas ${icons[type]} text-xl"></i><span class="flex-1">${message}</span><button onclick="this.parentElement.remove()" class="text-white hover:text-gray-200"><i class="fas fa-times"></i></button>`;
      container.appendChild(toast);
      setTimeout(() => { toast.style.opacity = '0'; toast.style.transform = 'translateX(100%)'; setTimeout(() => toast.remove(), 300); }, 5000);
    }

    async function setAsDefault(id, name) {
      const confirmed = await showConfirm(
        `Set this template as the default for all "${name.replace(/_/g, ' ')}" emails?`,
        'Set Default Template',
        { type: 'info', confirmText: 'Set as Default' }
      );
      if (!confirmed) return;

      try {
        const res = await fetch(`/settings/email-templates/${id}/set-default`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' }
        });
        const data = await res.json();
        if (data.success) {
          showToast('Default template updated successfully!', 'success');
          setTimeout(() => location.reload(), 1000);
        } else {
          showToast(data.message || 'Error setting default template', 'error');
        }
      } catch (e) {
        showToast('Error setting default template', 'error');
      }
    }

    async function deleteTemplate(id) {
      const confirmed = await showConfirm(
        'Are you sure you want to delete this email template? This action cannot be undone.',
        'Confirm Deletion',
        { type: 'delete', confirmText: 'Delete' }
      );
      if (!confirmed) return;

      try {
        const res = await fetch(`/settings/email-templates/${id}`, { method: 'DELETE' });
        const data = await res.json();
        if (data.success) {
          showToast('Email template deleted successfully!', 'success');
          setTimeout(() => location.reload(), 1000);
        } else {
          showToast(data.message || 'Error deleting template', 'error');
        }
      } catch (e) {
        showToast('Error deleting template', 'error');
      }
    }
  </script>
</body>
</html>
