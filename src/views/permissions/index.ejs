<!DOCTYPE html>
<html>
<head>
  <title>Permissions Management - License Manager</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-100">
  <div class="flex h-screen overflow-hidden">
    <aside class="w-64 bg-gray-800 text-white flex-shrink-0">
      <div class="p-4">
        <h1 class="text-2xl font-bold mb-8"><i class="fas fa-key"></i> License Manager</h1>
        <nav class="space-y-2">
          <a href="/dashboard" class="flex items-center space-x-3 p-3 rounded hover:bg-gray-700"><i class="fas fa-chart-line w-5"></i><span>Dashboard</span></a>
          <a href="/products" class="flex items-center space-x-3 p-3 rounded hover:bg-gray-700"><i class="fas fa-box w-5"></i><span>Products</span></a>
          <a href="/customers" class="flex items-center space-x-3 p-3 rounded hover:bg-gray-700"><i class="fas fa-users w-5"></i><span>Customers</span></a>
          <a href="/licenses" class="flex items-center space-x-3 p-3 rounded hover:bg-gray-700"><i class="fas fa-certificate w-5"></i><span>Licenses</span></a>
          <a href="/features" class="flex items-center space-x-3 p-3 rounded hover:bg-gray-700"><i class="fas fa-puzzle-piece w-5"></i><span>Features</span></a>
          <a href="/users" class="flex items-center space-x-3 p-3 rounded hover:bg-gray-700"><i class="fas fa-user-shield w-5"></i><span>Users</span></a>
          <a href="/roles" class="flex items-center space-x-3 p-3 rounded bg-gray-700"><i class="fas fa-user-tag w-5"></i><span>Roles & Permissions</span></a>
          <a href="/reports" class="flex items-center space-x-3 p-3 rounded hover:bg-gray-700"><i class="fas fa-file-alt w-5"></i><span>Reports</span></a>
          <a href="/docs" class="flex items-center space-x-3 p-3 rounded hover:bg-gray-700"><i class="fas fa-book w-5"></i><span>API Docs</span></a>
          <a href="/settings" class="flex items-center space-x-3 p-3 rounded hover:bg-gray-700"><i class="fas fa-cog w-5"></i><span>Settings</span></a>
        </nav>
      </div>
      <div class="absolute bottom-0 w-64 p-4 bg-gray-900">
        <div class="flex items-center space-x-3">
          <div class="w-10 h-10 rounded-full bg-gray-700 flex items-center justify-center"><i class="fas fa-user"></i></div>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-medium truncate"><%= user.userName || 'Admin' %></p>
            <p class="text-xs text-gray-400 truncate"><%= user.userEmail || '' %></p>
          </div>
          <a href="/logout" class="text-gray-400 hover:text-white"><i class="fas fa-sign-out-alt"></i></a>
        </div>
      </div>
    </aside>

    <div class="flex-1 flex flex-col overflow-hidden">
      <header class="bg-white shadow-sm">
        <div class="flex items-center justify-between p-4">
          <div>
            <a href="/roles" class="text-blue-600 hover:text-blue-800 text-sm mb-1 inline-block">
              <i class="fas fa-arrow-left mr-1"></i>Back to Roles
            </a>
            <h2 class="text-xl font-semibold text-gray-800">Permissions Management</h2>
            <p class="text-sm text-gray-600">View all system permissions grouped by resource</p>
          </div>
          <a href="/permissions/create" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 text-sm">
            <i class="fas fa-plus mr-1"></i>Create Permission
          </a>
        </div>
      </header>

      <main class="flex-1 overflow-y-auto p-6">
        <!-- Stats -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
          <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center">
              <div class="flex-shrink-0 bg-blue-100 rounded-lg p-3">
                <i class="fas fa-key text-blue-600 text-2xl"></i>
              </div>
              <div class="ml-4">
                <p class="text-sm font-medium text-gray-500">Total Permissions</p>
                <p class="text-2xl font-semibold text-gray-900"><%= permissions.length %></p>
              </div>
            </div>
          </div>

          <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center">
              <div class="flex-shrink-0 bg-purple-100 rounded-lg p-3">
                <i class="fas fa-layer-group text-purple-600 text-2xl"></i>
              </div>
              <div class="ml-4">
                <p class="text-sm font-medium text-gray-500">Resources</p>
                <p class="text-2xl font-semibold text-gray-900"><%= Object.keys(groupedPermissions).length %></p>
              </div>
            </div>
          </div>

          <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center">
              <div class="flex-shrink-0 bg-green-100 rounded-lg p-3">
                <i class="fas fa-user-tag text-green-600 text-2xl"></i>
              </div>
              <div class="ml-4">
                <p class="text-sm font-medium text-gray-500">Avg per Resource</p>
                <p class="text-2xl font-semibold text-gray-900">
                  <%= Math.round(permissions.length / Object.keys(groupedPermissions).length) %>
                </p>
              </div>
            </div>
          </div>
        </div>

        <% if (permissions.length === 0) { %>
          <div class="bg-white rounded-lg shadow p-12 text-center">
            <i class="fas fa-key text-6xl text-gray-300 mb-4"></i>
            <h3 class="text-xl font-semibold text-gray-800 mb-2">No Permissions Found</h3>
            <p class="text-gray-600 mb-4">Get started by creating your first permission.</p>
            <a href="/permissions/create" class="bg-blue-600 text-white px-6 py-3 rounded hover:bg-blue-700">
              <i class="fas fa-plus mr-2"></i>Create First Permission
            </a>
          </div>
        <% } else { %>
          <!-- Permissions by Resource -->
          <div class="space-y-4">
            <% Object.keys(groupedPermissions).sort().forEach(resource => { %>
              <div class="bg-white rounded-lg shadow-md overflow-hidden">
                <div class="bg-gray-50 px-6 py-4 border-b">
                  <h3 class="text-lg font-semibold text-gray-800 capitalize">
                    <i class="fas fa-<%= resource === 'dashboard' ? 'chart-line' : resource === 'products' ? 'box' : resource === 'customers' ? 'users' : resource === 'licenses' ? 'certificate' : resource === 'users' ? 'user-shield' : resource === 'roles' ? 'user-tag' : resource === 'permissions' ? 'key' : resource === 'reports' ? 'file-alt' : resource === 'settings' ? 'cog' : 'puzzle-piece' %> mr-2"></i>
                    <%= resource.charAt(0).toUpperCase() + resource.slice(1) %>
                    <span class="text-sm font-normal text-gray-500 ml-2">(<%= groupedPermissions[resource].length %> permissions)</span>
                  </h3>
                </div>

                <div class="p-6">
                  <div class="overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200">
                      <thead class="bg-gray-50">
                        <tr>
                          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Permission Name</th>
                          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Action</th>
                          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Description</th>
                          <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Roles</th>
                          <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 uppercase">Actions</th>
                        </tr>
                      </thead>
                      <tbody class="bg-white divide-y divide-gray-200">
                        <% groupedPermissions[resource].forEach(perm => { %>
                          <tr class="hover:bg-gray-50">
                            <td class="px-6 py-4 whitespace-nowrap">
                              <code class="text-sm text-blue-600 bg-blue-50 px-2 py-1 rounded"><%= perm.name %></code>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                              <span class="text-sm font-medium text-gray-900"><%= perm.action %></span>
                            </td>
                            <td class="px-6 py-4">
                              <span class="text-sm text-gray-600"><%= perm.description %></span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                              <span class="bg-gray-100 text-gray-800 text-xs px-2 py-1 rounded">
                                <%= perm.role_count %> role<%= perm.role_count !== 1 ? 's' : '' %>
                              </span>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-right text-sm space-x-2">
                              <a href="/permissions/<%= perm.id %>" class="text-blue-600 hover:text-blue-800">
                                <i class="fas fa-eye mr-1"></i>View
                              </a>
                              <a href="/permissions/<%= perm.id %>/edit" class="text-green-600 hover:text-green-800">
                                <i class="fas fa-edit mr-1"></i>Edit
                              </a>
                              <button onclick="deletePermission(<%= perm.id %>, '<%= perm.name %>')"
                                      class="text-red-600 hover:text-red-800">
                                <i class="fas fa-trash mr-1"></i>Delete
                              </button>
                            </td>
                          </tr>
                        <% }) %>
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>
        <% } %>
      </main>
    </div>
  </div>

  <!-- Toast Container -->
  <div id="toast-container" class="fixed top-4 right-4 z-50 space-y-2"></div>

  <script>
    function showToast(message, type = 'success') {
      const container = document.getElementById('toast-container');
      const toast = document.createElement('div');
      const colors = {
        success: 'bg-green-500',
        error: 'bg-red-500',
        warning: 'bg-yellow-500',
        info: 'bg-blue-500'
      };
      const icons = {
        success: 'fa-check-circle',
        error: 'fa-times-circle',
        warning: 'fa-exclamation-triangle',
        info: 'fa-info-circle'
      };
      toast.className = `${colors[type]} text-white px-6 py-4 rounded-lg shadow-lg flex items-center space-x-3 min-w-[300px] max-w-md`;
      toast.innerHTML = `
        <i class="fas ${icons[type]} text-xl"></i>
        <span class="flex-1">${message}</span>
        <button onclick="this.parentElement.remove()" class="text-white hover:text-gray-200">
          <i class="fas fa-times"></i>
        </button>
      `;
      container.appendChild(toast);
      setTimeout(() => {
        toast.style.opacity = '0';
        setTimeout(() => toast.remove(), 300);
      }, 5000);
    }

    async function deletePermission(id, name) {
      if (!confirm(`Are you sure you want to delete the permission "${name}"?\n\nThis will remove it from all roles. This action cannot be undone.`)) {
        return;
      }

      try {
        const response = await fetch(`/permissions/${id}`, {
          method: 'DELETE',
          headers: {
            'Content-Type': 'application/json'
          }
        });

        const data = await response.json();

        if (response.ok) {
          showToast(`Permission "${name}" deleted successfully`, 'success');
          setTimeout(() => window.location.reload(), 1000);
        } else {
          showToast(data.error || 'Failed to delete permission', 'error');
        }
      } catch (error) {
        console.error('Error:', error);
        showToast('Failed to delete permission', 'error');
      }
    }
  </script>
</body>
</html>
