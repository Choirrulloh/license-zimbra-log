<!DOCTYPE html>
<html>
<head>
  <title>Create Permission - License Manager</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-100">
  <div class="flex h-screen overflow-hidden">
    <%- include('../partials/sidebar', { currentPage: 'permissions', user: user }) %>

    <div class="flex-1 flex flex-col overflow-hidden">
      <header class="bg-white shadow-sm">
        <div class="flex items-center justify-between p-4">
          <div>
            <a href="/permissions" class="text-blue-600 hover:text-blue-800 text-sm mb-1 inline-block">
              <i class="fas fa-arrow-left mr-1"></i>Back to Permissions
            </a>
            <h2 class="text-xl font-semibold text-gray-800">Create New Permission</h2>
            <p class="text-sm text-gray-600">Define a new permission for the system</p>
          </div>
        </div>
      </header>

      <main class="flex-1 overflow-y-auto p-6">
        <div class="max-w-2xl mx-auto">
          <div class="bg-white rounded-lg shadow-md p-6">
            <form id="createPermissionForm" method="POST" action="/permissions/create">
              <div class="space-y-4">
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-2">
                    Permission Name *
                    <span class="text-gray-500 text-xs">(format: resource.action, e.g. products.create)</span>
                  </label>
                  <input type="text" name="name" required
                         pattern="[a-z_]+\.[a-z_]+"
                         class="w-full px-4 py-2 border rounded focus:ring-2 focus:ring-blue-500"
                         placeholder="e.g. products.create">
                  <p class="text-xs text-gray-500 mt-1">Use lowercase letters, underscores, and a single dot</p>
                </div>

                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-2">
                    Resource *
                  </label>
                  <select name="resource" required
                          class="w-full px-4 py-2 border rounded focus:ring-2 focus:ring-blue-500">
                    <option value="">Select a resource...</option>
                    <option value="dashboard">Dashboard</option>
                    <option value="products">Products</option>
                    <option value="customers">Customers</option>
                    <option value="licenses">Licenses</option>
                    <option value="users">Users</option>
                    <option value="roles">Roles</option>
                    <option value="permissions">Permissions</option>
                    <option value="reports">Reports</option>
                    <option value="settings">Settings</option>
                    <option value="features">Features</option>
                  </select>
                </div>

                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-2">
                    Action *
                  </label>
                  <select name="action" required
                          class="w-full px-4 py-2 border rounded focus:ring-2 focus:ring-blue-500">
                    <option value="">Select an action...</option>
                    <option value="view">View</option>
                    <option value="create">Create</option>
                    <option value="edit">Edit</option>
                    <option value="delete">Delete</option>
                    <option value="export">Export</option>
                    <option value="import">Import</option>
                    <option value="assign">Assign</option>
                    <option value="revoke">Revoke</option>
                    <option value="suspend">Suspend</option>
                    <option value="renew">Renew</option>
                  </select>
                  <p class="text-xs text-gray-500 mt-1">Or type a custom action</p>
                </div>

                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-2">
                    Description *
                  </label>
                  <textarea name="description" rows="3" required
                            class="w-full px-4 py-2 border rounded focus:ring-2 focus:ring-blue-500"
                            placeholder="Describe what this permission allows the user to do"></textarea>
                </div>
              </div>

              <!-- Submit -->
              <div class="flex justify-end space-x-3 mt-6">
                <a href="/permissions" class="px-6 py-2 border border-gray-300 rounded text-gray-700 hover:bg-gray-50">
                  Cancel
                </a>
                <button type="submit" class="px-6 py-2 bg-blue-600 text-white rounded hover:bg-blue-700">
                  <i class="fas fa-save mr-2"></i>Create Permission
                </button>
              </div>
            </form>
          </div>

          <!-- Info Box -->
          <div class="mt-6 bg-blue-50 border border-blue-200 rounded-lg p-4">
            <div class="flex">
              <i class="fas fa-info-circle text-blue-600 text-xl mr-3 mt-0.5"></i>
              <div>
                <h4 class="text-sm font-semibold text-blue-900 mb-1">Permission Naming Convention</h4>
                <ul class="text-sm text-blue-800 space-y-1">
                  <li>• Use the format: <code class="bg-blue-100 px-1 rounded">resource.action</code></li>
                  <li>• Resource should match an existing module (products, customers, etc.)</li>
                  <li>• Action should be a verb (view, create, edit, delete, etc.)</li>
                  <li>• Example: <code class="bg-blue-100 px-1 rounded">licenses.renew</code>, <code class="bg-blue-100 px-1 rounded">reports.export</code></li>
                </ul>
              </div>
            </div>
          </div>
        </div>
      </main>
    </div>
  </div>

  <!-- Toast Container -->
  <div id="toast-container" class="fixed top-4 right-4 z-50 space-y-2"></div>

  <script>
    function showToast(message, type = 'success') {
      const container = document.getElementById('toast-container');
      const toast = document.createElement('div');
      const colors = {
        success: 'bg-green-500',
        error: 'bg-red-500',
        warning: 'bg-yellow-500',
        info: 'bg-blue-500'
      };
      const icons = {
        success: 'fa-check-circle',
        error: 'fa-times-circle',
        warning: 'fa-exclamation-triangle',
        info: 'fa-info-circle'
      };
      toast.className = `${colors[type]} text-white px-6 py-4 rounded-lg shadow-lg flex items-center space-x-3 min-w-[300px] max-w-md`;
      toast.innerHTML = `
        <i class="fas ${icons[type]} text-xl"></i>
        <span class="flex-1">${message}</span>
        <button onclick="this.parentElement.remove()" class="text-white hover:text-gray-200">
          <i class="fas fa-times"></i>
        </button>
      `;
      container.appendChild(toast);
      setTimeout(() => {
        toast.style.opacity = '0';
        setTimeout(() => toast.remove(), 300);
      }, 5000);
    }

    // Auto-fill permission name based on resource and action
    const resourceInput = document.querySelector('[name="resource"]');
    const actionInput = document.querySelector('[name="action"]');
    const nameInput = document.querySelector('[name="name"]');

    function updatePermissionName() {
      const resource = resourceInput.value;
      const action = actionInput.value;
      if (resource && action) {
        nameInput.value = `${resource}.${action}`;
      }
    }

    resourceInput.addEventListener('change', updatePermissionName);
    actionInput.addEventListener('change', updatePermissionName);

    document.getElementById('createPermissionForm').addEventListener('submit', async (e) => {
      e.preventDefault();

      const formData = new FormData(e.target);
      const data = {
        name: formData.get('name'),
        resource: formData.get('resource'),
        action: formData.get('action'),
        description: formData.get('description')
      };

      try {
        const response = await fetch('/permissions/create', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(data)
        });

        if (response.ok) {
          showToast('Permission created successfully', 'success');
          setTimeout(() => window.location.href = '/permissions', 1000);
        } else {
          const error = await response.json();
          showToast(error.error || 'Failed to create permission', 'error');
        }
      } catch (error) {
        console.error('Error:', error);
        showToast('Failed to create permission', 'error');
      }
    });
  </script>
</body>
</html>
