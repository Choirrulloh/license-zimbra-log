<!DOCTYPE html>
<html>
<head>
  <title>Edit <%= permission.name %> - License Manager</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-100">
  <div class="flex h-screen overflow-hidden">
    <aside class="w-64 bg-gray-800 text-white flex-shrink-0">
      <div class="p-4">
        <h1 class="text-2xl font-bold mb-8"><i class="fas fa-key"></i> License Manager</h1>
        <nav class="space-y-2">
          <a href="/dashboard" class="flex items-center space-x-3 p-3 rounded hover:bg-gray-700"><i class="fas fa-chart-line w-5"></i><span>Dashboard</span></a>
          <a href="/products" class="flex items-center space-x-3 p-3 rounded hover:bg-gray-700"><i class="fas fa-box w-5"></i><span>Products</span></a>
          <a href="/customers" class="flex items-center space-x-3 p-3 rounded hover:bg-gray-700"><i class="fas fa-users w-5"></i><span>Customers</span></a>
          <a href="/licenses" class="flex items-center space-x-3 p-3 rounded hover:bg-gray-700"><i class="fas fa-certificate w-5"></i><span>Licenses</span></a>
          <a href="/features" class="flex items-center space-x-3 p-3 rounded hover:bg-gray-700"><i class="fas fa-puzzle-piece w-5"></i><span>Features</span></a>
          <a href="/users" class="flex items-center space-x-3 p-3 rounded hover:bg-gray-700"><i class="fas fa-user-shield w-5"></i><span>Users</span></a>
          <a href="/roles" class="flex items-center space-x-3 p-3 rounded bg-gray-700"><i class="fas fa-user-tag w-5"></i><span>Roles & Permissions</span></a>
          <a href="/reports" class="flex items-center space-x-3 p-3 rounded hover:bg-gray-700"><i class="fas fa-file-alt w-5"></i><span>Reports</span></a>
          <a href="/docs" class="flex items-center space-x-3 p-3 rounded hover:bg-gray-700"><i class="fas fa-book w-5"></i><span>API Docs</span></a>
          <a href="/settings" class="flex items-center space-x-3 p-3 rounded hover:bg-gray-700"><i class="fas fa-cog w-5"></i><span>Settings</span></a>
        </nav>
      </div>
      <div class="absolute bottom-0 w-64 p-4 bg-gray-900">
        <div class="flex items-center space-x-3">
          <div class="w-10 h-10 rounded-full bg-gray-700 flex items-center justify-center"><i class="fas fa-user"></i></div>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-medium truncate"><%= user.userName || 'Admin' %></p>
            <p class="text-xs text-gray-400 truncate"><%= user.userEmail || '' %></p>
          </div>
          <a href="/logout" class="text-gray-400 hover:text-white"><i class="fas fa-sign-out-alt"></i></a>
        </div>
      </div>
    </aside>

    <div class="flex-1 flex flex-col overflow-hidden">
      <header class="bg-white shadow-sm">
        <div class="flex items-center justify-between p-4">
          <div>
            <a href="/permissions/<%= permission.id %>" class="text-blue-600 hover:text-blue-800 text-sm mb-1 inline-block">
              <i class="fas fa-arrow-left mr-1"></i>Back to Permission Details
            </a>
            <h2 class="text-xl font-semibold text-gray-800">Edit Permission</h2>
            <p class="text-sm text-gray-600">Update permission details</p>
          </div>
        </div>
      </header>

      <main class="flex-1 overflow-y-auto p-6">
        <div class="max-w-2xl mx-auto">
          <div class="bg-white rounded-lg shadow-md p-6">
            <form id="editPermissionForm" method="POST" action="/permissions/<%= permission.id %>/edit">
              <div class="space-y-4">
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-2">
                    Permission Name
                    <span class="text-gray-500 text-xs">(cannot be changed)</span>
                  </label>
                  <input type="text" value="<%= permission.name %>" readonly
                         class="w-full px-4 py-2 border rounded bg-gray-100 text-gray-600 cursor-not-allowed">
                </div>

                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-2">
                    Resource *
                  </label>
                  <select name="resource" required
                          class="w-full px-4 py-2 border rounded focus:ring-2 focus:ring-blue-500">
                    <option value="dashboard" <%= permission.resource === 'dashboard' ? 'selected' : '' %>>Dashboard</option>
                    <option value="products" <%= permission.resource === 'products' ? 'selected' : '' %>>Products</option>
                    <option value="customers" <%= permission.resource === 'customers' ? 'selected' : '' %>>Customers</option>
                    <option value="licenses" <%= permission.resource === 'licenses' ? 'selected' : '' %>>Licenses</option>
                    <option value="users" <%= permission.resource === 'users' ? 'selected' : '' %>>Users</option>
                    <option value="roles" <%= permission.resource === 'roles' ? 'selected' : '' %>>Roles</option>
                    <option value="permissions" <%= permission.resource === 'permissions' ? 'selected' : '' %>>Permissions</option>
                    <option value="reports" <%= permission.resource === 'reports' ? 'selected' : '' %>>Reports</option>
                    <option value="settings" <%= permission.resource === 'settings' ? 'selected' : '' %>>Settings</option>
                    <option value="features" <%= permission.resource === 'features' ? 'selected' : '' %>>Features</option>
                  </select>
                </div>

                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-2">
                    Action *
                  </label>
                  <input type="text" name="action" value="<%= permission.action %>" required
                         class="w-full px-4 py-2 border rounded focus:ring-2 focus:ring-blue-500">
                </div>

                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-2">
                    Description *
                  </label>
                  <textarea name="description" rows="3" required
                            class="w-full px-4 py-2 border rounded focus:ring-2 focus:ring-blue-500"><%= permission.description %></textarea>
                </div>
              </div>

              <!-- Submit -->
              <div class="flex justify-end space-x-3 mt-6">
                <a href="/permissions/<%= permission.id %>" class="px-6 py-2 border border-gray-300 rounded text-gray-700 hover:bg-gray-50">
                  Cancel
                </a>
                <button type="submit" class="px-6 py-2 bg-blue-600 text-white rounded hover:bg-blue-700">
                  <i class="fas fa-save mr-2"></i>Save Changes
                </button>
              </div>
            </form>
          </div>
        </div>
      </main>
    </div>
  </div>

  <!-- Toast Container -->
  <div id="toast-container" class="fixed top-4 right-4 z-50 space-y-2"></div>

  <script>
    function showToast(message, type = 'success') {
      const container = document.getElementById('toast-container');
      const toast = document.createElement('div');
      const colors = {
        success: 'bg-green-500',
        error: 'bg-red-500',
        warning: 'bg-yellow-500',
        info: 'bg-blue-500'
      };
      const icons = {
        success: 'fa-check-circle',
        error: 'fa-times-circle',
        warning: 'fa-exclamation-triangle',
        info: 'fa-info-circle'
      };
      toast.className = `${colors[type]} text-white px-6 py-4 rounded-lg shadow-lg flex items-center space-x-3 min-w-[300px] max-w-md`;
      toast.innerHTML = `
        <i class="fas ${icons[type]} text-xl"></i>
        <span class="flex-1">${message}</span>
        <button onclick="this.parentElement.remove()" class="text-white hover:text-gray-200">
          <i class="fas fa-times"></i>
        </button>
      `;
      container.appendChild(toast);
      setTimeout(() => {
        toast.style.opacity = '0';
        setTimeout(() => toast.remove(), 300);
      }, 5000);
    }

    document.getElementById('editPermissionForm').addEventListener('submit', async (e) => {
      e.preventDefault();

      const formData = new FormData(e.target);
      const data = {
        resource: formData.get('resource'),
        action: formData.get('action'),
        description: formData.get('description')
      };

      try {
        const response = await fetch('/permissions/<%= permission.id %>/edit', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(data)
        });

        if (response.redirected) {
          showToast('Permission updated successfully', 'success');
          setTimeout(() => window.location.href = response.url, 500);
        } else if (response.ok) {
          showToast('Permission updated successfully', 'success');
          setTimeout(() => window.location.href = '/permissions/<%= permission.id %>', 1000);
        } else {
          const error = await response.json();
          showToast(error.error || 'Failed to update permission', 'error');
        }
      } catch (error) {
        console.error('Error:', error);
        showToast('Failed to update permission', 'error');
      }
    });
  </script>
</body>
</html>
