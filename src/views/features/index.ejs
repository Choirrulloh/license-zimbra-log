<!DOCTYPE html>
<html>
<head>
  <title>Features Management - License Manager</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-100">
  <div class="flex h-screen overflow-hidden">
    <%- include('../partials/sidebar', { currentPage: 'features', user: user }) %>

    <div class="flex-1 flex flex-col overflow-hidden">
      <header class="bg-white shadow-sm">
        <div class="flex items-center justify-between p-4">
          <h2 class="text-xl font-semibold text-gray-800">Features Management</h2>
          <% if (user.userRole === 'admin') { %>
            <a href="/features/create" class="bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700">
              <i class="fas fa-plus mr-2"></i>Add Feature
            </a>
          <% } %>
        </div>
      </header>

      <main class="flex-1 overflow-y-auto p-6">
        <div class="mb-6">
          <h3 class="text-2xl font-bold text-gray-800">Product Features</h3>
          <p class="text-gray-600">Master list of features available for license types</p>
        </div>

        <% if (products.length === 0) { %>
          <div class="bg-white rounded-lg shadow p-8 text-center">
            <i class="fas fa-puzzle-piece text-6xl text-gray-300 mb-4"></i>
            <p class="text-gray-500 mb-4">No products found</p>
            <a href="/products/create" class="text-blue-500 hover:text-blue-600">
              Create your first product
            </a>
          </div>
        <% } else { %>
          <div class="space-y-6">
            <% products.forEach(product => { %>
              <div class="bg-white rounded-lg shadow overflow-hidden">
                <!-- Product Header -->
                <div class="bg-gradient-to-r from-blue-600 to-blue-700 px-6 py-4">
                  <div class="flex items-center justify-between">
                    <div>
                      <h4 class="text-lg font-semibold text-white">
                        <i class="fas fa-cube mr-2"></i><%= product.name %>
                        <span class="text-blue-200 ml-2 text-sm">v<%= product.version || '1.0.0' %></span>
                      </h4>
                      <p class="text-blue-100 text-sm mt-1">
                        <%= product.features.length %> feature<%= product.features.length !== 1 ? 's' : '' %> defined
                      </p>
                    </div>
                    <% if (user.userRole === 'admin') { %>
                      <a href="/features/create?product_id=<%= product.id %>"
                         class="bg-white text-blue-600 px-4 py-2 rounded-md hover:bg-blue-50 text-sm">
                        <i class="fas fa-plus mr-2"></i>Add Feature
                      </a>
                    <% } %>
                  </div>
                </div>

                <!-- Features List -->
                <div class="p-6">
                  <% if (product.features.length === 0) { %>
                    <div class="text-center py-8 text-gray-500">
                      <i class="fas fa-inbox text-4xl mb-3 opacity-50"></i>
                      <p>No features defined for this product yet</p>
                      <% if (user.userRole === 'admin') { %>
                        <a href="/features/create?product_id=<%= product.id %>"
                           class="text-blue-500 hover:text-blue-600 text-sm mt-2 inline-block">
                          <i class="fas fa-plus-circle mr-1"></i>Add your first feature
                        </a>
                      <% } %>
                    </div>
                  <% } else { %>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                      <% product.features.forEach(feature => { %>
                        <div class="border border-gray-200 rounded-lg p-4 hover:border-blue-300 hover:shadow-md transition-all <%= feature.is_active ? '' : 'opacity-60 bg-gray-50' %>">
                          <!-- Feature Header -->
                          <div class="flex items-start justify-between mb-3">
                            <div class="flex-1">
                              <div class="flex items-center space-x-2 mb-1">
                                <h5 class="font-semibold text-gray-800"><%= feature.name %></h5>
                                <% if (!feature.is_active) { %>
                                  <span class="text-xs px-2 py-0.5 bg-gray-200 text-gray-600 rounded">Inactive</span>
                                <% } %>
                              </div>
                              <code class="text-xs text-gray-500 bg-gray-100 px-2 py-1 rounded"><%= feature.feature_key %></code>
                            </div>
                            <% if (user.userRole === 'admin') { %>
                              <div class="flex items-center space-x-1 ml-2">
                                <a href="/features/<%= feature.id %>/edit"
                                   class="text-blue-600 hover:text-blue-700 p-1" title="Edit">
                                  <i class="fas fa-edit"></i>
                                </a>
                                <button onclick="deleteFeature(<%= feature.id %>, '<%= feature.name %>')"
                                        class="text-red-600 hover:text-red-700 p-1" title="Delete">
                                  <i class="fas fa-trash"></i>
                                </button>
                              </div>
                            <% } %>
                          </div>

                          <!-- Feature Description -->
                          <% if (feature.description) { %>
                            <p class="text-sm text-gray-600 mb-3"><%= feature.description %></p>
                          <% } %>

                          <!-- Feature Metadata -->
                          <div class="pt-3 border-t border-gray-100">
                            <div class="flex items-center justify-between text-xs text-gray-500">
                              <% if (feature.category) { %>
                                <span class="px-2 py-1 bg-purple-100 text-purple-700 rounded">
                                  <%= feature.category %>
                                </span>
                              <% } else { %>
                                <span></span>
                              <% } %>
                              <span>Order: <%= feature.display_order || 0 %></span>
                            </div>
                          </div>
                        </div>
                      <% }); %>
                    </div>
                  <% } %>
                </div>
              </div>
            <% }); %>
          </div>
        <% } %>

        <!-- Info Panel -->
        <div class="mt-8 bg-blue-50 border border-blue-200 rounded-lg p-6">
          <div class="flex items-start">
            <i class="fas fa-info-circle text-blue-500 text-2xl mr-4 mt-1"></i>
            <div>
              <h4 class="font-semibold text-blue-900 mb-2">About Features</h4>
              <p class="text-blue-800 text-sm mb-3">
                Features are master data that can be assigned to multiple license types. Each feature has:
              </p>
              <ul class="text-blue-800 text-sm space-y-1 ml-4 list-disc">
                <li><strong>Name</strong>: Display name shown to users (e.g., "API Access")</li>
                <li><strong>Feature Key</strong>: Unique identifier for code integration (e.g., "api_access")</li>
                <li><strong>Description</strong>: Explains what the feature provides</li>
                <li><strong>Category</strong>: Groups related features (optional)</li>
                <li><strong>Display Order</strong>: Controls the order features appear</li>
              </ul>
              <p class="text-blue-700 text-sm mt-3">
                <strong>Tip:</strong> Create features here first, then assign them to license types when editing products.
              </p>
            </div>
          </div>
        </div>
      </main>
    </div>
  </div>

  <!-- Toast Container -->
  <div id="toast-container" class="fixed top-4 right-4 z-50 space-y-2"></div>

  <!-- Confirm Delete Modal -->
  <%- include('../partials/confirm-modal') %>

  <script>
    function showToast(message, type = 'success') {
      const container = document.getElementById('toast-container');
      const toast = document.createElement('div');

      const colors = {
        success: 'bg-green-500',
        error: 'bg-red-500',
        warning: 'bg-yellow-500',
        info: 'bg-blue-500'
      };

      const icons = {
        success: 'fa-check-circle',
        error: 'fa-times-circle',
        warning: 'fa-exclamation-triangle',
        info: 'fa-info-circle'
      };

      toast.className = `${colors[type]} text-white px-6 py-4 rounded-lg shadow-lg flex items-center space-x-3 min-w-[300px] transform transition-all duration-300`;
      toast.innerHTML = `
        <i class="fas ${icons[type]} text-xl"></i>
        <span class="flex-1">${message}</span>
        <button onclick="this.parentElement.remove()" class="text-white hover:text-gray-200">
          <i class="fas fa-times"></i>
        </button>
      `;

      container.appendChild(toast);

      setTimeout(() => {
        toast.style.opacity = '0';
        toast.style.transform = 'translateX(100%)';
        setTimeout(() => toast.remove(), 300);
      }, 5000);
    }

    function deleteFeature(featureId, featureName) {
      if (confirm(`Are you sure you want to delete the feature "${featureName}"?\n\nThis will remove it from all license types that use it.`)) {
        fetch(`/features/${featureId}`, {
          method: 'DELETE',
          headers: {
            'Content-Type': 'application/json',
          },
          credentials: 'include'
        })
        .then(response => response.json())
        .then(data => {
          if (data.success) {
            showToast('Feature deleted successfully', 'success');
            setTimeout(() => window.location.reload(), 1000);
          } else {
            showToast(data.message || 'Failed to delete feature', 'error');
          }
        })
        .catch(error => {
          console.error('Error:', error);
          showToast('An error occurred', 'error');
        });
      }
    }

    // Show success message if redirected after create/update
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('success')) {
      showToast(urlParams.get('message') || 'Operation completed successfully', 'success');
      // Clean URL
      window.history.replaceState({}, document.title, window.location.pathname);
    }
  </script>
</body>
</html>
