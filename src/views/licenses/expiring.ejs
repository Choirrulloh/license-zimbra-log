<!DOCTYPE html>
<html>
<head>
  <title>Expiring Licenses - License Manager</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-100">
  <div class="flex h-screen overflow-hidden">
    <%- include('../partials/sidebar', { currentPage: 'licenses', user: user }) %>

    <div class="flex-1 flex flex-col overflow-hidden">
      <header class="bg-white shadow-sm">
        <div class="flex items-center justify-between p-4">
          <h2 class="text-xl font-semibold text-gray-800">
            <i class="fas fa-clock text-yellow-500 mr-2"></i> License Expiry Management
          </h2>
          <a href="/licenses" class="text-gray-600 hover:text-gray-800">
            <i class="fas fa-arrow-left"></i> Back to Licenses
          </a>
        </div>
      </header>

      <main class="flex-1 overflow-y-auto p-6">
        <!-- Stats Cards -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-6">
          <div class="bg-red-50 border border-red-200 rounded-lg p-6">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-red-600 text-sm font-medium">Expired</p>
                <p class="text-3xl font-bold text-red-700"><%= stats.expired || 0 %></p>
              </div>
              <div class="bg-red-100 rounded-full p-3">
                <i class="fas fa-times-circle text-2xl text-red-500"></i>
              </div>
            </div>
          </div>

          <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-6">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-yellow-600 text-sm font-medium">Expiring in 7 days</p>
                <p class="text-3xl font-bold text-yellow-700"><%= stats.expiring_7_days || 0 %></p>
              </div>
              <div class="bg-yellow-100 rounded-full p-3">
                <i class="fas fa-exclamation-triangle text-2xl text-yellow-500"></i>
              </div>
            </div>
          </div>

          <div class="bg-orange-50 border border-orange-200 rounded-lg p-6">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-orange-600 text-sm font-medium">Expiring in 30 days</p>
                <p class="text-3xl font-bold text-orange-700"><%= stats.expiring_30_days || 0 %></p>
              </div>
              <div class="bg-orange-100 rounded-full p-3">
                <i class="fas fa-clock text-2xl text-orange-500"></i>
              </div>
            </div>
          </div>

          <div class="bg-green-50 border border-green-200 rounded-lg p-6">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-green-600 text-sm font-medium">Healthy</p>
                <p class="text-3xl font-bold text-green-700"><%= stats.healthy || 0 %></p>
              </div>
              <div class="bg-green-100 rounded-full p-3">
                <i class="fas fa-check-circle text-2xl text-green-500"></i>
              </div>
            </div>
          </div>
        </div>

        <!-- Settings & Actions -->
        <div class="bg-white rounded-lg shadow p-6 mb-6">
          <h3 class="text-lg font-semibold mb-4">
            <i class="fas fa-cog mr-2"></i> Reminder Settings
          </h3>

          <div class="grid grid-cols-1 md:grid-cols-4 gap-4 items-end">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Days Before Expiry</label>
              <input
                type="number"
                id="reminderDays"
                value="<%= settings.license_expiry_reminder_days || 7 %>"
                min="1"
                max="90"
                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
              >
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Check Time (Daily)</label>
              <input
                type="time"
                id="checkTime"
                value="<%= settings.license_expiry_check_time || '09:00' %>"
                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
              >
            </div>

            <div>
              <label class="block text-sm font-medium text-gray-700 mb-2">Auto Reminders</label>
              <select
                id="reminderEnabled"
                class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
              >
                <option value="true" <%= settings.license_expiry_reminder_enabled === 'true' ? 'selected' : '' %>>Enabled</option>
                <option value="false" <%= settings.license_expiry_reminder_enabled === 'false' ? 'selected' : '' %>>Disabled</option>
              </select>
            </div>

            <div class="flex space-x-2">
              <button
                onclick="saveSettings()"
                class="flex-1 bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded-lg"
              >
                <i class="fas fa-save mr-1"></i> Save
              </button>
              <button
                onclick="triggerCheck()"
                class="flex-1 bg-green-500 hover:bg-green-600 text-white px-4 py-2 rounded-lg"
              >
                <i class="fas fa-play mr-1"></i> Run Now
              </button>
            </div>
          </div>

          <% if (settings.license_expiry_last_run) { %>
            <p class="text-sm text-gray-500 mt-4">
              <i class="fas fa-history mr-1"></i>
              Last check: <%= moment(settings.license_expiry_last_run).tz(timezone).format('MMM D, YYYY HH:mm') %>
            </p>
          <% } %>
        </div>

        <!-- Filter -->
        <div class="bg-white rounded-lg shadow p-4 mb-6">
          <form method="GET" class="flex items-center space-x-4">
            <label class="text-sm font-medium text-gray-700">Show licenses expiring within:</label>
            <select
              name="days"
              onchange="this.form.submit()"
              class="px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
            >
              <option value="7" <%= days === 7 ? 'selected' : '' %>>7 days</option>
              <option value="14" <%= days === 14 ? 'selected' : '' %>>14 days</option>
              <option value="30" <%= days === 30 ? 'selected' : '' %>>30 days</option>
              <option value="60" <%= days === 60 ? 'selected' : '' %>>60 days</option>
              <option value="90" <%= days === 90 ? 'selected' : '' %>>90 days</option>
            </select>
          </form>
        </div>

        <!-- Expiring Licenses Table -->
        <div class="bg-white rounded-lg shadow">
          <div class="p-4 border-b">
            <h3 class="text-lg font-semibold">
              Licenses Expiring in <%= days %> Days (<%= expiringLicenses.length %>)
            </h3>
          </div>

          <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
              <thead class="bg-gray-50">
                <tr>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">License Key</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Customer</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Product</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Expiry Date</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Days Left</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Last Reminder</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Actions</th>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-200">
                <% if (expiringLicenses.length > 0) { %>
                  <% expiringLicenses.forEach(license => { %>
                    <tr class="hover:bg-gray-50">
                      <td class="px-6 py-4">
                        <a href="/licenses/<%= license.id %>" class="text-blue-600 hover:text-blue-800">
                          <code class="text-xs bg-gray-100 px-2 py-1 rounded"><%= license.license_key %></code>
                        </a>
                      </td>
                      <td class="px-6 py-4 text-sm">
                        <div><%= license.customer_name %></div>
                        <div class="text-xs text-gray-500"><%= license.customer_email %></div>
                      </td>
                      <td class="px-6 py-4 text-sm"><%= license.product_name %></td>
                      <td class="px-6 py-4 text-sm">
                        <%= moment(license.expiry_date).tz(timezone).format('MMM D, YYYY') %>
                      </td>
                      <td class="px-6 py-4">
                        <% if (license.days_remaining <= 3) { %>
                          <span class="px-2 py-1 rounded-full text-xs font-semibold bg-red-100 text-red-800">
                            <%= license.days_remaining %> days
                          </span>
                        <% } else if (license.days_remaining <= 7) { %>
                          <span class="px-2 py-1 rounded-full text-xs font-semibold bg-yellow-100 text-yellow-800">
                            <%= license.days_remaining %> days
                          </span>
                        <% } else { %>
                          <span class="px-2 py-1 rounded-full text-xs font-semibold bg-orange-100 text-orange-800">
                            <%= license.days_remaining %> days
                          </span>
                        <% } %>
                      </td>
                      <td class="px-6 py-4 text-sm text-gray-500">
                        <% if (license.last_expiry_reminder_sent) { %>
                          <%= moment(license.last_expiry_reminder_sent).tz(timezone).format('MMM D, HH:mm') %>
                        <% } else { %>
                          <span class="text-gray-400">Never</span>
                        <% } %>
                      </td>
                      <td class="px-6 py-4">
                        <a href="/licenses/<%= license.id %>" class="text-blue-600 hover:text-blue-800 mr-2">
                          <i class="fas fa-eye"></i>
                        </a>
                      </td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="7" class="px-6 py-8 text-center text-gray-500">
                      <i class="fas fa-check-circle text-4xl text-green-400 mb-2"></i>
                      <p>No licenses expiring within <%= days %> days!</p>
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </main>
    </div>
  </div>

  <%- include('../partials/toast-notification') %>

  <script>
    async function saveSettings() {
      const data = {
        reminder_days: document.getElementById('reminderDays').value,
        check_time: document.getElementById('checkTime').value,
        reminder_enabled: document.getElementById('reminderEnabled').value
      };

      try {
        const response = await fetch('/licenses/expiring/settings', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': '<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>' },
          body: JSON.stringify(data)
        });

        const result = await response.json();

        if (result.success) {
          showToast('Settings saved successfully!', 'success');
        } else {
          showToast(result.error || 'Failed to save settings', 'error');
        }
      } catch (error) {
        console.error('Error:', error);
        showToast('Failed to save settings', 'error');
      }
    }

    async function triggerCheck() {
      const confirmed = await showConfirm(
        'Run expiry check now? This will send reminder emails to customers with expiring licenses.',
        'Run Expiry Check',
        { type: 'info', confirmText: 'Run Check' }
      );
      if (!confirmed) return;

      try {
        const response = await fetch('/licenses/expiring/check', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': '<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>'
          }
        });

        const result = await response.json();

        if (result.success) {
          showToast(`Check completed: ${result.results.sent} emails sent, ${result.results.failed} failed`, 'success');
          setTimeout(() => location.reload(), 2000);
        } else {
          showToast(result.error || 'Failed to run check', 'error');
        }
      } catch (error) {
        console.error('Error:', error);
        showToast('Failed to run check', 'error');
      }
    }
  </script>
  <%- include('../partials/confirm-modal') %>
</body>
</html>
