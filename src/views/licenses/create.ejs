<!DOCTYPE html>
<html>
<head>
  <title>Create License - License Manager</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-100">
  <div class="flex h-screen overflow-hidden">
    <%- include('../partials/sidebar', { currentPage: 'licenses', user: user }) %>
    <div class="flex-1 flex flex-col overflow-hidden">
      <header class="bg-white shadow-sm">
        <div class="flex items-center justify-between p-4">
          <h2 class="text-xl font-semibold text-gray-800">Generate License</h2>
          <span class="text-sm text-gray-600"><%= moment().tz(timezone).format('dddd, MMMM D, YYYY') %></span>
        </div>
      </header>
      <main class="flex-1 overflow-y-auto p-6">
        <div class="mb-6">
          <a href="/licenses" class="text-blue-500 hover:text-blue-600">
            <i class="fas fa-arrow-left"></i> Back
          </a>
        </div>
        <div class="bg-white rounded-lg shadow p-6 max-w-2xl">
          <h3 class="text-xl font-bold mb-6">Generate New License</h3>
          <% if (error) { %>
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
              <%= error %>
            </div>
          <% } %>
          <form method="POST" action="/licenses/create">
            <div class="mb-4">
              <label class="block text-gray-700 font-medium mb-2">Product *</label>
              <select name="product_id" id="product_id" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-blue-500" onchange="loadLicenseTypes()">
                <option value="">Select Product</option>
                <% products.forEach(p => { %>
                  <option value="<%= p.id %>"><%= p.name %></option>
                <% }); %>
              </select>
            </div>
            <div class="mb-4">
              <label class="block text-gray-700 font-medium mb-2">License Type *</label>
              <select name="license_type_id" id="license_type_id" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-blue-500">
                <option value="">Select License Type</option>
              </select>
            </div>
            <div class="mb-4">
              <label class="block text-gray-700 font-medium mb-2">Customer *</label>
              <select name="customer_id" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-blue-500">
                <option value="">Select Customer</option>
                <% customers.forEach(c => { %>
                  <option value="<%= c.id %>"><%= c.name %> (<%= c.email %>)</option>
                <% }); %>
              </select>
            </div>
            <div class="mb-6">
              <label class="block text-gray-700 font-medium mb-2">Notes</label>
              <textarea name="notes" rows="3" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-blue-500"></textarea>
            </div>
            <div class="flex space-x-3">
              <button type="submit" class="bg-blue-500 hover:bg-blue-600 text-white px-6 py-2 rounded-lg">
                <i class="fas fa-key"></i> Generate License
              </button>
              <a href="/licenses" class="bg-gray-300 hover:bg-gray-400 text-gray-800 px-6 py-2 rounded-lg">Cancel</a>
            </div>
          </form>
        </div>
        <script>
          async function loadLicenseTypes() {
            const productId = document.getElementById('product_id').value;
            const select = document.getElementById('license_type_id');
            select.innerHTML = '<option value="">Select License Type</option>';
            if (!productId) return;
            const res = await fetch(`/api/products/${productId}/license-types`);
            const types = await res.json();
            types.forEach(t => {
              const opt = document.createElement('option');
              opt.value = t.id;
              const price = new Intl.NumberFormat('id-ID').format(t.price);
              opt.textContent = `${t.name} - ${t.duration_days} days - Rp ${price}`;
              select.appendChild(opt);
            });
          }
        </script>
      </main>
    </div>
  </div>
</body>
</html>
