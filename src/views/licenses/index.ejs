<!DOCTYPE html>
<html>
<head>
  <title>Licenses - License Manager</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-100">
  <%- include('../partials/toast-notification') %>
  <div class="flex h-screen overflow-hidden">
    <!-- Sidebar -->
    <%- include('../partials/sidebar', { currentPage: 'licenses', user: user }) %>

    <!-- Main Content -->
    <div class="flex-1 flex flex-col overflow-hidden">
      <header class="bg-white shadow-sm">
        <div class="flex items-center justify-between p-4">
          <h2 class="text-xl font-semibold text-gray-800">Licenses</h2>
          <span class="text-sm text-gray-600"><%= moment().tz(timezone).format('dddd, MMMM D, YYYY') %></span>
        </div>
      </header>

      <main class="flex-1 overflow-y-auto p-6">
        <div class="mb-6 flex justify-between items-center">
          <div>
            <h3 class="text-2xl font-bold text-gray-800">Licenses</h3>
          </div>
          <a href="/licenses/create" class="bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded-lg">
            <i class="fas fa-plus"></i> Generate License
          </a>
        </div>

        <!-- Tabs -->
        <div class="mb-4 border-b border-gray-200">
          <nav class="-mb-px flex space-x-8">
            <a href="/licenses?tab=licenses" class="<%= (!filters.tab || filters.tab === 'licenses') ? 'border-blue-500 text-blue-600' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300' %> whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm">
              <i class="fas fa-key mr-2"></i> All Licenses
            </a>
            <a href="/licenses?tab=renewals" class="<%= filters.tab === 'renewals' ? 'border-blue-500 text-blue-600' : 'border-transparent text-gray-500 hover:text-gray-700 hover:border-gray-300' %> whitespace-nowrap py-4 px-1 border-b-2 font-medium text-sm">
              <i class="fas fa-sync mr-2"></i> Renewal Requests
              <% if (typeof renewalCount !== 'undefined' && renewalCount > 0) { %>
                <span class="ml-2 bg-red-100 text-red-800 text-xs font-semibold px-2.5 py-0.5 rounded-full"><%= renewalCount %></span>
              <% } %>
            </a>
          </nav>
        </div>

        <!-- Licenses Tab Content -->
        <% if (!filters.tab || filters.tab === 'licenses') { %>
          <div class="bg-white rounded-lg shadow overflow-hidden">
            <table class="min-w-full divide-y divide-gray-200">
              <thead class="bg-gray-50">
                <tr>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">License Key</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Product</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Customer</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Type</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Expiry</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Actions</th>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-200">
                <% if (licenses.length > 0) { %>
                  <% licenses.forEach(l => { %>
                    <tr class="hover:bg-gray-50">
                      <td class="px-6 py-4">
                        <code class="text-xs bg-gray-100 px-2 py-1 rounded"><%= l.license_key %></code>
                      </td>
                      <td class="px-6 py-4 text-sm"><%= l.product_name %></td>
                      <td class="px-6 py-4 text-sm"><%= l.customer_name %></td>
                      <td class="px-6 py-4 text-sm"><%= l.license_type_name %></td>
                      <td class="px-6 py-4">
                        <span class="px-2 py-1 rounded-full text-xs font-semibold <%= l.status === 'active' ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>">
                          <%= l.status %>
                        </span>
                      </td>
                      <td class="px-6 py-4 text-sm">
                        <%= l.expiry_date ? moment(l.expiry_date).tz(timezone).format('MMM D, YYYY') : 'Never' %>
                      </td>
                      <td class="px-6 py-4 text-sm space-x-2">
                        <a href="/licenses/<%= l.id %>" class="text-blue-600 hover:text-blue-900">
                          <i class="fas fa-eye"></i>
                        </a>
                      </td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="7" class="px-6 py-10 text-center text-gray-500">
                      No licenses found
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        <% } %>

        <!-- Renewal Requests Tab Content -->
        <% if (filters.tab === 'renewals') { %>
          <div class="bg-white rounded-lg shadow overflow-hidden">
            <!-- Filter buttons -->
            <div class="p-4 border-b flex space-x-2">
              <a href="/licenses?tab=renewals&renewal_status=pending" class="px-4 py-2 rounded <%= !filters.renewal_status || filters.renewal_status === 'pending' ? 'bg-blue-100 text-blue-700 font-semibold' : 'bg-gray-100 text-gray-600 hover:bg-gray-200' %>">
                <i class="fas fa-clock mr-1"></i> Pending
              </a>
              <a href="/licenses?tab=renewals&renewal_status=approved" class="px-4 py-2 rounded <%= filters.renewal_status === 'approved' ? 'bg-blue-100 text-blue-700 font-semibold' : 'bg-gray-100 text-gray-600 hover:bg-gray-200' %>">
                <i class="fas fa-check-circle mr-1"></i> Approved
              </a>
              <a href="/licenses?tab=renewals&renewal_status=rejected" class="px-4 py-2 rounded <%= filters.renewal_status === 'rejected' ? 'bg-blue-100 text-blue-700 font-semibold' : 'bg-gray-100 text-gray-600 hover:bg-gray-200' %>">
                <i class="fas fa-times-circle mr-1"></i> Rejected
              </a>
            </div>

            <table class="min-w-full divide-y divide-gray-200">
              <thead class="bg-gray-50">
                <tr>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">License Key</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Customer</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Product</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Requested</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Actions</th>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-200">
                <% if (typeof renewals !== 'undefined' && renewals.length > 0) { %>
                  <% renewals.forEach(r => { %>
                    <tr class="hover:bg-gray-50">
                      <td class="px-6 py-4">
                        <code class="text-xs bg-gray-100 px-2 py-1 rounded"><%= r.license_key %></code>
                      </td>
                      <td class="px-6 py-4 text-sm">
                        <div><%= r.customer_name %></div>
                        <div class="text-xs text-gray-500"><%= r.customer_email %></div>
                      </td>
                      <td class="px-6 py-4 text-sm"><%= r.product_name %></td>
                      <td class="px-6 py-4 text-sm">
                        <%= moment(r.requested_at).tz(timezone).format('MMM D, YYYY HH:mm') %>
                      </td>
                      <td class="px-6 py-4">
                        <span class="px-2 py-1 rounded-full text-xs font-semibold <%= r.status === 'pending' ? 'bg-yellow-100 text-yellow-800' : r.status === 'approved' ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>">
                          <%= r.status %>
                        </span>
                      </td>
                      <td class="px-6 py-4 text-sm space-x-2">
                        <% if (r.status === 'pending') { %>
                          <button onclick="approveRenewal(<%= r.id %>)" class="text-green-600 hover:text-green-900" title="Approve">
                            <i class="fas fa-check"></i>
                          </button>
                          <button onclick="rejectRenewal(<%= r.id %>)" class="text-red-600 hover:text-red-900" title="Reject">
                            <i class="fas fa-times"></i>
                          </button>
                        <% } else if (r.status === 'approved') { %>
                          <span class="text-xs text-gray-500">
                            Approved <%= moment(r.approved_at).tz(timezone).format('MMM D, YYYY') %>
                          </span>
                        <% } else { %>
                          <button onclick="viewRejectionReason('<%= r.rejected_reason ? r.rejected_reason.replace(/'/g, "\\'") : 'No reason provided' %>')" class="text-blue-600 hover:text-blue-900" title="View Reason">
                            <i class="fas fa-info-circle"></i>
                          </button>
                        <% } %>
                      </td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="6" class="px-6 py-10 text-center text-gray-500">
                      No renewal requests found
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        <% } %>
      </main>
    </div>
  </div>

  <script>
    const csrfToken = '<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>';

    async function approveRenewal(renewalId) {
      const confirmed = await showConfirm(
        'Are you sure you want to approve this renewal request? The license expiry date will be extended.',
        'Confirm Approval',
        { type: 'info', confirmText: 'Approve' }
      );
      if (!confirmed) return;

      try {
        const response = await fetch(`/licenses/renewals/${renewalId}/approve`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': csrfToken
          }
        });

        const data = await response.json();

        if (data.success) {
          showToast('Renewal request approved successfully!', 'success');
          setTimeout(() => window.location.reload(), 1000);
        } else {
          showToast(data.error || 'Failed to approve renewal request', 'error');
        }
      } catch (error) {
        console.error('Error approving renewal:', error);
        showToast('Failed to approve renewal request', 'error');
      }
    }

    async function rejectRenewal(renewalId) {
      const reason = await showPrompt('Please enter a reason for rejection:', 'Reject Renewal', 'Enter reason...');
      if (reason === null) return;

      if (!reason || reason.trim() === '') {
        showToast('Rejection reason is required', 'warning');
        return;
      }

      try {
        const response = await fetch(`/licenses/renewals/${renewalId}/reject`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': csrfToken
          },
          body: JSON.stringify({ reason: reason.trim() })
        });

        const data = await response.json();

        if (data.success) {
          showToast('Renewal request rejected', 'success');
          setTimeout(() => window.location.reload(), 1000);
        } else {
          showToast(data.error || 'Failed to reject renewal request', 'error');
        }
      } catch (error) {
        console.error('Error rejecting renewal:', error);
        showToast('Failed to reject renewal request', 'error');
      }
    }

    function viewRejectionReason(reason) {
      // Create modal to show rejection reason
      const modal = document.createElement('div');
      modal.className = 'fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50';
      modal.innerHTML = `
        <div class="bg-white rounded-lg shadow-xl max-w-md w-full mx-4 p-6">
          <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-semibold text-gray-800"><i class="fas fa-info-circle text-red-500 mr-2"></i>Rejection Reason</h3>
            <button onclick="this.closest('.fixed').remove()" class="text-gray-400 hover:text-gray-600">
              <i class="fas fa-times"></i>
            </button>
          </div>
          <p class="text-gray-600 whitespace-pre-wrap">${reason}</p>
          <div class="mt-4 text-right">
            <button onclick="this.closest('.fixed').remove()" class="bg-gray-500 hover:bg-gray-600 text-white px-4 py-2 rounded-lg">Close</button>
          </div>
        </div>
      `;
      document.body.appendChild(modal);
      modal.addEventListener('click', (e) => { if (e.target === modal) modal.remove(); });
    }
  </script>
  <%- include('../partials/confirm-modal') %>
  <%- include('../partials/prompt-modal') %>
</body>
</html>
