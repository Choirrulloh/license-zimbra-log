<!DOCTYPE html>
<html>
<head>
  <title><%= error %> - License Manager</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-100">
  <div class="min-h-screen flex items-center justify-center p-4">
    <div class="bg-white rounded-lg shadow-lg p-8 max-w-md w-full text-center">
      <div class="mb-6">
        <i class="fas fa-exclamation-triangle text-6xl text-red-500"></i>
      </div>

      <h1 class="text-3xl font-bold text-gray-800 mb-4">
        <%= typeof error !== 'undefined' ? error : 'Error' %>
      </h1>

      <p class="text-gray-600 mb-6">
        <%= typeof message !== 'undefined' ? message : 'An error occurred. Please try again later.' %>
      </p>

      <div class="flex space-x-3 justify-center">
        <% if (typeof user !== 'undefined' && user && user.userId) { %>
          <a href="/dashboard" class="bg-blue-500 hover:bg-blue-600 text-white px-6 py-2 rounded-lg inline-flex items-center">
            <i class="fas fa-home mr-2"></i>
            Go to Dashboard
          </a>
          <button onclick="history.back()" class="bg-gray-300 hover:bg-gray-400 text-gray-800 px-6 py-2 rounded-lg inline-flex items-center">
            <i class="fas fa-arrow-left mr-2"></i>
            Go Back
          </button>
        <% } else { %>
          <a href="/login" class="bg-blue-500 hover:bg-blue-600 text-white px-6 py-2 rounded-lg inline-flex items-center">
            <i class="fas fa-sign-in-alt mr-2"></i>
            Login
          </a>
        <% } %>
      </div>
    </div>
  </div>
</body>
</html>
