<!DOCTYPE html>
<html>
<head>
  <title><%= customer.name %> - License Manager</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-100">
  <div class="flex h-screen overflow-hidden">
    <%- include('../partials/sidebar', { currentPage: 'customers', user: user }) %>
    <div class="flex-1 flex flex-col overflow-hidden">
      <header class="bg-white shadow-sm">
        <div class="flex items-center justify-between p-4">
          <h2 class="text-xl font-semibold text-gray-800"><%= customer.name %></h2>
          <span class="text-sm text-gray-600"><%= moment().tz(timezone).format('dddd, MMMM D, YYYY') %></span>
        </div>
      </header>
      <main class="flex-1 overflow-y-auto p-6">
        <div class="mb-6 flex justify-between items-center">
          <a href="/customers" class="text-blue-500 hover:text-blue-600"><i class="fas fa-arrow-left"></i> Back</a>
          <div class="space-x-2">
            <% if (customer.password) { %>
              <button
                onclick="loginAsCustomer(<%= customer.id %>)"
                class="bg-purple-600 hover:bg-purple-700 text-white px-4 py-2 rounded-lg"
              >
                <i class="fas fa-sign-in-alt"></i> Login as Customer
              </button>
            <% } %>
            <button
              onclick="openChangePasswordModal(<%= customer.id %>)"
              class="bg-yellow-600 hover:bg-yellow-700 text-white px-4 py-2 rounded-lg"
            >
              <i class="fas fa-key"></i> Change Password
            </button>
            <a href="/customers/<%= customer.id %>/edit" class="bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded-lg">
              <i class="fas fa-edit"></i> Edit Customer
            </a>
          </div>
        </div>

        <!-- Stats -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
          <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-gray-500 text-sm">Total Licenses</p>
                <p class="text-3xl font-bold text-gray-800"><%= stats.total_licenses %></p>
              </div>
              <div class="bg-blue-100 rounded-full p-3">
                <i class="fas fa-certificate text-2xl text-blue-500"></i>
              </div>
            </div>
          </div>
          <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-gray-500 text-sm">Active Licenses</p>
                <p class="text-3xl font-bold text-green-600"><%= stats.active_licenses %></p>
              </div>
              <div class="bg-green-100 rounded-full p-3">
                <i class="fas fa-check-circle text-2xl text-green-500"></i>
              </div>
            </div>
          </div>
          <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-gray-500 text-sm">Total Spent</p>
                <p class="text-2xl font-bold text-yellow-600">Rp <%= new Intl.NumberFormat('id-ID').format(stats.total_spent) %></p>
              </div>
              <div class="bg-yellow-100 rounded-full p-3">
                <i class="fas fa-money-bill-wave text-2xl text-yellow-500"></i>
              </div>
            </div>
          </div>
        </div>

        <!-- Customer Portal Info -->
        <div class="bg-white rounded-lg shadow p-6 mb-6">
          <h3 class="text-lg font-semibold mb-4">
            <i class="fas fa-user-circle text-purple-600 mr-2"></i> Customer Portal Access
          </h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <!-- License Quota -->
            <div>
              <div class="flex justify-between items-center mb-2">
                <p class="text-sm text-gray-600">License Quota</p>
                <p class="text-lg font-bold <%= customer.license_limit > 0 && customer.license_used >= customer.license_limit ? 'text-red-600' : 'text-blue-600' %>">
                  <%= customer.license_used %>/<%= customer.license_limit === 0 ? '∞' : customer.license_limit %>
                </p>
              </div>
              <div class="w-full bg-gray-200 rounded-full h-3">
                <%
                  const licensePercent = customer.license_limit === 0 ? 0 : Math.min((customer.license_used / customer.license_limit) * 100, 100);
                  const licenseColor = licensePercent >= 90 ? 'bg-red-600' : licensePercent >= 70 ? 'bg-yellow-600' : 'bg-blue-600';
                %>
                <div class="<%= licenseColor %> h-3 rounded-full" style="width: <%= licensePercent %>%"></div>
              </div>
              <p class="text-xs text-gray-500 mt-1">
                <% if (customer.license_limit === 0) { %>
                  Unlimited licenses
                <% } else { %>
                  <%= customer.license_limit - customer.license_used %> remaining
                <% } %>
              </p>
            </div>

            <!-- Code Protection Quota -->
            <div>
              <div class="flex justify-between items-center mb-2">
                <p class="text-sm text-gray-600">Code Protection Quota</p>
                <p class="text-lg font-bold <%= customer.code_protection_limit > 0 && customer.code_protection_used >= customer.code_protection_limit ? 'text-red-600' : 'text-purple-600' %>">
                  <%= customer.code_protection_used %>/<%= customer.code_protection_limit === 0 ? '∞' : customer.code_protection_limit %>
                </p>
              </div>
              <div class="w-full bg-gray-200 rounded-full h-3">
                <%
                  const codePercent = customer.code_protection_limit === 0 ? 0 : Math.min((customer.code_protection_used / customer.code_protection_limit) * 100, 100);
                  const codeColor = codePercent >= 90 ? 'bg-red-600' : codePercent >= 70 ? 'bg-yellow-600' : 'bg-purple-600';
                %>
                <div class="<%= codeColor %> h-3 rounded-full" style="width: <%= codePercent %>%"></div>
              </div>
              <p class="text-xs text-gray-500 mt-1">
                <% if (customer.code_protection_limit === 0) { %>
                  Unlimited code protections
                <% } else { %>
                  <%= customer.code_protection_limit - customer.code_protection_used %> remaining
                <% } %>
              </p>
            </div>
          </div>

          <div class="mt-4 pt-4 border-t grid grid-cols-1 md:grid-cols-3 gap-4 text-sm">
            <div>
              <p class="text-gray-600">Portal Status:</p>
              <p class="font-semibold <%= customer.password ? 'text-green-600' : 'text-red-600' %>">
                <i class="fas <%= customer.password ? 'fa-check-circle' : 'fa-times-circle' %>"></i>
                <%= customer.password ? 'Active' : 'Not Configured' %>
              </p>
            </div>
            <div>
              <p class="text-gray-600">Last Login:</p>
              <p class="font-semibold">
                <% if (customer.last_login) { %>
                  <%= moment(customer.last_login).tz(timezone).format('MMM D, HH:mm') %>
                <% } else { %>
                  <span class="text-gray-400">Never</span>
                <% } %>
              </p>
            </div>
            <div>
              <p class="text-gray-600">Must Change Password:</p>
              <p class="font-semibold <%= customer.must_change_password ? 'text-yellow-600' : 'text-gray-600' %>">
                <%= customer.must_change_password ? 'Yes' : 'No' %>
              </p>
            </div>
          </div>
        </div>

        <!-- Customer Info -->
        <div class="bg-white rounded-lg shadow p-6 mb-6">
          <h3 class="text-lg font-semibold mb-4">Customer Information</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <p class="text-sm text-gray-500">Name</p>
              <p class="font-medium"><%= customer.name %></p>
            </div>
            <div>
              <p class="text-sm text-gray-500">Email</p>
              <p class="font-medium"><%= customer.email %></p>
            </div>
            <div>
              <p class="text-sm text-gray-500">Company</p>
              <p class="font-medium"><%= customer.company || '-' %></p>
            </div>
            <div>
              <p class="text-sm text-gray-500">Phone</p>
              <p class="font-medium"><%= customer.phone || '-' %></p>
            </div>
            <div class="md:col-span-2">
              <p class="text-sm text-gray-500">Address</p>
              <p class="font-medium"><%= customer.address || '-' %></p>
            </div>
            <div>
              <p class="text-sm text-gray-500">Status</p>
              <span class="px-2 py-1 rounded-full text-xs font-semibold <%= customer.is_active ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>">
                <%= customer.is_active ? 'Active' : 'Inactive' %>
              </span>
            </div>
            <div>
              <p class="text-sm text-gray-500">Member Since</p>
              <p class="font-medium"><%= moment(customer.created_at).tz(timezone).format('MMM D, YYYY') %></p>
            </div>
          </div>
        </div>

        <!-- Licenses -->
        <div class="bg-white rounded-lg shadow p-6 mb-6">
          <h3 class="text-lg font-semibold mb-4">Licenses (<%= licenses.length %>)</h3>
          <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
              <thead class="bg-gray-50">
                <tr>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">License Key</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Product</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Type</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Expiry</th>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-200">
                <% if (licenses.length > 0) { %>
                  <% licenses.forEach(l => { %>
                    <tr class="hover:bg-gray-50">
                      <td class="px-6 py-4"><code class="text-xs bg-gray-100 px-2 py-1 rounded"><%= l.license_key %></code></td>
                      <td class="px-6 py-4 text-sm"><%= l.product_name %></td>
                      <td class="px-6 py-4 text-sm"><%= l.license_type_name %></td>
                      <td class="px-6 py-4">
                        <span class="px-2 py-1 rounded-full text-xs font-semibold <%= l.status === 'active' ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>">
                          <%= l.status %>
                        </span>
                      </td>
                      <td class="px-6 py-4 text-sm"><%= l.expiry_date ? moment(l.expiry_date).tz(timezone).format('MMM D, YYYY') : 'Never' %></td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr><td colspan="5" class="px-6 py-4 text-center text-gray-500">No licenses</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Transactions -->
        <div class="bg-white rounded-lg shadow p-6">
          <h3 class="text-lg font-semibold mb-4">Transactions (<%= transactions.length %>)</h3>
          <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
              <thead class="bg-gray-50">
                <tr>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Date</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Product</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">License Key</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Amount</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-200">
                <% if (transactions.length > 0) { %>
                  <% transactions.forEach(t => { %>
                    <tr>
                      <td class="px-6 py-4 text-sm"><%= moment(t.transaction_date).tz(timezone).format('MMM D, YYYY') %></td>
                      <td class="px-6 py-4 text-sm"><%= t.product_name %></td>
                      <td class="px-6 py-4"><code class="text-xs bg-gray-100 px-2 py-1 rounded"><%= t.license_key %></code></td>
                      <td class="px-6 py-4 text-sm font-medium">Rp <%= new Intl.NumberFormat('id-ID').format(t.amount) %></td>
                      <td class="px-6 py-4">
                        <span class="px-2 py-1 rounded-full text-xs font-semibold bg-green-100 text-green-800">
                          <%= t.status %>
                        </span>
                      </td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr><td colspan="5" class="px-6 py-4 text-center text-gray-500">No transactions</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </main>
    </div>
  </div>

  <%- include('../partials/toast-notification') %>

  <!-- Change Password Modal -->
  <div id="changePasswordModal" class="hidden fixed inset-0 bg-gray-900 bg-opacity-50 flex items-center justify-center z-50">
    <div class="bg-white rounded-lg shadow-xl max-w-md w-full mx-4">
      <div class="bg-yellow-600 text-white p-4 rounded-t-lg">
        <h3 class="text-lg font-semibold">
          <i class="fas fa-key mr-2"></i>Change Customer Password
        </h3>
      </div>
      <form id="changePasswordForm" class="p-6">
        <input type="hidden" id="customerId" value="<%= customer.id %>">

        <div class="mb-4">
          <label class="block text-sm font-medium text-gray-700 mb-2">New Password</label>
          <div class="flex space-x-2">
            <input
              type="password"
              id="newPassword"
              required
              minlength="12"
              class="flex-1 px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-yellow-500"
              placeholder="Enter new password (min 12 characters)"
            >
            <button type="button" onclick="generateCustomerPassword()" class="bg-purple-500 hover:bg-purple-600 text-white px-3 py-2 rounded-lg">
              <i class="fas fa-magic"></i>
            </button>
          </div>
          <p class="text-xs text-gray-500 mt-1">Min 12 chars with uppercase, lowercase, number & special char</p>
        </div>

        <div class="mb-6">
          <label class="block text-sm font-medium text-gray-700 mb-2">Confirm Password</label>
          <input
            type="password"
            id="confirmPassword"
            required
            minlength="12"
            class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-yellow-500"
            placeholder="Confirm new password"
          >
        </div>

        <div class="flex justify-end space-x-2">
          <button
            type="button"
            onclick="closeChangePasswordModal()"
            class="px-4 py-2 text-gray-700 bg-gray-200 rounded-lg hover:bg-gray-300"
          >
            Cancel
          </button>
          <button
            type="submit"
            class="px-4 py-2 text-white bg-yellow-600 rounded-lg hover:bg-yellow-700"
          >
            <i class="fas fa-check mr-1"></i>Change Password
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    async function loginAsCustomer(customerId) {
      if (!confirm('Login as this customer? You will be redirected to the customer portal.')) {
        return;
      }

      try {
        const response = await fetch(`/customers/${customerId}/login-as`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': '<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>'
          }
        });

        const data = await response.json();

        if (data.success) {
          window.open(data.url, '_blank');
          showToast('Customer portal opened in new tab', 'success');
        } else {
          showToast(data.error || 'Failed to login as customer', 'error');
        }
      } catch (error) {
        console.error('Error:', error);
        showToast('Failed to login as customer', 'error');
      }
    }

    function openChangePasswordModal(customerId) {
      document.getElementById('customerId').value = customerId;
      document.getElementById('newPassword').value = '';
      document.getElementById('confirmPassword').value = '';
      document.getElementById('changePasswordModal').classList.remove('hidden');
    }

    function closeChangePasswordModal() {
      document.getElementById('changePasswordModal').classList.add('hidden');
    }

    function generateCustomerPassword() {
      const uppercase = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
      const lowercase = 'abcdefghijklmnopqrstuvwxyz';
      const numbers = '0123456789';
      const special = '!@#$%^&*(),.?":{}|<>';

      let password = '';
      password += uppercase[Math.floor(Math.random() * uppercase.length)];
      password += lowercase[Math.floor(Math.random() * lowercase.length)];
      password += numbers[Math.floor(Math.random() * numbers.length)];
      password += special[Math.floor(Math.random() * special.length)];

      const allChars = uppercase + lowercase + numbers + special;
      for (let i = password.length; i < 16; i++) {
        password += allChars[Math.floor(Math.random() * allChars.length)];
      }

      password = password.split('').sort(() => Math.random() - 0.5).join('');

      const newField = document.getElementById('newPassword');
      const confirmField = document.getElementById('confirmPassword');
      newField.type = 'text';
      confirmField.type = 'text';
      newField.value = password;
      confirmField.value = password;

      navigator.clipboard.writeText(password).then(() => {
        showToast('Password generated and copied!', 'success');
      }).catch(() => {
        showToast('Password generated!', 'info');
      });

      setTimeout(() => {
        newField.type = 'password';
        confirmField.type = 'password';
      }, 10000);
    }

    document.getElementById('changePasswordForm').addEventListener('submit', async function(e) {
      e.preventDefault();

      const customerId = document.getElementById('customerId').value;
      const newPassword = document.getElementById('newPassword').value;
      const confirmPassword = document.getElementById('confirmPassword').value;

      // Validate passwords match
      if (newPassword !== confirmPassword) {
        showToast('Passwords do not match', 'error');
        return;
      }

      // Validate minimum length
      if (newPassword.length < 8) {
        showToast('Password must be at least 8 characters', 'error');
        return;
      }

      try {
        const response = await fetch(`/customers/${customerId}/change-password`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': '<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>'
          },
          body: JSON.stringify({ newPassword })
        });

        const data = await response.json();

        if (data.success) {
          showToast(data.message || 'Password changed successfully', 'success');
          closeChangePasswordModal();
          // Reload page to update "Must Change Password" status
          setTimeout(() => window.location.reload(), 1500);
        } else {
          showToast(data.error || 'Failed to change password', 'error');
        }
      } catch (error) {
        console.error('Error:', error);
        showToast('Failed to change password', 'error');
      }
    });

    // Close modal on ESC key
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape') {
        closeChangePasswordModal();
      }
    });
  </script>
</body>
</html>
