<!DOCTYPE html>
<html>
<head>
  <title>Customers - License Manager</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-100">
  <div class="flex h-screen overflow-hidden">
    <aside class="w-64 bg-gray-800 text-white flex-shrink-0">
      <div class="p-4">
        <h1 class="text-2xl font-bold mb-8"><i class="fas fa-key"></i> License Manager</h1>
        <nav class="space-y-2">
          <a href="/dashboard" class="flex items-center space-x-3 p-3 rounded hover:bg-gray-700"><i class="fas fa-chart-line w-5"></i><span>Dashboard</span></a>
          <a href="/products" class="flex items-center space-x-3 p-3 rounded hover:bg-gray-700"><i class="fas fa-box w-5"></i><span>Products</span></a>
          <a href="/customers" class="flex items-center space-x-3 p-3 rounded bg-gray-700"><i class="fas fa-users w-5"></i><span>Customers</span></a>
          <a href="/licenses" class="flex items-center space-x-3 p-3 rounded hover:bg-gray-700"><i class="fas fa-certificate w-5"></i><span>Licenses</span></a>
          <a href="/features" class="flex items-center space-x-3 p-3 rounded hover:bg-gray-700"><i class="fas fa-puzzle-piece w-5"></i><span>Features</span></a>
          <a href="/users" class="flex items-center space-x-3 p-3 rounded hover:bg-gray-700"><i class="fas fa-user-shield w-5"></i><span>Users</span></a>
          <a href="/roles" class="flex items-center space-x-3 p-3 rounded hover:bg-gray-700"><i class="fas fa-user-tag w-5"></i><span>Roles & Permissions</span></a>
          <a href="/reports" class="flex items-center space-x-3 p-3 rounded hover:bg-gray-700"><i class="fas fa-file-alt w-5"></i><span>Reports</span></a>
          <a href="/docs" class="flex items-center space-x-3 p-3 rounded hover:bg-gray-700"><i class="fas fa-book w-5"></i><span>API Docs</span></a>
          <a href="/settings" class="flex items-center space-x-3 p-3 rounded hover:bg-gray-700"><i class="fas fa-cog w-5"></i><span>Settings</span></a>
        </nav>
      </div>
      <div class="absolute bottom-0 w-64 p-4 bg-gray-900">
        <div class="flex items-center space-x-3">
          <div class="w-10 h-10 rounded-full bg-gray-700 flex items-center justify-center"><i class="fas fa-user"></i></div>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-medium truncate"><%= user.userName || 'Admin' %></p>
            <p class="text-xs text-gray-400 truncate"><%= user.userEmail || '' %></p>
          </div>
          <a href="/logout" class="text-gray-400 hover:text-white"><i class="fas fa-sign-out-alt"></i></a>
        </div>
      </div>
    </aside>
    <div class="flex-1 flex flex-col overflow-hidden">
      <header class="bg-white shadow-sm">
        <div class="flex items-center justify-between p-4">
          <h2 class="text-xl font-semibold text-gray-800">Customers</h2>
          <span class="text-sm text-gray-600"><%= moment().format('dddd, MMMM D, YYYY') %></span>
        </div>
      </header>
      <main class="flex-1 overflow-y-auto p-6">
        <div class="mb-6 flex justify-between items-center">
          <div>
            <h3 class="text-2xl font-bold text-gray-800">Customers</h3>
            <p class="text-gray-600">Manage your customers</p>
          </div>
          <a href="/customers/create" class="bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded-lg">
            <i class="fas fa-plus"></i> Add Customer
          </a>
        </div>
        <div class="bg-white rounded-lg shadow overflow-hidden">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Name</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Email</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Company</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Licenses</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Revenue</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Actions</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <% if (customers.length > 0) { %>
                <% customers.forEach(c => { %>
                  <tr class="hover:bg-gray-50">
                    <td class="px-6 py-4">
                      <div class="font-medium text-gray-900"><%= c.name %></div>
                    </td>
                    <td class="px-6 py-4 text-sm text-gray-500"><%= c.email %></td>
                    <td class="px-6 py-4 text-sm text-gray-500"><%= c.company || '-' %></td>
                    <td class="px-6 py-4">
                      <span class="text-sm">
                        <span class="font-medium text-green-600"><%= c.active_licenses %></span> / <%= c.total_licenses %>
                      </span>
                    </td>
                    <td class="px-6 py-4 text-sm font-medium">Rp <%= new Intl.NumberFormat('id-ID').format(c.total_revenue || 0) %></td>
                    <td class="px-6 py-4 text-sm font-medium space-x-2">
                      <a href="/customers/<%= c.id %>" class="text-blue-600 hover:text-blue-900"><i class="fas fa-eye"></i></a>
                      <a href="/customers/<%= c.id %>/edit" class="text-yellow-600 hover:text-yellow-900"><i class="fas fa-edit"></i></a>
                      <a href="#" onclick="deleteCustomer(<%= c.id %>); return false;" class="text-red-600 hover:text-red-900"><i class="fas fa-trash"></i></a>
                    </td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="6" class="px-6 py-10 text-center text-gray-500">No customers found</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
        <script>
          async function deleteCustomer(id) {
            const confirmed = await showConfirm(
              'Are you sure you want to delete this customer? This action cannot be undone.',
              'Confirm Deletion',
              { type: 'delete', confirmText: 'Delete' }
            );
            if (!confirmed) return;

            try {
              const res = await fetch(`/customers/${id}`, { method: 'DELETE' });
              const data = await res.json();
              if (data.success) {
                showToast('Customer deleted successfully!', 'success');
                setTimeout(() => location.reload(), 1000);
              } else {
                showToast(data.message, 'error');
              }
            } catch (e) {
              showToast('Error deleting customer', 'error');
            }
          }
        </script>
      </main>
    </div>
  </div>
  <%- include('../partials/confirm-modal') %>
</body>
</html>
