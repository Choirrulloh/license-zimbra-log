<!DOCTYPE html>
<html>
<head>
  <title>Create Customer - License Manager</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-100">
  <div class="flex h-screen overflow-hidden">
    <%- include('../partials/sidebar', { currentPage: 'customers', user: user }) %>
    <div class="flex-1 flex flex-col overflow-hidden">
      <header class="bg-white shadow-sm">
        <div class="flex items-center justify-between p-4">
          <h2 class="text-xl font-semibold text-gray-800">Create Customer</h2>
          <span class="text-sm text-gray-600"><%= moment().tz(timezone).format('dddd, MMMM D, YYYY') %></span>
        </div>
      </header>
      <main class="flex-1 overflow-y-auto p-6">
        <div class="mb-6">
          <a href="/customers" class="text-blue-500 hover:text-blue-600"><i class="fas fa-arrow-left"></i> Back</a>
        </div>
        <div class="bg-white rounded-lg shadow p-6 max-w-2xl">
          <h3 class="text-xl font-bold mb-6">Create New Customer</h3>
          <% if (error) { %>
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4"><%= error %></div>
          <% } %>
          <form method="POST" action="/customers/create">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
              <div>
                <label class="block text-gray-700 font-medium mb-2">Name *</label>
                <input type="text" name="name" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-blue-500">
              </div>
              <div>
                <label class="block text-gray-700 font-medium mb-2">Email *</label>
                <input type="email" name="email" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-blue-500">
              </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
              <div>
                <label class="block text-gray-700 font-medium mb-2">Company</label>
                <input type="text" name="company" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-blue-500">
              </div>
              <div>
                <label class="block text-gray-700 font-medium mb-2">Phone</label>
                <input type="text" name="phone" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-blue-500">
              </div>
            </div>
            <div class="mb-6">
              <label class="block text-gray-700 font-medium mb-2">Address</label>
              <textarea name="address" rows="3" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-blue-500"></textarea>
            </div>

            <!-- Customer Portal Settings -->
            <div class="border-t pt-6 mb-6">
              <h4 class="text-lg font-semibold text-gray-800 mb-4">
                <i class="fas fa-cog text-blue-600 mr-2"></i> Customer Portal Settings
              </h4>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                <div>
                  <label class="block text-gray-700 font-medium mb-2">
                    <i class="fas fa-key mr-1"></i> License Limit
                  </label>
                  <input
                    type="number"
                    name="license_limit"
                    min="0"
                    value="0"
                    class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-blue-500"
                  />
                  <p class="text-xs text-gray-500 mt-1">
                    <i class="fas fa-info-circle"></i> Set to 0 for unlimited licenses
                  </p>
                </div>

                <div>
                  <label class="block text-gray-700 font-medium mb-2">
                    <i class="fas fa-shield-alt mr-1"></i> Code Protection Limit
                  </label>
                  <input
                    type="number"
                    name="code_protection_limit"
                    min="0"
                    value="0"
                    class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-blue-500"
                  />
                  <p class="text-xs text-gray-500 mt-1">
                    <i class="fas fa-info-circle"></i> Set to 0 for unlimited code protections
                  </p>
                </div>
              </div>

              <!-- Product Access -->
              <div class="mb-4">
                <label class="block text-gray-700 font-medium mb-2">
                  <i class="fas fa-box mr-1"></i> Product Access (Can Generate Licenses)
                </label>
                <div class="bg-gray-50 border border-gray-300 rounded-lg p-4 max-h-48 overflow-y-auto">
                  <% if (products && products.length > 0) { %>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
                      <% products.forEach(product => { %>
                        <label class="flex items-center space-x-2 p-2 hover:bg-gray-100 rounded cursor-pointer">
                          <input
                            type="checkbox"
                            name="product_access"
                            value="<%= product.id %>"
                            class="w-4 h-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500"
                          />
                          <span class="text-sm text-gray-700"><%= product.name %></span>
                        </label>
                      <% }) %>
                    </div>
                  <% } else { %>
                    <p class="text-sm text-gray-500 italic">No products available. Create products first.</p>
                  <% } %>
                </div>
                <p class="text-xs text-gray-500 mt-1">
                  <i class="fas fa-info-circle"></i> Selected products can have licenses generated by this customer. Unselected products are read-only.
                </p>
              </div>

              <!-- Send Access Email -->
              <div class="mb-4">
                <label class="flex items-center space-x-2 cursor-pointer">
                  <input
                    type="checkbox"
                    name="send_access_email"
                    class="w-4 h-4 text-blue-600 border-gray-300 rounded focus:ring-blue-500"
                    checked
                  />
                  <span class="text-gray-700 font-medium">
                    <i class="fas fa-envelope mr-1"></i> Send Access Email
                  </span>
                </label>
                <p class="text-xs text-gray-500 mt-1 ml-6">
                  Auto-generate password and send welcome email with login credentials
                </p>
              </div>
            </div>

            <div class="flex space-x-3">
              <button type="submit" class="bg-blue-500 hover:bg-blue-600 text-white px-6 py-2 rounded-lg">
                <i class="fas fa-save"></i> Create Customer
              </button>
              <a href="/customers" class="bg-gray-300 hover:bg-gray-400 text-gray-800 px-6 py-2 rounded-lg">Cancel</a>
            </div>
          </form>
        </div>
      </main>
    </div>
  </div>
</body>
</html>
