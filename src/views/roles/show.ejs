<!DOCTYPE html>
<html>
<head>
  <title><%= role.display_name %> - License Manager</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/moment.js/2.29.4/moment.min.js"></script>
</head>
<body class="bg-gray-100">
  <div class="flex h-screen overflow-hidden">
    <%- include('../partials/sidebar', { currentPage: 'roles', user: user }) %>

    <div class="flex-1 flex flex-col overflow-hidden">
      <header class="bg-white shadow-sm">
        <div class="flex items-center justify-between p-4">
          <div>
            <a href="/roles" class="text-blue-600 hover:text-blue-800 text-sm mb-1 inline-block">
              <i class="fas fa-arrow-left mr-1"></i>Back to Roles
            </a>
            <h2 class="text-xl font-semibold text-gray-800"><%= role.display_name %></h2>
            <p class="text-sm text-gray-600"><%= role.description || 'No description provided' %></p>
          </div>
          <div class="space-x-2">
            <a href="/roles/<%= role.id %>/edit" class="bg-blue-600 text-white px-4 py-2 rounded hover:bg-blue-700 text-sm">
              <i class="fas fa-edit mr-1"></i>Edit Role
            </a>
            <% if (role.name !== 'admin') { %>
              <button onclick="deleteRole(<%= role.id %>, '<%= role.display_name %>')" class="bg-red-600 text-white px-4 py-2 rounded hover:bg-red-700 text-sm">
                <i class="fas fa-trash mr-1"></i>Delete
              </button>
            <% } %>
          </div>
        </div>
      </header>

      <main class="flex-1 overflow-y-auto p-6">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          <!-- Role Info -->
          <div class="lg:col-span-1">
            <div class="bg-white rounded-lg shadow-md p-6 mb-6">
              <h3 class="text-lg font-semibold text-gray-800 mb-4">Role Information</h3>

              <dl class="space-y-3">
                <div>
                  <dt class="text-sm font-medium text-gray-500">Name (Slug)</dt>
                  <dd class="mt-1 text-sm text-gray-900 font-mono bg-gray-100 px-2 py-1 rounded"><%= role.name %></dd>
                </div>

                <div>
                  <dt class="text-sm font-medium text-gray-500">Display Name</dt>
                  <dd class="mt-1 text-sm text-gray-900"><%= role.display_name %></dd>
                </div>

                <div>
                  <dt class="text-sm font-medium text-gray-500">Status</dt>
                  <dd class="mt-1">
                    <% if (role.is_active) { %>
                      <span class="bg-green-100 text-green-800 text-xs px-2 py-1 rounded">Active</span>
                    <% } else { %>
                      <span class="bg-red-100 text-red-800 text-xs px-2 py-1 rounded">Inactive</span>
                    <% } %>
                  </dd>
                </div>

                <div>
                  <dt class="text-sm font-medium text-gray-500">Created</dt>
                  <dd class="mt-1 text-sm text-gray-900">
                    <script>document.write(moment('<%= role.created_at %>').tz('<%= timezone %>').format('MMMM D, YYYY'))</script>
                  </dd>
                </div>

                <div>
                  <dt class="text-sm font-medium text-gray-500">Last Updated</dt>
                  <dd class="mt-1 text-sm text-gray-900">
                    <script>document.write(moment('<%= role.updated_at %>').fromNow())</script>
                  </dd>
                </div>
              </dl>
            </div>

            <!-- Stats -->
            <div class="bg-white rounded-lg shadow-md p-6">
              <h3 class="text-lg font-semibold text-gray-800 mb-4">Statistics</h3>

              <div class="space-y-4">
                <div class="flex justify-between items-center p-4 bg-blue-50 rounded">
                  <div>
                    <div class="text-sm text-gray-600">Users with this role</div>
                    <div class="text-2xl font-bold text-blue-600"><%= users.length %></div>
                  </div>
                  <i class="fas fa-users text-3xl text-blue-300"></i>
                </div>

                <div class="flex justify-between items-center p-4 bg-purple-50 rounded">
                  <div>
                    <div class="text-sm text-gray-600">Permissions assigned</div>
                    <div class="text-2xl font-bold text-purple-600"><%= permissions.length %></div>
                  </div>
                  <i class="fas fa-key text-3xl text-purple-300"></i>
                </div>
              </div>
            </div>
          </div>

          <!-- Permissions & Users -->
          <div class="lg:col-span-2">
            <!-- Permissions -->
            <div class="bg-white rounded-lg shadow-md p-6 mb-6">
              <h3 class="text-lg font-semibold text-gray-800 mb-4">
                Permissions (<%= permissions.length %>)
              </h3>

              <% if (permissions.length === 0) { %>
                <p class="text-gray-500 text-center py-8">No permissions assigned to this role.</p>
              <% } else { %>
                <%
                  const permsByResource = {};
                  permissions.forEach(perm => {
                    if (!permsByResource[perm.resource]) {
                      permsByResource[perm.resource] = [];
                    }
                    permsByResource[perm.resource].push(perm);
                  });
                %>

                <div class="space-y-4">
                  <% Object.keys(permsByResource).sort().forEach(resource => { %>
                    <div class="border rounded-lg p-4">
                      <h4 class="font-semibold text-gray-800 capitalize mb-3">
                        <i class="fas fa-<%= resource === 'dashboard' ? 'chart-line' : resource === 'products' ? 'box' : resource === 'customers' ? 'users' : resource === 'licenses' ? 'certificate' : resource === 'users' ? 'user-shield' : resource === 'roles' ? 'user-tag' : resource === 'permissions' ? 'key' : resource === 'reports' ? 'file-alt' : resource === 'settings' ? 'cog' : 'puzzle-piece' %> mr-2"></i>
                        <%= resource %>
                      </h4>
                      <div class="grid grid-cols-2 md:grid-cols-3 gap-2">
                        <% permsByResource[resource].forEach(perm => { %>
                          <div class="flex items-start bg-gray-50 p-2 rounded">
                            <i class="fas fa-check text-green-600 text-xs mt-1 mr-2"></i>
                            <div>
                              <div class="text-sm font-medium text-gray-900"><%= perm.action %></div>
                              <div class="text-xs text-gray-500"><%= perm.description %></div>
                            </div>
                          </div>
                        <% }) %>
                      </div>
                    </div>
                  <% }) %>
                </div>
              <% } %>
            </div>

            <!-- Users -->
            <div class="bg-white rounded-lg shadow-md p-6">
              <h3 class="text-lg font-semibold text-gray-800 mb-4">
                Users with this Role (<%= users.length %>)
              </h3>

              <% if (users.length === 0) { %>
                <p class="text-gray-500 text-center py-8">No users assigned to this role yet.</p>
              <% } else { %>
                <div class="overflow-x-auto">
                  <table class="min-w-full divide-y divide-gray-200">
                    <thead class="bg-gray-50">
                      <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Name</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Email</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Actions</th>
                      </tr>
                    </thead>
                    <tbody class="bg-white divide-y divide-gray-200">
                      <% users.forEach(u => { %>
                        <tr class="hover:bg-gray-50">
                          <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">
                            <%= u.name %>
                          </td>
                          <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">
                            <%= u.email %>
                          </td>
                          <td class="px-6 py-4 whitespace-nowrap text-sm">
                            <a href="/users/<%= u.id %>" class="text-blue-600 hover:text-blue-800">
                              View Profile
                            </a>
                          </td>
                        </tr>
                      <% }) %>
                    </tbody>
                  </table>
                </div>
              <% } %>
            </div>
          </div>
        </div>
      </main>
    </div>
  </div>

  <!-- Toast Container -->
  <div id="toast-container" class="fixed top-4 right-4 z-50 space-y-2"></div>

  <script>
    function showToast(message, type = 'success') {
      const container = document.getElementById('toast-container');
      const toast = document.createElement('div');
      const colors = {
        success: 'bg-green-500',
        error: 'bg-red-500',
        warning: 'bg-yellow-500',
        info: 'bg-blue-500'
      };
      const icons = {
        success: 'fa-check-circle',
        error: 'fa-times-circle',
        warning: 'fa-exclamation-triangle',
        info: 'fa-info-circle'
      };
      toast.className = `${colors[type]} text-white px-6 py-4 rounded-lg shadow-lg flex items-center space-x-3 min-w-[300px] max-w-md`;
      toast.innerHTML = `
        <i class="fas ${icons[type]} text-xl"></i>
        <span class="flex-1">${message}</span>
        <button onclick="this.parentElement.remove()" class="text-white hover:text-gray-200">
          <i class="fas fa-times"></i>
        </button>
      `;
      container.appendChild(toast);
      setTimeout(() => {
        toast.style.opacity = '0';
        setTimeout(() => toast.remove(), 300);
      }, 5000);
    }

    async function deleteRole(id, name) {
      const confirmed = await showConfirm(
        `Are you sure you want to delete the role "${name}"? This action cannot be undone.`,
        'Confirm Deletion',
        { type: 'delete', confirmText: 'Delete' }
      );
      if (!confirmed) return;

      try {
        const response = await fetch(`/roles/${id}`, {
          method: 'DELETE',
          headers: {
            'Content-Type': 'application/json'
          }
        });

        const data = await response.json();

        if (response.ok) {
          showToast(`Role "${name}" deleted successfully`, 'success');
          setTimeout(() => window.location.href = '/roles', 1000);
        } else {
          showToast(data.error || 'Failed to delete role', 'error');
        }
      } catch (error) {
        console.error('Error:', error);
        showToast('Failed to delete role', 'error');
      }
    }
  </script>
  <%- include('../partials/confirm-modal') %>
</body>
</html>
