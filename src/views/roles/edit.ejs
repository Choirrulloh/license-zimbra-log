<!DOCTYPE html>
<html>
<head>
  <title>Edit <%= role.display_name %> - License Manager</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-100">
  <div class="flex h-screen overflow-hidden">
    <%- include('../partials/sidebar', { currentPage: 'roles', user: user }) %>

    <div class="flex-1 flex flex-col overflow-hidden">
      <header class="bg-white shadow-sm">
        <div class="flex items-center justify-between p-4">
          <div>
            <a href="/roles/<%= role.id %>" class="text-blue-600 hover:text-blue-800 text-sm mb-1 inline-block">
              <i class="fas fa-arrow-left mr-1"></i>Back to Role Details
            </a>
            <h2 class="text-xl font-semibold text-gray-800">Edit Role: <%= role.display_name %></h2>
            <p class="text-sm text-gray-600">Update role information and permissions</p>
          </div>
        </div>
      </header>

      <main class="flex-1 overflow-y-auto p-6">
        <div class="max-w-4xl mx-auto">
          <div class="bg-white rounded-lg shadow-md p-6">
            <form id="editRoleForm" method="POST" action="/roles/<%= role.id %>/edit">
              <!-- Basic Information -->
              <div class="mb-6">
                <h3 class="text-lg font-semibold text-gray-800 mb-4">Basic Information</h3>

                <div class="mb-4">
                  <label class="block text-sm font-medium text-gray-700 mb-2">
                    Role Name (slug)
                    <span class="text-gray-500 text-xs">(cannot be changed)</span>
                  </label>
                  <input type="text" value="<%= role.name %>" readonly
                         class="w-full px-4 py-2 border rounded bg-gray-100 text-gray-600 cursor-not-allowed">
                </div>

                <div class="mb-4">
                  <label class="block text-sm font-medium text-gray-700 mb-2">
                    Display Name *
                  </label>
                  <input type="text" name="display_name" value="<%= role.display_name %>" required
                         class="w-full px-4 py-2 border rounded focus:ring-2 focus:ring-blue-500">
                </div>

                <div class="mb-4">
                  <label class="block text-sm font-medium text-gray-700 mb-2">
                    Description
                  </label>
                  <textarea name="description" rows="3"
                            class="w-full px-4 py-2 border rounded focus:ring-2 focus:ring-blue-500"><%= role.description || '' %></textarea>
                </div>

                <div class="mb-4">
                  <label class="flex items-center cursor-pointer">
                    <input type="checkbox" name="is_active" <%= role.is_active ? 'checked' : '' %>
                           class="mr-2 w-4 h-4 text-blue-600">
                    <span class="text-sm font-medium text-gray-700">Active</span>
                  </label>
                  <p class="text-xs text-gray-500 ml-6">Inactive roles cannot be assigned to users</p>
                </div>
              </div>

              <!-- Permissions -->
              <div class="mb-6">
                <div class="flex justify-between items-center mb-4">
                  <h3 class="text-lg font-semibold text-gray-800">Permissions</h3>
                  <div class="space-x-2">
                    <button type="button" onclick="selectAllPermissions()" class="text-sm text-blue-600 hover:text-blue-800">
                      Select All
                    </button>
                    <button type="button" onclick="deselectAllPermissions()" class="text-sm text-gray-600 hover:text-gray-800">
                      Deselect All
                    </button>
                  </div>
                </div>

                <div class="space-y-4">
                  <%
                    const permissionsByResource = {};
                    allPermissions.forEach(perm => {
                      if (!permissionsByResource[perm.resource]) {
                        permissionsByResource[perm.resource] = [];
                      }
                      permissionsByResource[perm.resource].push(perm);
                    });
                  %>

                  <% Object.keys(permissionsByResource).sort().forEach(resource => { %>
                    <div class="border rounded-lg p-4">
                      <div class="flex items-center mb-3">
                        <input type="checkbox" id="resource_<%= resource %>"
                               onchange="toggleResourcePermissions('<%= resource %>')"
                               class="mr-2 w-4 h-4 text-blue-600">
                        <label for="resource_<%= resource %>" class="font-semibold text-gray-800 capitalize cursor-pointer">
                          <i class="fas fa-<%= resource === 'dashboard' ? 'chart-line' : resource === 'products' ? 'box' : resource === 'customers' ? 'users' : resource === 'licenses' ? 'certificate' : resource === 'users' ? 'user-shield' : resource === 'roles' ? 'user-tag' : resource === 'permissions' ? 'key' : resource === 'reports' ? 'file-alt' : resource === 'settings' ? 'cog' : 'puzzle-piece' %> mr-2"></i>
                          <%= resource.charAt(0).toUpperCase() + resource.slice(1) %>
                        </label>
                      </div>

                      <div class="grid grid-cols-2 md:grid-cols-4 gap-3 ml-6">
                        <% permissionsByResource[resource].forEach(perm => { %>
                          <label class="flex items-center cursor-pointer hover:bg-gray-50 p-2 rounded">
                            <input type="checkbox" name="permissions" value="<%= perm.id %>"
                                   data-resource="<%= resource %>"
                                   <%= rolePermissionIds.includes(perm.id) ? 'checked' : '' %>
                                   class="mr-2 w-4 h-4 text-blue-600 permission-checkbox">
                            <span class="text-sm">
                              <span class="font-medium text-gray-700"><%= perm.action %></span>
                              <span class="text-xs text-gray-500 block"><%= perm.description %></span>
                            </span>
                          </label>
                        <% }) %>
                      </div>
                    </div>
                  <% }) %>
                </div>
              </div>

              <!-- Submit -->
              <div class="flex justify-end space-x-3">
                <a href="/roles/<%= role.id %>" class="px-6 py-2 border border-gray-300 rounded text-gray-700 hover:bg-gray-50">
                  Cancel
                </a>
                <button type="submit" class="px-6 py-2 bg-blue-600 text-white rounded hover:bg-blue-700">
                  <i class="fas fa-save mr-2"></i>Save Changes
                </button>
              </div>
            </form>
          </div>
        </div>
      </main>
    </div>
  </div>

  <!-- Toast Container -->
  <div id="toast-container" class="fixed top-4 right-4 z-50 space-y-2"></div>

  <script>
    function showToast(message, type = 'success') {
      const container = document.getElementById('toast-container');
      const toast = document.createElement('div');
      const colors = {
        success: 'bg-green-500',
        error: 'bg-red-500',
        warning: 'bg-yellow-500',
        info: 'bg-blue-500'
      };
      const icons = {
        success: 'fa-check-circle',
        error: 'fa-times-circle',
        warning: 'fa-exclamation-triangle',
        info: 'fa-info-circle'
      };
      toast.className = `${colors[type]} text-white px-6 py-4 rounded-lg shadow-lg flex items-center space-x-3 min-w-[300px] max-w-md`;
      toast.innerHTML = `
        <i class="fas ${icons[type]} text-xl"></i>
        <span class="flex-1">${message}</span>
        <button onclick="this.parentElement.remove()" class="text-white hover:text-gray-200">
          <i class="fas fa-times"></i>
        </button>
      `;
      container.appendChild(toast);
      setTimeout(() => {
        toast.style.opacity = '0';
        setTimeout(() => toast.remove(), 300);
      }, 5000);
    }

    // Initialize resource checkboxes based on current permissions
    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('[id^="resource_"]').forEach(resourceCb => {
        const resource = resourceCb.id.replace('resource_', '');
        const resourceCheckboxes = document.querySelectorAll(`input[data-resource="${resource}"]`);
        const allChecked = Array.from(resourceCheckboxes).every(cb => cb.checked);
        resourceCb.checked = allChecked;
      });
    });

    function toggleResourcePermissions(resource) {
      const checkbox = document.getElementById(`resource_${resource}`);
      const resourceCheckboxes = document.querySelectorAll(`input[data-resource="${resource}"]`);
      resourceCheckboxes.forEach(cb => cb.checked = checkbox.checked);
    }

    function selectAllPermissions() {
      document.querySelectorAll('.permission-checkbox').forEach(cb => cb.checked = true);
      document.querySelectorAll('[id^="resource_"]').forEach(cb => cb.checked = true);
    }

    function deselectAllPermissions() {
      document.querySelectorAll('.permission-checkbox').forEach(cb => cb.checked = false);
      document.querySelectorAll('[id^="resource_"]').forEach(cb => cb.checked = false);
    }

    // Update resource checkbox state when individual permissions change
    document.addEventListener('change', (e) => {
      if (e.target.classList.contains('permission-checkbox')) {
        const resource = e.target.dataset.resource;
        const resourceCheckboxes = document.querySelectorAll(`input[data-resource="${resource}"]`);
        const allChecked = Array.from(resourceCheckboxes).every(cb => cb.checked);
        const resourceCb = document.getElementById(`resource_${resource}`);
        if (resourceCb) resourceCb.checked = allChecked;
      }
    });

    document.getElementById('editRoleForm').addEventListener('submit', async (e) => {
      e.preventDefault();

      const formData = new FormData(e.target);
      const permissions = formData.getAll('permissions');

      const data = {
        display_name: formData.get('display_name'),
        description: formData.get('description'),
        is_active: formData.get('is_active') ? 'on' : 'off',
        permissions: permissions
      };

      try {
        const response = await fetch('/roles/<%= role.id %>/edit', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-CSRF-Token': '<%= typeof csrfToken !== "undefined" ? csrfToken : "" %>'
          },
          body: JSON.stringify(data)
        });

        if (response.redirected) {
          showToast('Role updated successfully', 'success');
          setTimeout(() => window.location.href = response.url, 500);
        } else if (response.ok) {
          showToast('Role updated successfully', 'success');
          setTimeout(() => window.location.href = '/roles/<%= role.id %>', 1000);
        } else {
          const error = await response.json();
          showToast(error.error || 'Failed to update role', 'error');
        }
      } catch (error) {
        console.error('Error:', error);
        showToast('Failed to update role', 'error');
      }
    });
  </script>
</body>
</html>
