          <h3 class="text-xl font-semibold mb-3">Node.js Integration</h3>
          <pre><code class="language-javascript">const crypto = require('crypto');
const os = require('os');
const https = require('https');
const http = require('http');

class LicenseValidator {
  constructor(licenseKey) {
    this.apiUrl = '${serverUrl}/api';
    this.licenseKey = licenseKey;
    this.hardwareId = this.getHardwareId();
  }

  getHardwareId() {
    const info = [
      os.platform(),
      os.hostname(),
      os.arch(),
      os.cpus()[0].model
    ].join('-');

    return crypto.createHash('sha256').update(info).digest('hex');
  }

  async validate() {
    const data = {
      license_key: this.licenseKey,
      hardware_id: this.hardwareId,
      hostname: os.hostname(),
      ip_address: 'unknown'
    };

    try {
      const response = await this.request('POST', '/validate', data);
      return response;
    } catch (error) {
      throw new Error(\`Validation failed: \${error.message}\`);
    }
  }

  async getLicenseInfo() {
    try {
      const response = await this.request('GET', \`/license/\${this.licenseKey}\`);
      return response;
    } catch (error) {
      throw new Error(\`Failed to get license info: \${error.message}\`);
    }
  }

  async deactivate() {
    const data = {
      license_key: this.licenseKey,
      hardware_id: this.hardwareId
    };

    try {
      const response = await this.request('POST', '/deactivate', data);
      return response;
    } catch (error) {
      throw new Error(\`Deactivation failed: \${error.message}\`);
    }
  }

  request(method, path, data = null) {
    return new Promise((resolve, reject) => {
      const url = new URL(this.apiUrl + path);
      const httpModule = url.protocol === 'https:' ? https : http;

      const options = {
        method: method,
        headers: {
          'Content-Type': 'application/json'
        }
      };

      const req = httpModule.request(url, options, (res) => {
        let body = '';
        res.on('data', chunk => body += chunk);
        res.on('end', () => {
          try {
            resolve(JSON.parse(body));
          } catch (e) {
            reject(new Error('Invalid JSON response'));
          }
        });
      });

      req.on('error', reject);

      if (data) {
        req.write(JSON.stringify(data));
      }

      req.end();
    });
  }
}

// Usage
async function main() {
  const validator = new LicenseValidator('YOUR-LICENSE-KEY-HERE');

  try {
    const result = await validator.validate();

    if (result.valid) {
      console.log('License is valid!');
      console.log('Expires:', result.license.expiry_date);
    } else {
      console.log('License validation failed:', result.message);
    }
  } catch (error) {
    console.error('Error:', error.message);
  }
}

main();</code></pre>
