LICENSE_KEY="YOUR-LICENSE-KEY-HERE"
API_URL="${serverUrl}/api"
HARDWARE_ID=$(hostname)-$(uname -m)

# Validate license
validate_license() {
  response=$(curl -s -X POST "$API_URL/validate" \\
    -H "Content-Type: application/json" \\
    -d "{
      \\"license_key\\": \\"$LICENSE_KEY\\",
      \\"hardware_id\\": \\"$HARDWARE_ID\\",
      \\"hostname\\": \\"$(hostname)\\",
      \\"ip_address\\": \\"$(hostname -I | awk '{print $1}')\\""
    }")

  echo "$response"

  # Check if valid
  if echo "$response" | grep -q '\\"valid\\":true'; then
    echo "License is valid!"
    return 0
  else
    echo "License is invalid!"
    return 1
  fi
}

# Get license info
get_license_info() {
  curl -s "$API_URL/license/$LICENSE_KEY"
}

# Deactivate license
deactivate_license() {
  curl -s -X POST "$API_URL/deactivate" \\
    -H "Content-Type: application/json" \\
    -d "{
      \\"license_key\\": \\"$LICENSE_KEY\\",
      \\"hardware_id\\": \\"$HARDWARE_ID\\"
    }"
}

# Run validation
