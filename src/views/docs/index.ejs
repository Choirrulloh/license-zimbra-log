        <div id="go-tab" class="tab-content">
          <h3 class="text-xl font-semibold mb-3">Go Integration</h3>
          <pre><code class="language-go">package main

import (
    "bytes"
    "crypto/sha256"
    "encoding/json"
    "fmt"
    "io"
    "net/http"
    "os"
    "runtime"
)

type LicenseValidator struct {
    APIUrl     string
    LicenseKey string
    HardwareID string
}

type ValidateRequest struct {
    LicenseKey string \`json:"license_key"\`
    HardwareID string \`json:"hardware_id"\`
    Hostname   string \`json:"hostname"\`
    IPAddress  string \`json:"ip_address"\`
}

type ValidateResponse struct {
    Valid   bool                   \`json:"valid"\`
    Message string                 \`json:"message"\`
    License map[string]interface{} \`json:"license"\`
}

func NewLicenseValidator(licenseKey string) *LicenseValidator {
    return &LicenseValidator{
        APIUrl:     "${serverUrl}/api",
        LicenseKey: licenseKey,
        HardwareID: getHardwareID(),
    }
}

func getHardwareID() string {
    hostname, _ := os.Hostname()
    info := fmt.Sprintf("%s-%s-%s", runtime.GOOS, hostname, runtime.GOARCH)
    hash := sha256.Sum256([]byte(info))
    return fmt.Sprintf("%x", hash)
}

func (lv *LicenseValidator) Validate() (*ValidateResponse, error) {
    hostname, _ := os.Hostname()

    req := ValidateRequest{
        LicenseKey: lv.LicenseKey,
        HardwareID: lv.HardwareID,
        Hostname:   hostname,
        IPAddress:  "unknown",
    }

    jsonData, err := json.Marshal(req)
    if err != nil {
        return nil, err
    }

    resp, err := http.Post(
        lv.APIUrl+"/validate",
        "application/json",
        bytes.NewBuffer(jsonData),
    )
    if err != nil {
        return nil, err
    }
    defer resp.Body.Close()

    body, err := io.ReadAll(resp.Body)
    if err != nil {
        return nil, err
    }

    var result ValidateResponse
    err = json.Unmarshal(body, &result)
    return &result, err
}

func (lv *LicenseValidator) GetLicenseInfo() (map[string]interface{}, error) {
    resp, err := http.Get(lv.APIUrl + "/license/" + lv.LicenseKey)
    if err != nil {
        return nil, err
    }
    defer resp.Body.Close()

    var result map[string]interface{}
    err = json.NewDecoder(resp.Body).Decode(&result)
    return result, err
}

func main() {
    validator := NewLicenseValidator("YOUR-LICENSE-KEY-HERE")

    result, err := validator.Validate()
    if err != nil {
        fmt.Printf("Error: %v\\n", err)
        return
    }

    if result.Valid {
        fmt.Println("License is valid!")
        fmt.Printf("Expires: %v\\n", result.License["expiry_date"])
    } else {
        fmt.Printf("License validation failed: %s\\n", result.Message)
    }
}</code></pre>
