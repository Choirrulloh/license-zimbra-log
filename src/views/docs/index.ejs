          <h3 class="text-xl font-semibold mb-3">PHP Integration</h3>
          <pre><code class="language-php"><?php

class LicenseValidator {
    private $apiUrl;
    private $licenseKey;
    private $hardwareId;

    public function __construct($licenseKey) {
        $this->apiUrl = '${serverUrl}/api';
        $this->licenseKey = $licenseKey;
        $this->hardwareId = $this->getHardwareId();
    }

    private function getHardwareId() {
        $info = [
            php_uname('s'), // OS
            php_uname('n'), // Hostname
            php_uname('m')  // Machine type
        ];
        return hash('sha256', implode('-', $info));
    }

    public function validate() {
        $data = [
            'license_key' => $this->licenseKey,
            'hardware_id' => $this->hardwareId,
            'hostname' => gethostname(),
            'ip_address' => $_SERVER['SERVER_ADDR'] ?? 'unknown'
        ];

        $ch = curl_init($this->apiUrl . '/validate');
        curl_setopt($ch, CURLOPT_POST, true);
        curl_setopt($ch, CURLOPT_POSTFIELDS, json_encode($data));
        curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
        curl_setopt($ch, CURLOPT_HTTPHEADER, ['Content-Type: application/json']);

        $response = curl_exec($ch);
        curl_close($ch);

        return json_decode($response, true);
    }

    public function getLicenseInfo() {
        $ch = curl_init($this->apiUrl . '/license/' . $this->licenseKey);
        curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);

        $response = curl_exec($ch);
        curl_close($ch);

        return json_decode($response, true);
    }

    public function deactivate() {
        $data = [
            'license_key' => $this->licenseKey,
            'hardware_id' => $this->hardwareId
        ];

        $ch = curl_init($this->apiUrl . '/deactivate');
        curl_setopt($ch, CURLOPT_POST, true);
        curl_setopt($ch, CURLOPT_POSTFIELDS, json_encode($data));
        curl_setopt($ch, CURLOPT_RETURNTRANSFER, true);
        curl_setopt($ch, CURLOPT_HTTPHEADER, ['Content-Type: application/json']);

        $response = curl_exec($ch);
        curl_close($ch);

        return json_decode($response, true);
    }
}

// Usage
$validator = new LicenseValidator('YOUR-LICENSE-KEY-HERE');
$result = $validator->validate();

if ($result['valid']) {
    echo "License is valid!\\n";
    echo "Expires: " . $result['license']['expiry_date'] . "\\n";
} else {
    echo "License validation failed: " . $result['message'] . "\\n";
}
?></code></pre>
