          <h3 class="text-xl font-semibold mb-3">Python Integration</h3>
          <pre><code class="language-python">import hashlib
import platform
import socket
import requests
from typing import Dict, Any

class LicenseValidator:
    def __init__(self, license_key: str):
        self.api_url = '${serverUrl}/api'
        self.license_key = license_key
        self.hardware_id = self._get_hardware_id()

    def _get_hardware_id(self) -> str:
        """Generate unique hardware ID"""
        info = [
            platform.system(),
            socket.gethostname(),
            platform.machine(),
            platform.processor()
        ]
        hardware_string = '-'.join(info)
        return hashlib.sha256(hardware_string.encode()).hexdigest()

    def validate(self) -> Dict[str, Any]:
        """Validate and activate license"""
        data = {
            'license_key': self.license_key,
            'hardware_id': self.hardware_id,
            'hostname': socket.gethostname(),
            'ip_address': socket.gethostbyname(socket.gethostname())
        }

        try:
            response = requests.post(
                f'{self.api_url}/validate',
                json=data,
                headers={'Content-Type': 'application/json'}
            )
            response.raise_for_status()
            return response.json()
        except requests.exceptions.RequestException as e:
            return {'valid': False, 'message': str(e)}

    def get_license_info(self) -> Dict[str, Any]:
        """Get license information without activation"""
        try:
            response = requests.get(f'{self.api_url}/license/{self.license_key}')
            response.raise_for_status()
            return response.json()
        except requests.exceptions.RequestException as e:
            return {'error': str(e)}

    def deactivate(self) -> Dict[str, Any]:
        """Deactivate license on current hardware"""
        data = {
            'license_key': self.license_key,
            'hardware_id': self.hardware_id
        }

        try:
            response = requests.post(
                f'{self.api_url}/deactivate',
                json=data,
                headers={'Content-Type': 'application/json'}
            )
            response.raise_for_status()
            return response.json()
        except requests.exceptions.RequestException as e:
            return {'success': False, 'message': str(e)}

# Usage
if __name__ == '__main__':
    validator = LicenseValidator('YOUR-LICENSE-KEY-HERE')

    # Validate license
    result = validator.validate()

    if result.get('valid'):
        print('License is valid!')
        print(f'Product: {result["license"]["product_name"]}')
        print(f'Expires: {result["license"]["expiry_date"]}')
    else:
        print(f'License validation failed: {result.get("message")}')

    # Get license info
    info = validator.get_license_info()
    print(f'\\nLicense Info: {info}')
</code></pre>
