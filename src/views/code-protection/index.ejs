<!DOCTYPE html>
<html>
<head>
  <title>Code Protection - License Manager</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    .upload-zone {
      border: 2px dashed #cbd5e0;
      transition: all 0.3s;
    }
    .upload-zone.drag-over {
      border-color: #4299e1;
      background-color: #ebf8ff;
    }
    .level-card {
      cursor: pointer;
      transition: all 0.3s;
    }
    .level-card.selected {
      border-color: #4299e1;
      background-color: #ebf8ff;
    }
  </style>
</head>
<body class="bg-gray-100">
  <div class="flex h-screen overflow-hidden">
    <%- include('../partials/sidebar', { currentPage: 'code-protection', user: user }) %>

    <div class="flex-1 flex flex-col overflow-hidden">
      <header class="bg-white shadow-sm">
        <div class="flex items-center justify-between p-4">
          <h2 class="text-xl font-semibold text-gray-800">Code Protection</h2>
          <span class="text-sm text-gray-600"><%= moment().format('dddd, MMMM D, YYYY') %></span>
        </div>
      </header>

      <main class="flex-1 overflow-y-auto p-6">
        <!-- Header Card -->
        <div class="bg-gradient-to-r from-blue-500 to-blue-600 rounded-lg shadow-md p-6 mb-6 text-white">
          <div class="flex items-center space-x-3">
            <i class="fas fa-shield-alt text-4xl"></i>
            <div>
              <h3 class="text-2xl font-bold">Code Protection Service</h3>
              <p class="text-blue-100">Protect your JavaScript code with industry-standard obfuscation techniques</p>
            </div>
          </div>
        </div>

        <!-- Step 1: Upload Files -->
        <div class="bg-white rounded-lg shadow-md p-6 mb-6">
          <h4 class="text-lg font-semibold text-gray-800 mb-4">
            <i class="fas fa-upload text-blue-500 mr-2"></i>
            Step 1: Upload Files
          </h4>

          <div id="uploadZone" class="upload-zone rounded-lg p-8 text-center mb-4">
            <i class="fas fa-cloud-upload-alt text-5xl text-gray-400 mb-3"></i>
            <p class="text-lg text-gray-600 mb-2">Drag & Drop Files Here</p>
            <p class="text-sm text-gray-500 mb-4">or click to browse your computer</p>
            <p class="text-xs text-gray-400">Supported: .js, .sh, .zip | Max size: <%= quota.max_file_size_mb %>MB</p>
            <input type="file" id="fileInput" accept=".js,.sh,.zip" class="hidden">
          </div>

          <div id="uploadedFiles" class="hidden mb-4">
            <div class="bg-gray-50 rounded-lg p-4">
              <p class="text-sm font-medium text-gray-700 mb-2">
                <i class="fas fa-check-circle text-green-500 mr-1"></i>
                Uploaded Files
              </p>
              <div id="filesList" class="space-y-2"></div>
            </div>
            <div class="mt-4 flex space-x-2">
              <button onclick="clearFiles()" class="text-sm text-red-600 hover:text-red-700">
                <i class="fas fa-times mr-1"></i>Clear All
              </button>
            </div>
          </div>

          <button onclick="document.getElementById('fileInput').click()" class="bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded-lg">
            <i class="fas fa-plus mr-2"></i>Select Files
          </button>
        </div>

        <!-- Step 2: Configure Options -->
        <div class="bg-white rounded-lg shadow-md p-6 mb-6">
          <h4 class="text-lg font-semibold text-gray-800 mb-4">
            <i class="fas fa-cog text-blue-500 mr-2"></i>
            Step 2: Configure Options
          </h4>

          <p class="text-sm text-gray-600 mb-4">Obfuscation Level:</p>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
            <div class="level-card border-2 rounded-lg p-4 text-center" data-level="low" onclick="selectLevel('low')">
              <i class="fas fa-bolt text-3xl text-yellow-500 mb-2"></i>
              <h5 class="font-semibold text-gray-800">Low</h5>
              <p class="text-sm text-gray-600 mt-2">Basic protection, fast processing</p>
            </div>

            <div class="level-card border-2 rounded-lg p-4 text-center selected" data-level="medium" onclick="selectLevel('medium')">
              <i class="fas fa-balance-scale text-3xl text-blue-500 mb-2"></i>
              <h5 class="font-semibold text-gray-800">Medium</h5>
              <p class="text-sm text-gray-600 mt-2">Recommended for most cases</p>
            </div>

            <div class="level-card border-2 rounded-lg p-4 text-center" data-level="high" onclick="selectLevel('high')">
              <i class="fas fa-lock text-3xl text-red-500 mb-2"></i>
              <h5 class="font-semibold text-gray-800">High</h5>
              <p class="text-sm text-gray-600 mt-2">Maximum protection, slower</p>
            </div>
          </div>

          <div class="border-t pt-4">
            <label class="flex items-center cursor-pointer">
              <input type="checkbox" id="showAdvanced" class="mr-2" onchange="toggleAdvanced()">
              <span class="text-sm font-medium text-gray-700">Show Advanced Options</span>
            </label>

            <div id="advancedOptions" class="hidden mt-4 bg-gray-50 rounded-lg p-4 space-y-2">
              <label class="flex items-center">
                <input type="checkbox" id="optCompact" class="mr-2" checked>
                <span class="text-sm text-gray-700">Compact code (remove whitespace)</span>
              </label>
              <label class="flex items-center">
                <input type="checkbox" id="optRenameVars" class="mr-2" checked>
                <span class="text-sm text-gray-700">Rename variables and functions</span>
              </label>
              <label class="flex items-center">
                <input type="checkbox" id="optStringEnc" class="mr-2" checked>
                <span class="text-sm text-gray-700">String array encoding</span>
              </label>
              <label class="flex items-center">
                <input type="checkbox" id="optControlFlow" class="mr-2">
                <span class="text-sm text-gray-700">Control flow flattening (slower)</span>
              </label>
              <label class="flex items-center">
                <input type="checkbox" id="optDeadCode" class="mr-2">
                <span class="text-sm text-gray-700">Dead code injection</span>
              </label>
              <label class="flex items-center">
                <input type="checkbox" id="optDisableConsole" class="mr-2">
                <span class="text-sm text-gray-700">Disable console output</span>
              </label>
              <button onclick="resetAdvanced()" class="mt-2 text-sm text-blue-600 hover:text-blue-700">
                Reset to Default
              </button>
            </div>
          </div>

          <!-- Bash Script Protection (only shown for .sh files) -->
          <div id="bashProtectionSection" class="hidden mt-4 border-t pt-4">
            <label class="flex items-center cursor-pointer">
              <input type="checkbox" id="bashInjectLicense" class="mr-2" onchange="toggleBashInjection()">
              <span class="text-sm font-medium text-gray-700">
                <i class="fas fa-terminal text-green-600 mr-1"></i>
                Inject License Validation (Bash Scripts Only)
              </span>
            </label>

            <div id="bashInjectionOptions" class="hidden mt-4 bg-green-50 rounded-lg p-4 border border-green-200">
              <p class="text-sm text-gray-700 mb-3">
                <i class="fas fa-info-circle text-blue-500 mr-1"></i>
                The script will require a valid license key when executed
              </p>

              <!-- Main Script Selection (for ZIP with multiple .sh files) -->
              <div id="mainScriptSection" class="hidden mb-3 p-3 bg-yellow-50 border border-yellow-200 rounded">
                <label class="block text-sm font-medium text-gray-700 mb-1">
                  <i class="fas fa-file-code text-yellow-600 mr-1"></i>
                  Select Main Script (Entry Point):
                </label>
                <select id="bashMainScript" class="w-full border border-gray-300 rounded px-3 py-2 text-sm">
                  <option value="">-- Select Main Script --</option>
                </select>
                <p class="text-xs text-gray-600 mt-1">
                  <i class="fas fa-info-circle mr-1"></i>
                  License validation will only be injected into the main script. Other scripts will be obfuscated only.
                </p>
              </div>

              <div class="mb-3">
                <label class="block text-sm font-medium text-gray-700 mb-1">Select Product:</label>
                <select id="bashProductId" class="w-full border border-gray-300 rounded px-3 py-2 text-sm">
                  <option value="">-- Select Product --</option>
                  <% products.forEach(product => { %>
                    <option value="<%= product.id %>"><%= product.name %></option>
                  <% }) %>
                </select>
              </div>

              <div class="mb-3">
                <label class="block text-sm font-medium text-gray-700 mb-1">Welcome Message:</label>
                <input type="text" id="bashWelcomeMsg" class="w-full border border-gray-300 rounded px-3 py-2 text-sm" placeholder="License Protected Script">
              </div>

              <div class="mb-3">
                <label class="block text-sm font-medium text-gray-700 mb-1">Support Contact:</label>
                <input type="text" id="bashSupportContact" class="w-full border border-gray-300 rounded px-3 py-2 text-sm" placeholder="support@example.com">
              </div>

              <div class="space-y-2 mt-3">
                <p class="text-sm font-medium text-gray-700">Validation Options:</p>
                <label class="flex items-center">
                  <input type="checkbox" id="bashCheckExpiry" class="mr-2" checked>
                  <span class="text-sm text-gray-700">Check license expiry</span>
                </label>
                <label class="flex items-center">
                  <input type="checkbox" id="bashCheckActivation" class="mr-2" checked>
                  <span class="text-sm text-gray-700">Check activation status</span>
                </label>
                <label class="flex items-center">
                  <input type="checkbox" id="bashCheckMachine" class="mr-2">
                  <span class="text-sm text-gray-700">Validate machine binding</span>
                </label>
                <label class="flex items-center">
                  <input type="checkbox" id="bashShowInfo" class="mr-2" checked>
                  <span class="text-sm text-gray-700">Show license info after validation</span>
                </label>
              </div>

              <div class="mt-3 p-2 bg-blue-50 border border-blue-200 rounded">
                <p class="text-xs text-blue-700">
                  <i class="fas fa-lightbulb mr-1"></i>
                  API Endpoint: <%= apiUrl %>
                </p>
              </div>
            </div>
          </div>
        </div>

        <!-- Usage Information -->
        <div class="bg-white rounded-lg shadow-md p-6 mb-6">
          <h4 class="text-lg font-semibold text-gray-800 mb-4">
            <i class="fas fa-info-circle text-blue-500 mr-2"></i>
            Usage Information
          </h4>
          <div class="flex items-center justify-between">
            <div>
              <% if (quota.monthly_limit === -1) { %>
                <p class="text-sm text-gray-600">
                  <i class="fas fa-infinity text-green-500 mr-2"></i>
                  Your Quota: <span class="font-semibold text-green-600">Unlimited</span>
                </p>
                <p class="text-xs text-gray-500 mt-1">
                  <i class="fas fa-crown text-yellow-500 mr-1"></i>
                  Admin privilege - No quota limits
                </p>
              <% } else { %>
                <p class="text-sm text-gray-600">
                  <i class="fas fa-chart-bar text-blue-500 mr-2"></i>
                  Your Quota: <span class="font-semibold"><%= quota.monthly_limit - quota.used_this_month %> of <%= quota.monthly_limit %></span> remaining this month
                </p>
                <p class="text-xs text-gray-500 mt-1">
                  <i class="fas fa-calendar text-gray-400 mr-2"></i>
                  Resets on: <%= moment(quota.reset_date).format('MMMM D, YYYY') %>
                </p>
              <% } %>
            </div>
          </div>
        </div>

        <!-- Action Button -->
        <div class="flex justify-center mb-6">
          <button id="obfuscateBtn" onclick="startObfuscation()" disabled class="bg-gray-400 text-white px-8 py-3 rounded-lg text-lg font-semibold cursor-not-allowed">
            <i class="fas fa-lock mr-2"></i>Start Obfuscation
          </button>
        </div>

        <!-- Recent Obfuscations -->
        <div class="bg-white rounded-lg shadow-md p-6">
          <h4 class="text-lg font-semibold text-gray-800 mb-4">
            <i class="fas fa-history text-blue-500 mr-2"></i>
            Recent Obfuscations
          </h4>

          <% if (recentObfuscations && recentObfuscations.length > 0) { %>
            <div class="overflow-x-auto">
              <table class="min-w-full">
                <thead class="bg-gray-50">
                  <tr>
                    <th class="px-4 py-2 text-left text-xs font-medium text-gray-500">Date & Time</th>
                    <th class="px-4 py-2 text-left text-xs font-medium text-gray-500">Files</th>
                    <th class="px-4 py-2 text-left text-xs font-medium text-gray-500">Level</th>
                    <th class="px-4 py-2 text-left text-xs font-medium text-gray-500">Size</th>
                    <th class="px-4 py-2 text-left text-xs font-medium text-gray-500">Action</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                  <% recentObfuscations.forEach(obf => { %>
                    <tr>
                      <td class="px-4 py-3 text-sm text-gray-800">
                        <%= moment(obf.created_at).format('MMM DD, h:mm A') %>
                      </td>
                      <td class="px-4 py-3 text-sm text-gray-800"><%= obf.original_filename %></td>
                      <td class="px-4 py-3">
                        <span class="text-xs px-2 py-1 rounded-full <%= obf.obfuscation_level === 'high' ? 'bg-red-100 text-red-600' : obf.obfuscation_level === 'medium' ? 'bg-blue-100 text-blue-600' : 'bg-yellow-100 text-yellow-600' %>">
                          <%= obf.obfuscation_level %>
                        </span>
                      </td>
                      <td class="px-4 py-3 text-sm text-gray-600">
                        <%= (obf.obfuscated_size / 1024).toFixed(0) %> KB
                      </td>
                      <td class="px-4 py-3">
                        <a href="/code-protection/download/<%= obf.id %>" class="text-blue-600 hover:text-blue-700 text-sm">
                          <i class="fas fa-download mr-1"></i>Download
                        </a>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>

            <div class="mt-4 text-center">
              <a href="/code-protection/history" class="text-blue-600 hover:text-blue-700 text-sm">
                View All History →
              </a>
            </div>
          <% } else { %>
            <p class="text-center text-gray-500 py-8">
              <i class="fas fa-inbox text-4xl mb-2"></i><br>
              No obfuscations yet. Upload a file to get started!
            </p>
          <% } %>
        </div>
      </main>
    </div>
  </div>

  <!-- Processing Modal -->
  <div id="processingModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
    <div class="bg-white rounded-lg shadow-xl max-w-md w-full mx-4 p-6">
      <div class="text-center">
        <div class="mb-4">
          <i class="fas fa-spinner fa-spin text-5xl text-blue-500"></i>
        </div>
        <h3 class="text-xl font-semibold text-gray-800 mb-2">Processing Your Files...</h3>
        <div class="bg-gray-200 rounded-full h-4 mb-4">
          <div id="progressBar" class="bg-blue-500 h-4 rounded-full transition-all" style="width: 0%"></div>
        </div>
        <p id="progressText" class="text-sm text-gray-600 mb-2">Uploading...</p>
        <p class="text-xs text-gray-500">Please wait, this may take a moment</p>
      </div>
    </div>
  </div>

  <!-- Success Modal -->
  <div id="successModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
    <div class="bg-white rounded-lg shadow-xl max-w-md w-full mx-4 p-6">
      <div class="text-center">
        <div class="mb-4">
          <i class="fas fa-check-circle text-6xl text-green-500"></i>
        </div>
        <h3 class="text-xl font-semibold text-gray-800 mb-2">Obfuscation Complete!</h3>
        <p class="text-gray-600 mb-4">Your code has been successfully obfuscated and is ready for download.</p>

        <div class="bg-gray-50 rounded-lg p-4 mb-4 text-left">
          <p class="text-sm font-medium text-gray-700 mb-2">
            <i class="fas fa-chart-bar mr-2"></i>Summary:
          </p>
          <div class="space-y-1 text-sm text-gray-600">
            <p>Files processed: <span id="sumFiles" class="font-semibold"></span></p>
            <p>Original size: <span id="sumOrigSize" class="font-semibold"></span></p>
            <p>Obfuscated size: <span id="sumObfSize" class="font-semibold"></span></p>
            <p>Processing time: <span id="sumTime" class="font-semibold"></span></p>
          </div>
        </div>

        <p class="text-xs text-gray-500 mb-4">
          <i class="fas fa-clock mr-1"></i>Download link expires in 7 days
        </p>

        <div class="flex space-x-3">
          <button onclick="downloadResult()" class="flex-1 bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg">
            <i class="fas fa-download mr-2"></i>Download
          </button>
          <button onclick="closeSuccessModal()" class="flex-1 bg-gray-200 hover:bg-gray-300 text-gray-800 px-4 py-2 rounded-lg">
            Close
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Error Modal -->
  <div id="errorModal" class="hidden fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50">
    <div class="bg-white rounded-lg shadow-xl max-w-md w-full mx-4 p-6">
      <div class="text-center">
        <div class="mb-4">
          <i class="fas fa-times-circle text-6xl text-red-500"></i>
        </div>
        <h3 class="text-xl font-semibold text-gray-800 mb-2">Obfuscation Failed</h3>
        <p class="text-gray-600 mb-4">We encountered an error while processing your files.</p>

        <div class="bg-red-50 rounded-lg p-4 mb-4">
          <p class="text-sm font-medium text-red-700 mb-1">Error Details:</p>
          <p id="errorMessage" class="text-sm text-red-600"></p>
        </div>

        <p class="text-xs text-gray-500 mb-4">Please fix the error and try again. Your quota has not been used.</p>

        <button onclick="closeErrorModal()" class="w-full bg-gray-200 hover:bg-gray-300 text-gray-800 px-4 py-2 rounded-lg">
          Close
        </button>
      </div>
    </div>
  </div>

  <%- include('../partials/toast-notification') %>

  <script>
    let selectedLevel = 'medium';
    let uploadedFile = null;
    let uploadedFileData = null; // Store upload response data
    let currentObfuscationId = null;

    // Drag & Drop
    const uploadZone = document.getElementById('uploadZone');
    const fileInput = document.getElementById('fileInput');

    uploadZone.addEventListener('click', () => fileInput.click());

    uploadZone.addEventListener('dragover', (e) => {
      e.preventDefault();
      uploadZone.classList.add('drag-over');
    });

    uploadZone.addEventListener('dragleave', () => {
      uploadZone.classList.remove('drag-over');
    });

    uploadZone.addEventListener('drop', (e) => {
      e.preventDefault();
      uploadZone.classList.remove('drag-over');
      if (e.dataTransfer.files.length > 0) {
        handleFileSelect(e.dataTransfer.files[0]);
      }
    });

    fileInput.addEventListener('change', (e) => {
      if (e.target.files.length > 0) {
        handleFileSelect(e.target.files[0]);
      }
    });

    async function handleFileSelect(file) {
      // Validate file
      const allowedExts = ['.js', '.sh', '.zip'];
      const fileName = file.name.toLowerCase();
      const isValid = allowedExts.some(ext => fileName.endsWith(ext));

      if (!isValid) {
        showToast('Invalid file type. Only .js, .sh, and .zip files are allowed', 'error');
        return;
      }

      if (file.size > <%= quota.max_file_size_mb %> * 1024 * 1024) {
        showToast('File too large. Maximum size is <%= quota.max_file_size_mb %>MB', 'error');
        return;
      }

      // Store file
      uploadedFile = file;

      // Show uploading indicator
      showToast('Analyzing file...', 'info');

      try {
        // Upload file to get metadata (including shell scripts in ZIP)
        const formData = new FormData();
        formData.append('file', file);

        const uploadRes = await fetch('/code-protection/upload', {
          method: 'POST',
          body: formData,
          credentials: 'same-origin'
        });

        const uploadData = await uploadRes.json();

        if (!uploadData.success) {
          throw new Error(uploadData.message);
        }

        // Store upload data
        uploadedFileData = uploadData.file;

        // Check if bash script
        const isBashScript = fileName.endsWith('.sh');
        const isZip = fileName.endsWith('.zip');

        // Check if ZIP contains shell scripts
        const hasShellScripts = uploadData.file.shellScripts && uploadData.file.shellScripts.length > 0;

        // Show/hide bash protection section
        if (isBashScript || (isZip && hasShellScripts)) {
          document.getElementById('bashProtectionSection').classList.remove('hidden');

          // Show main script selector for ZIP with multiple .sh files
          if (hasShellScripts && uploadData.file.shellScripts.length > 1) {
            const mainScriptSection = document.getElementById('mainScriptSection');
            const mainScriptSelect = document.getElementById('bashMainScript');

            // Clear and populate dropdown
            mainScriptSelect.innerHTML = '<option value="">-- Select Main Script --</option>';
            uploadData.file.shellScripts.forEach(script => {
              const option = document.createElement('option');
              option.value = script.path;
              option.textContent = script.path;
              mainScriptSelect.appendChild(option);
            });

            mainScriptSection.classList.remove('hidden');
          } else if (hasShellScripts && uploadData.file.shellScripts.length === 1) {
            // Only one .sh file, auto-select it
            document.getElementById('bashMainScript').value = uploadData.file.shellScripts[0].path;
            document.getElementById('mainScriptSection').classList.add('hidden');
          } else {
            document.getElementById('mainScriptSection').classList.add('hidden');
          }
        } else {
          document.getElementById('bashProtectionSection').classList.add('hidden');
          document.getElementById('bashInjectLicense').checked = false;
          document.getElementById('bashInjectionOptions').classList.add('hidden');
          document.getElementById('mainScriptSection').classList.add('hidden');
        }

        // Show in UI
        document.getElementById('uploadedFiles').classList.remove('hidden');
        let fileIcon = 'fa-file-code';
        let iconColor = 'text-blue-500';

        if (isBashScript) {
          fileIcon = 'fa-terminal';
          iconColor = 'text-green-500';
        } else if (isZip) {
          fileIcon = 'fa-file-archive';
          iconColor = 'text-purple-500';
        }

        let shellScriptsInfo = '';
        if (hasShellScripts) {
          shellScriptsInfo = `<p class="text-xs text-green-600 mt-1">
            <i class="fas fa-terminal mr-1"></i>
            Found ${uploadData.file.shellScripts.length} shell script(s)
          </p>`;
        }

        document.getElementById('filesList').innerHTML = `
          <div class="flex items-center justify-between bg-white p-3 rounded border">
            <div class="flex items-center space-x-3">
              <i class="fas ${fileIcon} ${iconColor} text-xl"></i>
              <div>
                <p class="text-sm font-medium text-gray-800">${file.name}</p>
                <p class="text-xs text-gray-500">${(file.size / 1024).toFixed(0)} KB</p>
                ${shellScriptsInfo}
              </div>
            </div>
            <button onclick="clearFiles()" class="text-red-500 hover:text-red-700">
              <i class="fas fa-times"></i>
            </button>
          </div>
        `;

        // Enable obfuscate button
        const btn = document.getElementById('obfuscateBtn');
        btn.disabled = false;
        btn.classList.remove('bg-gray-400', 'cursor-not-allowed');
        btn.classList.add('bg-blue-600', 'hover:bg-blue-700', 'cursor-pointer');

        showToast('File ready for obfuscation', 'success');

      } catch (error) {
        showToast('Upload failed: ' + error.message, 'error');
        uploadedFile = null;
        uploadedFileData = null;
      }
    }

    function clearFiles() {
      uploadedFile = null;
      uploadedFileData = null;
      document.getElementById('uploadedFiles').classList.add('hidden');
      document.getElementById('fileInput').value = '';
      document.getElementById('bashProtectionSection').classList.add('hidden');
      document.getElementById('mainScriptSection').classList.add('hidden');

      const btn = document.getElementById('obfuscateBtn');
      btn.disabled = true;
      btn.classList.add('bg-gray-400', 'cursor-not-allowed');
      btn.classList.remove('bg-blue-600', 'hover:bg-blue-700', 'cursor-pointer');
    }

    function selectLevel(level) {
      selectedLevel = level;
      document.querySelectorAll('.level-card').forEach(card => {
        card.classList.remove('selected');
      });
      document.querySelector(`[data-level="${level}"]`).classList.add('selected');
    }

    function toggleAdvanced() {
      const advanced = document.getElementById('advancedOptions');
      if (document.getElementById('showAdvanced').checked) {
        advanced.classList.remove('hidden');
      } else {
        advanced.classList.add('hidden');
      }
    }

    function resetAdvanced() {
      document.getElementById('optCompact').checked = true;
      document.getElementById('optRenameVars').checked = true;
      document.getElementById('optStringEnc').checked = true;
      document.getElementById('optControlFlow').checked = false;
      document.getElementById('optDeadCode').checked = false;
      document.getElementById('optDisableConsole').checked = false;
    }

    function toggleBashInjection() {
      const options = document.getElementById('bashInjectionOptions');
      if (document.getElementById('bashInjectLicense').checked) {
        options.classList.remove('hidden');
      } else {
        options.classList.add('hidden');
      }
    }

    async function startObfuscation() {
      if (!uploadedFile || !uploadedFileData) {
        showToast('Please upload a file first', 'warning');
        return;
      }

      // Show processing modal
      document.getElementById('processingModal').classList.remove('hidden');
      document.getElementById('progressBar').style.width = '50%';
      document.getElementById('progressText').textContent = 'Obfuscating code...';

      try {
        // Get options
        const options = {
          compact: document.getElementById('optCompact').checked,
          renameVariables: document.getElementById('optRenameVars').checked,
          stringEncoding: document.getElementById('optStringEnc').checked,
          controlFlow: document.getElementById('optControlFlow').checked,
          deadCode: document.getElementById('optDeadCode').checked,
          disableConsole: document.getElementById('optDisableConsole').checked
        };

        // Get bash injection options if applicable
        let bashInjection = null;
        const fileName = uploadedFile.name.toLowerCase();
        const isSingleBashScript = fileName.endsWith('.sh');
        const isZipWithShellScripts = uploadedFileData.shellScripts && uploadedFileData.shellScripts.length > 0;

        if ((isSingleBashScript || isZipWithShellScripts) &&
            document.getElementById('bashInjectLicense').checked) {

          const productId = document.getElementById('bashProductId').value;
          if (!productId) {
            throw new Error('Please select a product for license injection');
          }

          // For ZIP with multiple shell scripts, require main script selection
          let mainScript = null;
          if (isZipWithShellScripts && uploadedFileData.shellScripts.length > 1) {
            mainScript = document.getElementById('bashMainScript').value;
            if (!mainScript) {
              throw new Error('Please select the main script for license injection');
            }
          } else if (isZipWithShellScripts && uploadedFileData.shellScripts.length === 1) {
            // Auto-select single shell script
            mainScript = uploadedFileData.shellScripts[0].path;
          }

          bashInjection = {
            injectLicense: true,
            productId: parseInt(productId),
            mainScript: mainScript, // For multi-script ZIP
            welcomeMessage: document.getElementById('bashWelcomeMsg').value,
            supportContact: document.getElementById('bashSupportContact').value,
            checkExpiry: document.getElementById('bashCheckExpiry').checked,
            checkActivation: document.getElementById('bashCheckActivation').checked,
            checkMachine: document.getElementById('bashCheckMachine').checked,
            showInfo: document.getElementById('bashShowInfo').checked
          };
        }

        // Obfuscate
        const obfRes = await fetch('/code-protection/obfuscate', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({
            fileId: uploadedFileData.id,
            originalName: uploadedFile.name,
            level: selectedLevel,
            options,
            bashInjection
          })
        });

        const obfData = await obfRes.json();

        if (!obfData.success) {
          throw new Error(obfData.message);
        }

        // Update progress
        document.getElementById('progressBar').style.width = '100%';
        document.getElementById('progressText').textContent = 'Complete!';

        // Show success modal
        setTimeout(() => {
          document.getElementById('processingModal').classList.add('hidden');
          showSuccessModal(obfData.obfuscation);
        }, 500);

      } catch (error) {
        document.getElementById('processingModal').classList.add('hidden');
        showErrorModal(error.message);
      }
    }

    function showSuccessModal(data) {
      currentObfuscationId = data.id;
      document.getElementById('sumFiles').textContent = data.filesProcessed;
      document.getElementById('sumOrigSize').textContent = (data.originalSize / 1024).toFixed(0) + ' KB';
      document.getElementById('sumObfSize').textContent = (data.obfuscatedSize / 1024).toFixed(0) + ' KB (' + data.reduction + '%)';
      document.getElementById('sumTime').textContent = data.processingTime + ' seconds';
      document.getElementById('successModal').classList.remove('hidden');
    }

    function closeSuccessModal() {
      document.getElementById('successModal').classList.add('hidden');
      location.reload();
    }

    function downloadResult() {
      if (currentObfuscationId) {
        window.location.href = '/code-protection/download/' + currentObfuscationId;
      }
    }

    function showErrorModal(message) {
      document.getElementById('errorMessage').textContent = message;
      document.getElementById('errorModal').classList.remove('hidden');
    }

    function closeErrorModal() {
      document.getElementById('errorModal').classList.add('hidden');
    }
  </script>
</body>
</html>
