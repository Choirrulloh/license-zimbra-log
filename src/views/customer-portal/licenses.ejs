<!DOCTYPE html>
<html>
<head>
  <title>My Licenses - Customer Portal</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-100">
  <%- include('partials/sidebar', { currentPage: 'licenses' }) %>

  <div class="flex-1 flex flex-col overflow-hidden">
    <%- include('partials/header', { title: 'My Licenses', subtitle: 'View and manage all your licenses' }) %>

    <main class="flex-1 overflow-y-auto p-6">
      <!-- Impersonation Banner -->
      <% if (isImpersonation) { %>
        <div class="bg-yellow-100 border-l-4 border-yellow-500 text-yellow-700 p-4 mb-6 rounded">
          <div class="flex items-center justify-between">
            <div class="flex items-center">
              <i class="fas fa-exclamation-triangle mr-3 text-xl"></i>
              <div>
                <p class="font-semibold">Viewing as: <%= customer.name %></p>
              </div>
            </div>
            <a href="/customer/logout" class="bg-yellow-600 hover:bg-yellow-700 text-white px-4 py-2 rounded">
              <i class="fas fa-sign-out-alt mr-2"></i> Exit Customer View
            </a>
          </div>
        </div>
      <% } %>

      <!-- Quick Actions -->
      <div class="mb-6 flex justify-between items-center">
        <div>
          <p class="text-gray-600">Total: <span class="font-semibold"><%= licenses.length %></span> licenses</p>
        </div>
        <a href="/customer/generate-license" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg">
          <i class="fas fa-plus mr-2"></i> Generate New License
        </a>
      </div>

      <!-- Licenses Table -->
      <div class="bg-white rounded-lg shadow overflow-hidden">
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">License Key</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Product</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Type</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Activations</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Expires</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Actions</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <% if (licenses.length > 0) { %>
                <% licenses.forEach(license => { %>
                  <tr class="hover:bg-gray-50">
                    <td class="px-6 py-4 whitespace-nowrap">
                      <div class="flex items-center">
                        <code class="text-sm bg-gray-100 px-2 py-1 rounded font-mono"><%= license.license_key %></code>
                        <button onclick="copyToClipboard('<%= license.license_key %>')" class="ml-2 text-gray-400 hover:text-gray-600">
                          <i class="fas fa-copy"></i>
                        </button>
                      </div>
                    </td>
                    <td class="px-6 py-4">
                      <div class="text-sm font-medium text-gray-900"><%= license.product_name %></div>
                    </td>
                    <td class="px-6 py-4">
                      <div class="text-sm text-gray-600"><%= license.license_type_name %></div>
                    </td>
                    <td class="px-6 py-4">
                      <span class="px-2 py-1 inline-flex text-xs leading-5 font-semibold rounded-full <%= license.status === 'active' ? 'bg-green-100 text-green-800' : license.status === 'expired' ? 'bg-red-100 text-red-800' : license.status === 'suspended' ? 'bg-yellow-100 text-yellow-800' : 'bg-gray-100 text-gray-800' %>">
                        <i class="fas <%= license.status === 'active' ? 'fa-check-circle' : license.status === 'expired' ? 'fa-times-circle' : 'fa-pause-circle' %> mr-1"></i>
                        <%= license.status %>
                      </span>
                    </td>
                    <td class="px-6 py-4 text-sm text-gray-900">
                      <%= license.current_activations %>/<%= license.max_activations %>
                    </td>
                    <td class="px-6 py-4 text-sm text-gray-600">
                      <% if (license.expires_at) { %>
                        <div>
                          <%= moment(license.expires_at).tz(timezone).format('MMM D, YYYY') %>
                          <% if (moment(license.expires_at).diff(moment(), 'days') <= 7 && moment(license.expires_at).diff(moment(), 'days') >= 0) { %>
                            <span class="text-xs text-orange-600 block">
                              (<%= moment(license.expires_at).diff(moment(), 'days') %> days left)
                            </span>
                          <% } %>
                        </div>
                      <% } else { %>
                        <span class="text-green-600">Never</span>
                      <% } %>
                    </td>
                    <td class="px-6 py-4 text-sm space-x-2">
                      <button onclick="downloadLicense('<%= license.license_key %>', '<%= license.product_name %>')" class="text-blue-600 hover:text-blue-900">
                        <i class="fas fa-download"></i> Download
                      </button>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="7" class="px-6 py-12 text-center">
                    <i class="fas fa-key text-6xl text-gray-300 mb-4 block"></i>
                    <h3 class="text-lg font-semibold text-gray-800 mb-2">No Licenses Yet</h3>
                    <p class="text-gray-600 mb-4">You haven't generated any licenses yet.</p>
                    <a href="/customer/generate-license" class="inline-block bg-blue-600 text-white px-6 py-2 rounded hover:bg-blue-700">
                      <i class="fas fa-plus mr-2"></i> Generate Your First License
                    </a>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </main>
  </div>

  <%- include('partials/toast') %>

  <script>
    function copyToClipboard(text) {
      navigator.clipboard.writeText(text).then(() => {
        showToast('License key copied to clipboard!', 'success');
      }).catch(() => {
        showToast('Failed to copy license key', 'error');
      });
    }

    function downloadLicense(licenseKey, productName) {
      const content = `License Key: ${licenseKey}\nProduct: ${productName}\n\nThis is your license key. Please keep it safe.`;
      const blob = new Blob([content], { type: 'text/plain' });
      const url = window.URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `license-${licenseKey}.txt`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      window.URL.revokeObjectURL(url);
      showToast('License downloaded successfully!', 'success');
    }
  </script>
</body>
</html>
