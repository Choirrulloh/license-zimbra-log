<!DOCTYPE html>
<html>
<head>
  <title>Generate License - Customer Portal</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-100">
  <%- include('partials/sidebar', { currentPage: 'generate' }) %>

  <div class="flex-1 flex flex-col overflow-hidden">
    <%- include('partials/header', { title: 'Generate License', subtitle: 'Create a new license for your products' }) %>

    <main class="flex-1 overflow-y-auto p-6">
      <!-- Quota Warning -->
      <% if (quotaInfo.license_limit > 0 && quotaInfo.license_used >= quotaInfo.license_limit) { %>
        <div class="bg-red-100 border-l-4 border-red-500 text-red-700 p-4 mb-6 rounded">
          <div class="flex items-center">
            <i class="fas fa-exclamation-circle mr-3 text-xl"></i>
            <div>
              <p class="font-semibold">License Quota Exceeded!</p>
              <p class="text-sm">You have used all <%= quotaInfo.license_limit %> licenses. Please contact administrator to increase your limit.</p>
            </div>
          </div>
        </div>
      <% } else { %>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Left: Form -->
        <div class="lg:col-span-2">
          <!-- Quota Card -->
          <div class="bg-blue-50 border-l-4 border-blue-500 p-4 mb-6 rounded">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-sm text-blue-700 font-medium">License Quota Status</p>
                <p class="text-2xl font-bold text-blue-900">
                  <%= quotaInfo.license_used %>/<%= quotaInfo.license_limit === 0 ? '∞' : quotaInfo.license_limit %>
                </p>
              </div>
              <div class="text-right">
                <p class="text-sm text-blue-700">Remaining</p>
                <p class="text-xl font-semibold text-blue-900">
                  <%= quotaInfo.license_remaining === 'Unlimited' ? '∞' : quotaInfo.license_remaining %>
                </p>
              </div>
            </div>
          </div>

          <div class="bg-white rounded-lg shadow p-6">
            <h3 class="text-lg font-semibold text-gray-800 mb-4">
              <i class="fas fa-plus-circle text-blue-600 mr-2"></i> Generate New License
            </h3>

            <form id="generateForm" class="space-y-6">
              <!-- Product Selection -->
              <div>
                <label class="block text-gray-700 text-sm font-medium mb-2">
                  <i class="fas fa-box mr-1"></i> Select Product *
                </label>
                <select
                  id="product_id"
                  name="product_id"
                  required
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                  onchange="loadLicenseTypes()"
                >
                  <option value="">-- Select Product --</option>
                  <% products.forEach(product => { %>
                    <option value="<%= product.id %>"><%= product.name %></option>
                  <% }) %>
                </select>
                <% if (products.length === 0) { %>
                  <p class="text-sm text-red-600 mt-2">
                    <i class="fas fa-info-circle"></i> No products available for license generation. Contact administrator.
                  </p>
                <% } %>
              </div>

              <!-- License Type Selection -->
              <div id="licenseTypeContainer" style="display: none;">
                <label class="block text-gray-700 text-sm font-medium mb-2">
                  <i class="fas fa-tag mr-1"></i> Select License Type *
                </label>
                <select
                  id="license_type_id"
                  name="license_type_id"
                  required
                  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                >
                  <option value="">-- Select License Type --</option>
                </select>
                <div id="licenseTypeDetails" class="mt-3 p-3 bg-gray-50 rounded hidden">
                  <!-- Will be populated via JavaScript -->
                </div>
              </div>

              <!-- Submit Button -->
              <div class="flex space-x-3">
                <button
                  type="submit"
                  id="generateBtn"
                  class="flex-1 bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 rounded-lg transition-colors disabled:bg-gray-400 disabled:cursor-not-allowed"
                  <%= products.length === 0 ? 'disabled' : '' %>
                >
                  <i class="fas fa-magic mr-2"></i> Generate License
                </button>
                <a
                  href="/customer/licenses"
                  class="flex-1 bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold py-3 rounded-lg text-center transition-colors"
                >
                  <i class="fas fa-times mr-2"></i> Cancel
                </a>
              </div>
            </form>
          </div>
        </div>

        <!-- Right: Info -->
        <div class="space-y-6">
          <!-- Help Card -->
          <div class="bg-white rounded-lg shadow p-6">
            <h4 class="font-semibold text-gray-800 mb-3">
              <i class="fas fa-info-circle text-blue-600 mr-2"></i> How it works
            </h4>
            <ul class="space-y-2 text-sm text-gray-600">
              <li class="flex items-start">
                <i class="fas fa-check text-green-600 mr-2 mt-1"></i>
                <span>Select a product from your allowed list</span>
              </li>
              <li class="flex items-start">
                <i class="fas fa-check text-green-600 mr-2 mt-1"></i>
                <span>Choose the license type (Trial, Bronze, Silver, etc.)</span>
              </li>
              <li class="flex items-start">
                <i class="fas fa-check text-green-600 mr-2 mt-1"></i>
                <span>License will be generated instantly</span>
              </li>
              <li class="flex items-start">
                <i class="fas fa-check text-green-600 mr-2 mt-1"></i>
                <span>License key will appear and can be copied</span>
              </li>
              <li class="flex items-start">
                <i class="fas fa-check text-green-600 mr-2 mt-1"></i>
                <span>View all licenses in "My Licenses" page</span>
              </li>
            </ul>
          </div>

          <!-- Quota Info -->
          <div class="bg-white rounded-lg shadow p-6">
            <h4 class="font-semibold text-gray-800 mb-3">
              <i class="fas fa-chart-pie text-purple-600 mr-2"></i> Your Quotas
            </h4>
            <div class="space-y-3">
              <div>
                <div class="flex justify-between text-sm mb-1">
                  <span class="text-gray-600">Licenses</span>
                  <span class="font-semibold">
                    <%= quotaInfo.license_used %>/<%= quotaInfo.license_limit === 0 ? '∞' : quotaInfo.license_limit %>
                  </span>
                </div>
                <div class="w-full bg-gray-200 rounded-full h-2">
                  <div class="bg-blue-600 h-2 rounded-full" style="width: <%= quotaInfo.license_limit === 0 ? 0 : (quotaInfo.license_used / quotaInfo.license_limit * 100) %>%"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <% } %>
    </main>
  </div>

  <%- include('partials/toast') %>

  <!-- Success Modal -->
  <div id="successModal" class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50 hidden">
    <div class="bg-white rounded-lg shadow-xl p-8 max-w-md w-full mx-4">
      <div class="text-center">
        <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
          <i class="fas fa-check-circle text-green-600 text-3xl"></i>
        </div>
        <h3 class="text-2xl font-bold text-gray-800 mb-2">License Generated!</h3>
        <p class="text-gray-600 mb-4">Your license has been created successfully.</p>

        <div class="bg-gray-50 p-4 rounded-lg mb-4">
          <p class="text-sm text-gray-600 mb-2">License Key:</p>
          <div class="flex items-center justify-center space-x-2">
            <code id="generatedKey" class="text-lg font-mono font-bold text-blue-600"></code>
            <button onclick="copyLicenseKey()" class="text-gray-500 hover:text-gray-700">
              <i class="fas fa-copy"></i>
            </button>
          </div>
        </div>

        <div class="space-y-2">
          <button onclick="viewLicenses()" class="w-full bg-blue-600 hover:bg-blue-700 text-white py-2 rounded-lg">
            <i class="fas fa-list mr-2"></i> View All Licenses
          </button>
          <button onclick="generateAnother()" class="w-full bg-gray-200 hover:bg-gray-300 text-gray-800 py-2 rounded-lg">
            <i class="fas fa-plus mr-2"></i> Generate Another
          </button>
        </div>
      </div>
    </div>
  </div>

  <script>
    let licenseTypesData = [];

    async function loadLicenseTypes() {
      const productId = document.getElementById('product_id').value;
      const licenseTypeSelect = document.getElementById('license_type_id');
      const container = document.getElementById('licenseTypeContainer');

      if (!productId) {
        container.style.display = 'none';
        return;
      }

      try {
        const response = await fetch(`/customer/api/license-types/${productId}`);
        const data = await response.json();

        if (data.success) {
          licenseTypesData = data.licenseTypes;
          licenseTypeSelect.innerHTML = '<option value="">-- Select License Type --</option>';

          data.licenseTypes.forEach(type => {
            const option = document.createElement('option');
            option.value = type.id;
            option.textContent = type.name;
            option.dataset.duration = type.duration_days;
            option.dataset.activations = type.max_activations;
            licenseTypeSelect.appendChild(option);
          });

          container.style.display = 'block';
        }
      } catch (error) {
        console.error('Error loading license types:', error);
        showToast('Failed to load license types', 'error');
      }
    }

    document.getElementById('license_type_id').addEventListener('change', function() {
      const selectedOption = this.options[this.selectedIndex];
      const details = document.getElementById('licenseTypeDetails');

      if (this.value) {
        const duration = selectedOption.dataset.duration;
        const activations = selectedOption.dataset.activations;

        details.innerHTML = `
          <div class="space-y-2 text-sm">
            <div class="flex justify-between">
              <span class="text-gray-600">Duration:</span>
              <span class="font-semibold">${duration > 0 ? duration + ' days' : 'Lifetime'}</span>
            </div>
            <div class="flex justify-between">
              <span class="text-gray-600">Max Activations:</span>
              <span class="font-semibold">${activations}</span>
            </div>
          </div>
        `;
        details.classList.remove('hidden');
      } else {
        details.classList.add('hidden');
      }
    });

    document.getElementById('generateForm').addEventListener('submit', async function(e) {
      e.preventDefault();

      const btn = document.getElementById('generateBtn');
      const originalText = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i> Generating...';

      try {
        const formData = {
          product_id: document.getElementById('product_id').value,
          license_type_id: document.getElementById('license_type_id').value
        };

        const response = await fetch('/customer/generate-license', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(formData)
        });

        const data = await response.json();

        if (data.success) {
          document.getElementById('generatedKey').textContent = data.license.license_key;
          document.getElementById('successModal').classList.remove('hidden');
        } else {
          showToast(data.error || 'Failed to generate license', 'error');
        }
      } catch (error) {
        console.error('Error:', error);
        showToast('Failed to generate license', 'error');
      } finally {
        btn.disabled = false;
        btn.innerHTML = originalText;
      }
    });

    function copyLicenseKey() {
      const key = document.getElementById('generatedKey').textContent;
      navigator.clipboard.writeText(key).then(() => {
        showToast('License key copied to clipboard!', 'success');
      });
    }

    function viewLicenses() {
      window.location.href = '/customer/licenses';
    }

    function generateAnother() {
      document.getElementById('successModal').classList.add('hidden');
      document.getElementById('generateForm').reset();
      document.getElementById('licenseTypeContainer').style.display = 'none';
      window.location.reload();
    }
  </script>
</body>
</html>
