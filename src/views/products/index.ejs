<!DOCTYPE html>
<html>
<head>
  <title>Products - License Manager</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-100">
  <div class="flex h-screen overflow-hidden">
    <aside class="w-64 bg-gray-800 text-white flex-shrink-0">
      <div class="p-4">
        <h1 class="text-2xl font-bold mb-8"><i class="fas fa-key"></i> License Manager</h1>
        <nav class="space-y-2">
          <a href="/dashboard" class="flex items-center space-x-3 p-3 rounded hover:bg-gray-700"><i class="fas fa-chart-line w-5"></i><span>Dashboard</span></a>
          <a href="/products" class="flex items-center space-x-3 p-3 rounded bg-gray-700"><i class="fas fa-box w-5"></i><span>Products</span></a>
          <a href="/customers" class="flex items-center space-x-3 p-3 rounded hover:bg-gray-700"><i class="fas fa-users w-5"></i><span>Customers</span></a>
          <a href="/licenses" class="flex items-center space-x-3 p-3 rounded hover:bg-gray-700"><i class="fas fa-certificate w-5"></i><span>Licenses</span></a>
          <a href="/features" class="flex items-center space-x-3 p-3 rounded hover:bg-gray-700"><i class="fas fa-puzzle-piece w-5"></i><span>Features</span></a>
          <a href="/users" class="flex items-center space-x-3 p-3 rounded hover:bg-gray-700"><i class="fas fa-user-shield w-5"></i><span>Users</span></a>
          <a href="/roles" class="flex items-center space-x-3 p-3 rounded hover:bg-gray-700"><i class="fas fa-user-tag w-5"></i><span>Roles & Permissions</span></a>
          <a href="/reports" class="flex items-center space-x-3 p-3 rounded hover:bg-gray-700"><i class="fas fa-file-alt w-5"></i><span>Reports</span></a>
          <a href="/docs" class="flex items-center space-x-3 p-3 rounded hover:bg-gray-700"><i class="fas fa-book w-5"></i><span>API Docs</span></a>
          <a href="/settings" class="flex items-center space-x-3 p-3 rounded hover:bg-gray-700"><i class="fas fa-cog w-5"></i><span>Settings</span></a>
        </nav>
      </div>
      <div class="absolute bottom-0 w-64 p-4 bg-gray-900">
        <div class="flex items-center space-x-3">
          <div class="w-10 h-10 rounded-full bg-gray-700 flex items-center justify-center"><i class="fas fa-user"></i></div>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-medium truncate"><%= user.userName || 'Admin' %></p>
            <p class="text-xs text-gray-400 truncate"><%= user.userEmail || '' %></p>
          </div>
          <a href="/logout" class="text-gray-400 hover:text-white"><i class="fas fa-sign-out-alt"></i></a>
        </div>
      </div>
    </aside>
    <div class="flex-1 flex flex-col overflow-hidden">
      <header class="bg-white shadow-sm">
        <div class="flex items-center justify-between p-4">
          <h2 class="text-xl font-semibold text-gray-800">Products</h2>
          <span class="text-sm text-gray-600"><%= moment().format('dddd, MMMM D, YYYY') %></span>
        </div>
      </header>
      <main class="flex-1 overflow-y-auto p-6">
        <div class="mb-6 flex justify-between items-center">
          <div>
            <h3 class="text-2xl font-bold text-gray-800">Products</h3>
            <p class="text-gray-600">Manage your licensed products</p>
          </div>
          <a href="/products/create" class="bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded-lg">
            <i class="fas fa-plus"></i> Add Product
          </a>
        </div>
        <div class="bg-white rounded-lg shadow overflow-hidden">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Product</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Version</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">License Types</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Total Licenses</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Actions</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <% if (products.length > 0) { %>
                <% products.forEach(product => { %>
                  <tr class="hover:bg-gray-50">
                    <td class="px-6 py-4">
                      <div>
                        <div class="font-medium text-gray-900"><%= product.name %></div>
                        <div class="text-sm text-gray-500"><%= product.description || '-' %></div>
                      </div>
                    </td>
                    <td class="px-6 py-4 text-sm text-gray-900"><%= product.version || '-' %></td>
                    <td class="px-6 py-4 text-sm text-gray-900"><%= product.total_license_types %></td>
                    <td class="px-6 py-4 text-sm text-gray-900"><%= product.total_licenses %></td>
                    <td class="px-6 py-4">
                      <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full <%= product.is_active ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>">
                        <%= product.is_active ? 'Active' : 'Inactive' %>
                      </span>
                    </td>
                    <td class="px-6 py-4 text-sm font-medium space-x-2">
                      <a href="/products/<%= product.id %>" class="text-blue-600 hover:text-blue-900"><i class="fas fa-eye"></i></a>
                      <a href="/products/<%= product.id %>/edit" class="text-yellow-600 hover:text-yellow-900"><i class="fas fa-edit"></i></a>
                      <a href="#" onclick="deleteProduct(<%= product.id %>); return false;" class="text-red-600 hover:text-red-900"><i class="fas fa-trash"></i></a>
                    </td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="6" class="px-6 py-10 text-center text-gray-500">
                    <i class="fas fa-box text-4xl mb-2"></i>
                    <p>No products found</p>
                    <a href="/products/create" class="text-blue-500 hover:text-blue-600 mt-2 inline-block">
                      Create your first product
                    </a>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>

        <%- include('../partials/toast-notification') %>

        <script>
          async function deleteProduct(id) {
            const confirmed = await showConfirm(
              'Are you sure you want to delete this product? This action cannot be undone.',
              'Confirm Deletion',
              { type: 'delete', confirmText: 'Delete' }
            );
            if (!confirmed) return;

            try {
              const response = await fetch(`/products/${id}`, { method: 'DELETE' });
              const data = await response.json();
              if (data.success) {
                showToast('Product deleted successfully!', 'success');
                setTimeout(() => location.reload(), 1000);
              } else {
                showToast(data.message || 'Error deleting product', 'error');
              }
            } catch (error) {
              showToast('Error deleting product', 'error');
            }
          }
        </script>
      </main>
    </div>
  </div>
  <%- include('../partials/confirm-modal') %>
</body>
</html>
