<!DOCTYPE html>
<html>
<head>
  <title><%= product.name %> - License Manager</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-100">
  <div class="flex h-screen overflow-hidden">
    <aside class="w-64 bg-gray-800 text-white flex-shrink-0">
      <div class="p-4">
        <h1 class="text-2xl font-bold mb-8"><i class="fas fa-key"></i> License Manager</h1>
        <nav class="space-y-2">
          <a href="/dashboard" class="flex items-center space-x-3 p-3 rounded hover:bg-gray-700"><i class="fas fa-chart-line w-5"></i><span>Dashboard</span></a>
          <a href="/products" class="flex items-center space-x-3 p-3 rounded bg-gray-700"><i class="fas fa-box w-5"></i><span>Products</span></a>
          <a href="/customers" class="flex items-center space-x-3 p-3 rounded hover:bg-gray-700"><i class="fas fa-users w-5"></i><span>Customers</span></a>
          <a href="/licenses" class="flex items-center space-x-3 p-3 rounded hover:bg-gray-700"><i class="fas fa-certificate w-5"></i><span>Licenses</span></a>
          <a href="/reports" class="flex items-center space-x-3 p-3 rounded hover:bg-gray-700"><i class="fas fa-file-alt w-5"></i><span>Reports</span></a>
        </nav>
      </div>
      <div class="absolute bottom-0 w-64 p-4 bg-gray-900">
        <div class="flex items-center space-x-3">
          <div class="w-10 h-10 rounded-full bg-gray-700 flex items-center justify-center"><i class="fas fa-user"></i></div>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-medium truncate"><%= user.userName || 'Admin' %></p>
            <p class="text-xs text-gray-400 truncate"><%= user.userEmail || '' %></p>
          </div>
          <a href="/logout" class="text-gray-400 hover:text-white"><i class="fas fa-sign-out-alt"></i></a>
        </div>
      </div>
    </aside>
    <div class="flex-1 flex flex-col overflow-hidden">
      <header class="bg-white shadow-sm">
        <div class="flex items-center justify-between p-4">
          <h2 class="text-xl font-semibold text-gray-800"><%= product.name %></h2>
          <span class="text-sm text-gray-600"><%= moment().format('dddd, MMMM D, YYYY') %></span>
        </div>
      </header>
      <main class="flex-1 overflow-y-auto p-6">
        <div class="mb-6 flex justify-between items-center">
          <a href="/products" class="text-blue-500 hover:text-blue-600">
            <i class="fas fa-arrow-left"></i> Back to Products
          </a>
          <a href="/products/<%= product.id %>/edit" class="bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded-lg">
            <i class="fas fa-edit"></i> Edit Product
          </a>
        </div>

        <!-- Product Info -->
        <div class="bg-white rounded-lg shadow p-6 mb-6">
          <h3 class="text-lg font-semibold mb-4">Product Information</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <p class="text-sm text-gray-500">Product Name</p>
              <p class="font-medium"><%= product.name %></p>
            </div>
            <div>
              <p class="text-sm text-gray-500">Version</p>
              <p class="font-medium"><%= product.version || '-' %></p>
            </div>
            <div>
              <p class="text-sm text-gray-500">Status</p>
              <span class="px-2 py-1 rounded-full text-xs font-semibold <%= product.is_active ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>">
                <%= product.is_active ? 'Active' : 'Inactive' %>
              </span>
            </div>
            <div>
              <p class="text-sm text-gray-500">Created</p>
              <p class="font-medium"><%= moment(product.created_at).format('MMM D, YYYY') %></p>
            </div>
            <div class="md:col-span-2">
              <p class="text-sm text-gray-500">Description</p>
              <p class="font-medium"><%= product.description || '-' %></p>
            </div>
          </div>
        </div>

        <!-- License Types -->
        <div class="bg-white rounded-lg shadow p-6 mb-6">
          <div class="flex justify-between items-center mb-4">
            <h3 class="text-lg font-semibold">License Types</h3>
          </div>
          <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
              <thead class="bg-gray-50">
                <tr>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Name</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Type</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Duration</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Max Activations</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Price</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-200">
                <% if (licenseTypes.length > 0) { %>
                  <% licenseTypes.forEach(lt => { %>
                    <tr>
                      <td class="px-6 py-4 text-sm font-medium"><%= lt.name %></td>
                      <td class="px-6 py-4 text-sm"><%= lt.type %></td>
                      <td class="px-6 py-4 text-sm"><%= lt.duration_days %> days</td>
                      <td class="px-6 py-4 text-sm"><%= lt.max_activations %></td>
                      <td class="px-6 py-4 text-sm font-medium">Rp <%= lt.price.toLocaleString('id-ID') %></td>
                      <td class="px-6 py-4">
                        <span class="px-2 py-1 rounded-full text-xs font-semibold <%= lt.is_active ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>">
                          <%= lt.is_active ? 'Active' : 'Inactive' %>
                        </span>
                      </td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="6" class="px-6 py-4 text-center text-gray-500">No license types defined</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Licenses -->
        <div class="bg-white rounded-lg shadow p-6">
          <h3 class="text-lg font-semibold mb-4">Generated Licenses (<%= licenses.length %>)</h3>
          <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
              <thead class="bg-gray-50">
                <tr>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">License Key</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Customer</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Type</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Expiry</th>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-200">
                <% if (licenses.length > 0) { %>
                  <% licenses.forEach(l => { %>
                    <tr class="hover:bg-gray-50">
                      <td class="px-6 py-4">
                        <code class="text-xs bg-gray-100 px-2 py-1 rounded"><%= l.license_key %></code>
                      </td>
                      <td class="px-6 py-4 text-sm"><%= l.customer_name %></td>
                      <td class="px-6 py-4 text-sm"><%= l.license_type_name %></td>
                      <td class="px-6 py-4">
                        <span class="px-2 py-1 rounded-full text-xs font-semibold <%= l.status === 'active' ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>">
                          <%= l.status %>
                        </span>
                      </td>
                      <td class="px-6 py-4 text-sm">
                        <%= l.expiry_date ? moment(l.expiry_date).format('MMM D, YYYY') : 'Never' %>
                      </td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="5" class="px-6 py-4 text-center text-gray-500">No licenses generated yet</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </main>
    </div>
  </div>
</body>
</html>
