<!DOCTYPE html>
<html>
<head>
  <title><%= product.name %> - License Manager</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-100">
  <div class="flex h-screen overflow-hidden">
    <%- include('../partials/sidebar', { currentPage: 'products', user: user }) %>
    <div class="flex-1 flex flex-col overflow-hidden">
      <header class="bg-white shadow-sm">
        <div class="flex items-center justify-between p-4">
          <h2 class="text-xl font-semibold text-gray-800"><%= product.name %></h2>
          <span class="text-sm text-gray-600"><%= moment().format('dddd, MMMM D, YYYY') %></span>
        </div>
      </header>
      <main class="flex-1 overflow-y-auto p-6">
        <div class="mb-6 flex justify-between items-center">
          <a href="/products" class="text-blue-500 hover:text-blue-600">
            <i class="fas fa-arrow-left"></i> Back to Products
          </a>
          <a href="/products/<%= product.id %>/edit" class="bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded-lg">
            <i class="fas fa-edit"></i> Edit Product
          </a>
        </div>

        <!-- Product Info -->
        <div class="bg-white rounded-lg shadow p-6 mb-6">
          <h3 class="text-lg font-semibold mb-4">Product Information</h3>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <p class="text-sm text-gray-500">Product Name</p>
              <p class="font-medium"><%= product.name %></p>
            </div>
            <div>
              <p class="text-sm text-gray-500">Version</p>
              <p class="font-medium"><%= product.version || '-' %></p>
            </div>
            <div>
              <p class="text-sm text-gray-500">Status</p>
              <span class="px-2 py-1 rounded-full text-xs font-semibold <%= product.is_active ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>">
                <%= product.is_active ? 'Active' : 'Inactive' %>
              </span>
            </div>
            <div>
              <p class="text-sm text-gray-500">Created</p>
              <p class="font-medium"><%= moment(product.created_at).format('MMM D, YYYY') %></p>
            </div>
            <div class="md:col-span-2">
              <p class="text-sm text-gray-500">Description</p>
              <p class="font-medium"><%= product.description || '-' %></p>
            </div>
          </div>
        </div>

        <!-- License Types -->
        <div class="bg-white rounded-lg shadow p-6 mb-6">
          <div class="flex justify-between items-center mb-4">
            <h3 class="text-lg font-semibold">License Types</h3>
            <button onclick="showCreateLicenseTypeModal()" class="bg-green-500 hover:bg-green-600 text-white px-4 py-2 rounded-lg text-sm">
              <i class="fas fa-plus"></i> Add License Type
            </button>
          </div>
          <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
              <thead class="bg-gray-50">
                <tr>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Name</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Type</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Duration</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Max Activations</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Price</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Features</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Actions</th>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-200">
                <% if (licenseTypes.length > 0) { %>
                  <% licenseTypes.forEach(lt => {
                    let features = [];
                    try {
                      features = lt.features ? JSON.parse(lt.features) : [];
                    } catch (e) {
                      features = [];
                    }
                  %>
                    <tr>
                      <td class="px-6 py-4 text-sm font-medium"><%= lt.name %></td>
                      <td class="px-6 py-4 text-sm"><%= lt.type %></td>
                      <td class="px-6 py-4 text-sm"><%= lt.duration_days %> days</td>
                      <td class="px-6 py-4 text-sm"><%= lt.max_activations %></td>
                      <td class="px-6 py-4 text-sm font-medium">Rp <%= new Intl.NumberFormat('id-ID').format(lt.price) %></td>
                      <td class="px-6 py-4 text-sm">
                        <% if (features.length === 0) { %>
                          <span class="text-gray-400 italic">No features</span>
                        <% } else if (features.length <= 2) { %>
                          <% features.forEach((f, i) => { %>
                            <div class="text-xs"><i class="fas fa-check text-green-500"></i> <%= f %></div>
                          <% }); %>
                        <% } else { %>
                          <div class="text-xs"><i class="fas fa-check text-green-500"></i> <%= features[0] %></div>
                          <div class="text-xs text-gray-500">+<%= features.length - 1 %> more</div>
                        <% } %>
                      </td>
                      <td class="px-6 py-4">
                        <span class="px-2 py-1 rounded-full text-xs font-semibold <%= lt.is_active ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>">
                          <%= lt.is_active ? 'Active' : 'Inactive' %>
                        </span>
                      </td>
                      <td class="px-6 py-4 text-sm space-x-2">
                        <button onclick='editLicenseType(<%= JSON.stringify(lt) %>)' class="text-blue-500 hover:text-blue-600">
                          <i class="fas fa-edit"></i>
                        </button>
                        <button onclick="deleteLicenseType(<%= lt.id %>)" class="text-red-500 hover:text-red-600">
                          <i class="fas fa-trash"></i>
                        </button>
                      </td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="8" class="px-6 py-4 text-center text-gray-500">No license types defined</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>

        <!-- Licenses -->
        <div class="bg-white rounded-lg shadow p-6">
          <h3 class="text-lg font-semibold mb-4">Generated Licenses (<%= licenses.length %>)</h3>
          <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
              <thead class="bg-gray-50">
                <tr>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">License Key</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Customer</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Type</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
                  <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Expiry</th>
                </tr>
              </thead>
              <tbody class="bg-white divide-y divide-gray-200">
                <% if (licenses.length > 0) { %>
                  <% licenses.forEach(l => { %>
                    <tr class="hover:bg-gray-50">
                      <td class="px-6 py-4">
                        <code class="text-xs bg-gray-100 px-2 py-1 rounded"><%= l.license_key %></code>
                      </td>
                      <td class="px-6 py-4 text-sm"><%= l.customer_name %></td>
                      <td class="px-6 py-4 text-sm"><%= l.license_type_name %></td>
                      <td class="px-6 py-4">
                        <span class="px-2 py-1 rounded-full text-xs font-semibold <%= l.status === 'active' ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>">
                          <%= l.status %>
                        </span>
                      </td>
                      <td class="px-6 py-4 text-sm">
                        <%= l.expiry_date ? moment(l.expiry_date).format('MMM D, YYYY') : 'Never' %>
                      </td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="5" class="px-6 py-4 text-center text-gray-500">No licenses generated yet</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </main>
    </div>
  </div>

  <!-- Create License Type Modal -->
  <div id="createLicenseTypeModal" class="hidden fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full z-50">
    <div class="relative top-20 mx-auto p-5 border w-96 shadow-lg rounded-md bg-white">
      <div class="flex justify-between items-center mb-4">
        <h3 class="text-lg font-semibold">Add License Type</h3>
        <button onclick="closeCreateModal()" class="text-gray-400 hover:text-gray-600">
          <i class="fas fa-times"></i>
        </button>
      </div>
      <form id="createLicenseTypeForm" onsubmit="submitCreateLicenseType(event)">
        <div class="mb-3">
          <label class="block text-gray-700 text-sm font-medium mb-1">Name *</label>
          <input type="text" name="name" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-blue-500">
        </div>
        <div class="mb-3">
          <label class="block text-gray-700 text-sm font-medium mb-1">Type *</label>
          <select name="type" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-blue-500">
            <option value="trial">Trial</option>
            <option value="basic">Basic</option>
            <option value="pro">Pro</option>
            <option value="enterprise">Enterprise</option>
          </select>
        </div>
        <div class="mb-3">
          <label class="block text-gray-700 text-sm font-medium mb-1">Duration (days) *</label>
          <input type="number" name="duration_days" required min="1" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-blue-500">
        </div>
        <div class="mb-3">
          <label class="block text-gray-700 text-sm font-medium mb-1">Max Activations *</label>
          <input type="number" name="max_activations" required min="1" value="1" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-blue-500">
        </div>
        <div class="mb-3">
          <label class="block text-gray-700 text-sm font-medium mb-1">Price (Rp) *</label>
          <input type="text" id="create_price_display" placeholder="0" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-blue-500">
          <input type="hidden" name="price" id="create_price" value="0">
        </div>
        <div class="mb-3">
          <label class="block text-gray-700 text-sm font-medium mb-1">Features</label>
          <div class="border border-gray-300 rounded-lg p-3 max-h-48 overflow-y-auto">
            <% if (features.length === 0) { %>
              <p class="text-sm text-gray-500 italic">No features available. <a href="/features/create?product_id=<%= product.id %>" class="text-blue-500 hover:text-blue-600">Create features first</a></p>
            <% } else { %>
              <% features.forEach(feature => { %>
                <label class="flex items-center mb-2 hover:bg-gray-50 p-2 rounded cursor-pointer">
                  <input type="checkbox" name="feature_ids[]" value="<%= feature.id %>" class="form-checkbox h-4 w-4 text-blue-600">
                  <div class="ml-3 flex-1">
                    <span class="text-sm font-medium text-gray-700"><%= feature.name %></span>
                    <% if (feature.description) { %>
                      <p class="text-xs text-gray-500"><%= feature.description %></p>
                    <% } %>
                  </div>
                </label>
              <% }); %>
            <% } %>
          </div>
          <p class="text-xs text-gray-500 mt-1">Select features to include in this license type</p>
        </div>
        <div class="flex space-x-2">
          <button type="submit" class="flex-1 bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded-lg">
            <i class="fas fa-save"></i> Create
          </button>
          <button type="button" onclick="closeCreateModal()" class="flex-1 bg-gray-300 hover:bg-gray-400 text-gray-800 px-4 py-2 rounded-lg">
            Cancel
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Edit License Type Modal -->
  <div id="editLicenseTypeModal" class="hidden fixed inset-0 bg-gray-600 bg-opacity-50 overflow-y-auto h-full w-full z-50">
    <div class="relative top-20 mx-auto p-5 border w-96 shadow-lg rounded-md bg-white">
      <div class="flex justify-between items-center mb-4">
        <h3 class="text-lg font-semibold">Edit License Type</h3>
        <button onclick="closeEditModal()" class="text-gray-400 hover:text-gray-600">
          <i class="fas fa-times"></i>
        </button>
      </div>
      <form id="editLicenseTypeForm" onsubmit="submitEditLicenseType(event)">
        <input type="hidden" id="edit_id" name="id">
        <div class="mb-3">
          <label class="block text-gray-700 text-sm font-medium mb-1">Name *</label>
          <input type="text" id="edit_name" name="name" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-blue-500">
        </div>
        <div class="mb-3">
          <label class="block text-gray-700 text-sm font-medium mb-1">Type *</label>
          <select id="edit_type" name="type" required class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-blue-500">
            <option value="trial">Trial</option>
            <option value="basic">Basic</option>
            <option value="pro">Pro</option>
            <option value="enterprise">Enterprise</option>
          </select>
        </div>
        <div class="mb-3">
          <label class="block text-gray-700 text-sm font-medium mb-1">Duration (days) *</label>
          <input type="number" id="edit_duration_days" name="duration_days" required min="1" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-blue-500">
        </div>
        <div class="mb-3">
          <label class="block text-gray-700 text-sm font-medium mb-1">Max Activations *</label>
          <input type="number" id="edit_max_activations" name="max_activations" required min="1" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-blue-500">
        </div>
        <div class="mb-3">
          <label class="block text-gray-700 text-sm font-medium mb-1">Price (Rp) *</label>
          <input type="text" id="edit_price_display" class="w-full px-3 py-2 border border-gray-300 rounded-lg focus:outline-none focus:border-blue-500">
          <input type="hidden" id="edit_price" name="price">
        </div>
        <div class="mb-3">
          <label class="block text-gray-700 text-sm font-medium mb-1">Features</label>
          <div id="edit_features_container" class="border border-gray-300 rounded-lg p-3 max-h-48 overflow-y-auto">
            <% if (features.length === 0) { %>
              <p class="text-sm text-gray-500 italic">No features available. <a href="/features/create?product_id=<%= product.id %>" class="text-blue-500 hover:text-blue-600">Create features first</a></p>
            <% } else { %>
              <% features.forEach(feature => { %>
                <label class="flex items-center mb-2 hover:bg-gray-50 p-2 rounded cursor-pointer">
                  <input type="checkbox" name="feature_ids[]" value="<%= feature.id %>" class="edit-feature-checkbox form-checkbox h-4 w-4 text-blue-600" data-feature-id="<%= feature.id %>">
                  <div class="ml-3 flex-1">
                    <span class="text-sm font-medium text-gray-700"><%= feature.name %></span>
                    <% if (feature.description) { %>
                      <p class="text-xs text-gray-500"><%= feature.description %></p>
                    <% } %>
                  </div>
                </label>
              <% }); %>
            <% } %>
          </div>
          <p class="text-xs text-gray-500 mt-1">Select features to include in this license type</p>
        </div>
        <div class="mb-3">
          <label class="flex items-center">
            <input type="checkbox" id="edit_is_active" name="is_active" class="form-checkbox h-5 w-5 text-blue-600">
            <span class="ml-2 text-gray-700">Active</span>
          </label>
        </div>
        <div class="flex space-x-2">
          <button type="submit" class="flex-1 bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded-lg">
            <i class="fas fa-save"></i> Update
          </button>
          <button type="button" onclick="closeEditModal()" class="flex-1 bg-gray-300 hover:bg-gray-400 text-gray-800 px-4 py-2 rounded-lg">
            Cancel
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    // Format number with thousands separator
    function formatNumber(num) {
      return new Intl.NumberFormat('id-ID').format(num);
    }

    // Remove formatting and get raw number
    function parseFormattedNumber(str) {
      return parseInt(str.replace(/\./g, '')) || 0;
    }

    // Setup price input formatting
    document.addEventListener('DOMContentLoaded', function() {
      // Create modal price input
      const createPriceDisplay = document.getElementById('create_price_display');
      const createPriceHidden = document.getElementById('create_price');

      createPriceDisplay.addEventListener('input', function(e) {
        const rawValue = parseFormattedNumber(e.target.value);
        createPriceHidden.value = rawValue;
        e.target.value = formatNumber(rawValue);
      });

      // Edit modal price input
      const editPriceDisplay = document.getElementById('edit_price_display');
      const editPriceHidden = document.getElementById('edit_price');

      editPriceDisplay.addEventListener('input', function(e) {
        const rawValue = parseFormattedNumber(e.target.value);
        editPriceHidden.value = rawValue;
        e.target.value = formatNumber(rawValue);
      });
    });

    function showCreateLicenseTypeModal() {
      document.getElementById('create_price_display').value = '0';
      document.getElementById('create_price').value = '0';
      document.getElementById('createLicenseTypeModal').classList.remove('hidden');
    }

    function closeCreateModal() {
      document.getElementById('createLicenseTypeModal').classList.add('hidden');
      document.getElementById('createLicenseTypeForm').reset();
    }

    function closeEditModal() {
      document.getElementById('editLicenseTypeModal').classList.add('hidden');
      document.getElementById('editLicenseTypeForm').reset();
    }

    async function editLicenseType(lt) {
      document.getElementById('edit_id').value = lt.id;
      document.getElementById('edit_name').value = lt.name;
      document.getElementById('edit_type').value = lt.type;
      document.getElementById('edit_duration_days').value = lt.duration_days;
      document.getElementById('edit_max_activations').value = lt.max_activations;
      document.getElementById('edit_price').value = lt.price;
      document.getElementById('edit_price_display').value = formatNumber(lt.price);
      document.getElementById('edit_is_active').checked = lt.is_active;

      // Uncheck all features first
      document.querySelectorAll('.edit-feature-checkbox').forEach(cb => cb.checked = false);

      // Fetch currently assigned features for this license type
      try {
        const res = await fetch(`/api/license-types/${lt.id}/features`, {
          credentials: 'include'
        });
        if (res.ok) {
          const result = await res.json();
          const assignedFeatureIds = result.features.map(f => f.id);

          // Check the assigned features
          assignedFeatureIds.forEach(featureId => {
            const checkbox = document.querySelector(`.edit-feature-checkbox[data-feature-id="${featureId}"]`);
            if (checkbox) checkbox.checked = true;
          });
        }
      } catch (err) {
        console.error('Error loading features:', err);
      }

      document.getElementById('editLicenseTypeModal').classList.remove('hidden');
    }

    async function submitCreateLicenseType(e) {
      e.preventDefault();
      const formData = new FormData(e.target);
      const data = Object.fromEntries(formData);
      data.product_id = <%= product.id %>;

      // Collect selected feature IDs from checkboxes
      const selectedFeatures = Array.from(document.querySelectorAll('#createLicenseTypeForm input[name="feature_ids[]"]:checked'))
        .map(cb => parseInt(cb.value));
      data.feature_ids = selectedFeatures;

      // Keep backward compatibility with old features field (empty for now)
      data.features = JSON.stringify([]);

      try {
        const res = await fetch('/license-types', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
          credentials: 'include'
        });
        const result = await res.json();
        if (result.success) {
          showToast('License type created successfully!', 'success');
          setTimeout(() => location.reload(), 1000);
        } else {
          showToast('Error: ' + result.message, 'error');
        }
      } catch (err) {
        showToast('Error creating license type', 'error');
      }
    }

    async function submitEditLicenseType(e) {
      e.preventDefault();
      const formData = new FormData(e.target);
      const data = Object.fromEntries(formData);
      const id = data.id;
      delete data.id;
      data.is_active = data.is_active === 'on' ? 1 : 0;

      // Collect selected feature IDs from checkboxes
      const selectedFeatures = Array.from(document.querySelectorAll('#editLicenseTypeForm input[name="feature_ids[]"]:checked'))
        .map(cb => parseInt(cb.value));
      data.feature_ids = selectedFeatures;

      // Keep backward compatibility with old features field (empty for now)
      data.features = JSON.stringify([]);

      try {
        const res = await fetch(`/license-types/${id}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
          credentials: 'include'
        });
        const result = await res.json();
        if (result.success) {
          showToast('License type updated successfully!', 'success');
          setTimeout(() => location.reload(), 1000);
        } else {
          showToast('Error: ' + result.message, 'error');
        }
      } catch (err) {
        showToast('Error updating license type', 'error');
      }
    }

    async function deleteLicenseType(id) {
      const confirmed = await showConfirm(
        'Are you sure you want to delete this license type? This action cannot be undone.',
        'Confirm Deletion',
        { type: 'delete', confirmText: 'Delete' }
      );
      if (!confirmed) return;

      try {
        const res = await fetch(`/license-types/${id}`, {
          method: 'DELETE'
        });
        const result = await res.json();
        if (result.success) {
          showToast('License type deleted successfully!', 'success');
          setTimeout(() => location.reload(), 1000);
        } else {
          showToast('Error: ' + result.message, 'error');
        }
      } catch (err) {
        showToast('Error deleting license type', 'error');
      }
    }

    // Toast notification function
    function showToast(message, type = 'success') {
      const container = document.getElementById('toast-container') || createToastContainer();
      const toast = document.createElement('div');

      const colors = {
        success: 'bg-green-500',
        error: 'bg-red-500',
        warning: 'bg-yellow-500',
        info: 'bg-blue-500'
      };

      const icons = {
        success: 'fa-check-circle',
        error: 'fa-times-circle',
        warning: 'fa-exclamation-triangle',
        info: 'fa-info-circle'
      };

      toast.className = `${colors[type]} text-white px-6 py-4 rounded-lg shadow-lg flex items-center space-x-3 min-w-[300px] transform transition-all duration-300`;
      toast.innerHTML = `
        <i class="fas ${icons[type]} text-xl"></i>
        <span class="flex-1">${message}</span>
        <button onclick="this.parentElement.remove()" class="text-white hover:text-gray-200">
          <i class="fas fa-times"></i>
        </button>
      `;

      container.appendChild(toast);

      setTimeout(() => {
        toast.style.opacity = '0';
        toast.style.transform = 'translateX(100%)';
        setTimeout(() => toast.remove(), 300);
      }, 5000);
    }

    function createToastContainer() {
      const container = document.createElement('div');
      container.id = 'toast-container';
      container.className = 'fixed top-4 right-4 z-50 space-y-2';
      document.body.appendChild(container);
      return container;
    }
  </script>
  <%- include('../partials/confirm-modal') %>
</body>
</html>
