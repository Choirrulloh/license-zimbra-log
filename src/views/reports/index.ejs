<!DOCTYPE html>
<html>
<head>
  <title>Reports - License Manager</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-100">
  <div class="flex h-screen overflow-hidden">
    <%- include('../partials/sidebar', { currentPage: 'reports', user: user }) %>
    <div class="flex-1 flex flex-col overflow-hidden">
      <header class="bg-white shadow-sm">
        <div class="flex items-center justify-between p-4">
          <h2 class="text-xl font-semibold text-gray-800">Reports & Export</h2>
          <span class="text-sm text-gray-600"><%= moment().format('dddd, MMMM D, YYYY') %></span>
        </div>
      </header>
      <main class="flex-1 overflow-y-auto p-6">
        <div class="mb-6">
          <h3 class="text-2xl font-bold text-gray-800">Reports & Export</h3>
          <p class="text-gray-600">Export your data</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center mb-4">
              <i class="fas fa-certificate text-3xl text-blue-500 mr-4"></i>
              <h4 class="text-lg font-semibold">Licenses Report</h4>
            </div>
            <p class="text-gray-600 mb-4">Export all licenses data to CSV</p>
            <a href="/reports/licenses/csv" class="bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded-lg inline-block">
              <i class="fas fa-download"></i> Export CSV
            </a>
          </div>
          <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center mb-4">
              <i class="fas fa-users text-3xl text-green-500 mr-4"></i>
              <h4 class="text-lg font-semibold">Customers Report</h4>
            </div>
            <p class="text-gray-600 mb-4">Export all customers data to CSV</p>
            <a href="/reports/customers/csv" class="bg-green-500 hover:bg-green-600 text-white px-4 py-2 rounded-lg inline-block">
              <i class="fas fa-download"></i> Export CSV
            </a>
          </div>
          <div class="bg-white rounded-lg shadow p-6">
            <div class="flex items-center mb-4">
              <i class="fas fa-dollar-sign text-3xl text-yellow-500 mr-4"></i>
              <h4 class="text-lg font-semibold">Revenue Report</h4>
            </div>
            <p class="text-gray-600 mb-4">Export revenue data to CSV</p>
            <a href="/reports/revenue/csv" class="bg-yellow-500 hover:bg-yellow-600 text-white px-4 py-2 rounded-lg inline-block">
              <i class="fas fa-download"></i> Export CSV
            </a>
          </div>
        </div>
      </main>
    </div>
  </div>
</body>
</html>
