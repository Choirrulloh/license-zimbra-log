<!DOCTYPE html>
<html>
<head>
  <title>Users - License Manager</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-gray-100">
  <div class="flex h-screen overflow-hidden">
    <%- include('../partials/sidebar', { currentPage: 'users', user: user }) %>

    <div class="flex-1 flex flex-col overflow-hidden">
      <header class="bg-white shadow-sm">
        <div class="flex items-center justify-between p-4">
          <h2 class="text-xl font-semibold text-gray-800">User Management</h2>
          <a href="/users/create" class="bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded-lg text-sm">
            <i class="fas fa-plus"></i> Add User
          </a>
        </div>
      </header>

      <main class="flex-1 overflow-y-auto p-6">
        <div class="bg-white rounded-lg shadow">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Name</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Email</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Role</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Last Login</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Actions</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <% if (users.length > 0) { %>
                <% users.forEach(u => { %>
                  <tr>
                    <td class="px-6 py-4">
                      <div class="flex items-center">
                        <div class="w-10 h-10 rounded-full bg-gray-200 flex items-center justify-center mr-3">
                          <i class="fas fa-user text-gray-500"></i>
                        </div>
                        <div>
                          <div class="text-sm font-medium"><%= u.name %></div>
                          <% if (u.phone) { %>
                            <div class="text-xs text-gray-500"><%= u.phone %></div>
                          <% } %>
                        </div>
                      </div>
                    </td>
                    <td class="px-6 py-4 text-sm"><%= u.email %></td>
                    <td class="px-6 py-4">
                      <% if (u.role_display_name) { %>
                        <span class="px-2 py-1 rounded-full text-xs font-semibold <%= u.role_name === 'admin' ? 'bg-purple-100 text-purple-800' : u.role_name === 'manager' ? 'bg-blue-100 text-blue-800' : u.role_name === 'viewer' ? 'bg-gray-100 text-gray-800' : 'bg-green-100 text-green-800' %>">
                          <%= u.role_display_name %>
                        </span>
                      <% } else { %>
                        <span class="px-2 py-1 rounded-full text-xs font-semibold bg-gray-100 text-gray-800">No Role</span>
                      <% } %>
                    </td>
                    <td class="px-6 py-4">
                      <% if (u.suspended) { %>
                        <span class="px-2 py-1 rounded-full text-xs font-semibold bg-orange-100 text-orange-800">
                          Suspended
                        </span>
                      <% } else { %>
                        <span class="px-2 py-1 rounded-full text-xs font-semibold <%= u.is_active ? 'bg-green-100 text-green-800' : 'bg-red-100 text-red-800' %>">
                          <%= u.is_active ? 'Active' : 'Inactive' %>
                        </span>
                      <% } %>
                    </td>
                    <td class="px-6 py-4 text-sm text-gray-500">
                      <%= u.last_login ? moment(u.last_login).tz(timezone).format('MMM D, YYYY HH:mm') : 'Never' %>
                    </td>
                    <td class="px-6 py-4 text-sm space-x-2">
                      <a href="/users/<%= u.id %>" class="text-blue-500 hover:text-blue-600" title="View"><i class="fas fa-eye"></i></a>
                      <a href="/users/<%= u.id %>/edit" class="text-yellow-500 hover:text-yellow-600" title="Edit"><i class="fas fa-edit"></i></a>
                      <% if (u.role_name !== 'admin') { %>
                        <% if (u.suspended) { %>
                          <button onclick="unsuspendUser(<%= u.id %>)" class="text-green-500 hover:text-green-600" title="Unsuspend"><i class="fas fa-user-check"></i></button>
                        <% } else { %>
                          <button onclick="suspendUser(<%= u.id %>)" class="text-orange-500 hover:text-orange-600" title="Suspend"><i class="fas fa-user-slash"></i></button>
                        <% } %>
                        <button onclick="deleteUser(<%= u.id %>)" class="text-red-500 hover:text-red-600" title="Delete"><i class="fas fa-trash"></i></button>
                      <% } %>
                    </td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="6" class="px-6 py-4 text-center text-gray-500">No users found</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </main>
    </div>
  </div>

  <!-- Toast Container -->
  <div id="toast-container" class="fixed top-4 right-4 z-50 space-y-2"></div>

  <script>
    function showToast(message, type = 'success') {
      const container = document.getElementById('toast-container');
      const toast = document.createElement('div');
      const colors = { success: 'bg-green-500', error: 'bg-red-500', warning: 'bg-yellow-500', info: 'bg-blue-500' };
      const icons = { success: 'fa-check-circle', error: 'fa-times-circle', warning: 'fa-exclamation-triangle', info: 'fa-info-circle' };
      toast.className = `${colors[type]} text-white px-6 py-4 rounded-lg shadow-lg flex items-center space-x-3 min-w-[300px] max-w-md transform transition-all duration-300 translate-x-0`;
      toast.innerHTML = `<i class="fas ${icons[type]} text-xl"></i><span class="flex-1">${message}</span><button onclick="this.parentElement.remove()" class="text-white hover:text-gray-200"><i class="fas fa-times"></i></button>`;
      container.appendChild(toast);
      setTimeout(() => { toast.style.opacity = '0'; toast.style.transform = 'translateX(100%)'; setTimeout(() => toast.remove(), 300); }, 5000);
    }

    async function deleteUser(id) {
      const confirmed = await showConfirm(
        'Are you sure you want to delete this user? This action cannot be undone.',
        'Confirm Deletion',
        { type: 'delete', confirmText: 'Delete' }
      );
      if (!confirmed) return;

      try {
        const res = await fetch(`/users/${id}`, { method: 'DELETE' });
        const data = await res.json();
        if (data.success) {
          showToast('User deleted successfully!', 'success');
          setTimeout(() => location.reload(), 1000);
        } else {
          showToast(data.message || 'Error deleting user', 'error');
        }
      } catch (e) {
        showToast('Error deleting user', 'error');
      }
    }

    async function suspendUser(id) {
      const reason = prompt('Enter reason for suspension (optional):');
      const confirmed = await showConfirm(
        'Are you sure you want to suspend this user? They will not be able to login.',
        'Confirm Suspension',
        { type: 'warning', confirmText: 'Suspend' }
      );
      if (!confirmed) return;

      try {
        const res = await fetch(`/users/${id}/suspend`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ reason })
        });
        const data = await res.json();
        if (data.success) {
          showToast('User suspended successfully!', 'success');
          setTimeout(() => location.reload(), 1000);
        } else {
          showToast(data.message || 'Error suspending user', 'error');
        }
      } catch (e) {
        showToast('Error suspending user', 'error');
      }
    }

    async function unsuspendUser(id) {
      const confirmed = await showConfirm(
        'Are you sure you want to unsuspend this user? They will be able to login again.',
        'Confirm Unsuspension',
        { type: 'info', confirmText: 'Unsuspend' }
      );
      if (!confirmed) return;

      try {
        const res = await fetch(`/users/${id}/unsuspend`, { method: 'POST' });
        const data = await res.json();
        if (data.success) {
          showToast('User unsuspended successfully!', 'success');
          setTimeout(() => location.reload(), 1000);
        } else {
          showToast(data.message || 'Error unsuspending user', 'error');
        }
      } catch (e) {
        showToast('Error unsuspending user', 'error');
      }
    }
  </script>
  <%- include('../partials/confirm-modal') %>
</body>
</html>
