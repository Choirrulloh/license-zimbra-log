<!DOCTYPE html>
<html>
<head><title>404 Not Found</title><script src="https://cdn.tailwindcss.com"></script><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"></head>
<body class="bg-gray-100 min-h-screen flex items-center justify-center">
  <div class="text-center">
    <i class="fas fa-exclamation-triangle text-6xl text-yellow-500 mb-4"></i>
    <h1 class="text-4xl font-bold text-gray-800 mb-2">404 - Page Not Found</h1>
    <p class="text-gray-600 mb-6">The page you're looking for doesn't exist.</p>
    <a href="/dashboard" class="bg-blue-500 hover:bg-blue-600 text-white px-6 py-3 rounded-lg"><i class="fas fa-home"></i> Go to Dashboard</a>
  </div>
</body>
</html>
